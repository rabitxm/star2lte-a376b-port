+  "scope": "M4/G965F/BZI6 legacy Infinity AOD plugin only",
+  "source_class": "smali_classes2/com/android/systemui/plugins/annotations/VersionCheckingProxy.smali",
+  "source_sha256": "9d0faaab341d9163e58a30c995401de76c26b1d5d79628328e1364da99256db2",
+  "legacy_aod_sha256": "b374094fe87c6ab9f231096ddad4cd1bb0945be74c3247c9a441af8a3262b9f3",

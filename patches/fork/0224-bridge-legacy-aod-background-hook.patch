+#!/usr/bin/env python3
+"""Bridge one absent optional background hook on the pinned legacy AOD plugin.
+
+Reason: SystemUI dies with AbstractMethodError during plugin disconnect.
+File: VersionCheckingProxy only; preserve all concrete callbacks/onDestroy.
+Verify: exact class/AOD inputs, source and compiled class hashes, negative
+fixtures and device reflection tests before replacing the SystemUI APK.
+"""
+from pathlib import Path
+import argparse
+import hashlib
+import json
+import os
+import subprocess
+import tempfile
+
+LOCK = json.loads(Path(__file__).with_suffix('.lock.json').read_text())
+CLASS = 'Lcom/android/systemui/plugins/annotations/VersionCheckingProxy;'
+METHOD = '''.method private static skipLegacyBackgroundHook(Ljava/lang/reflect/Method;Ljava/lang/Object;)Z
+    .locals 3
+
+    if-eqz p1, :legacy_no
+
+    invoke-virtual {p0}, Ljava/lang/reflect/Method;->getName()Ljava/lang/String;
+    move-result-object v0
+    const-string v1, "disconnectPluginOnBackground"
+    invoke-virtual {v1, v0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+    move-result v0
+    if-eqz v0, :legacy_no
+
+    invoke-virtual {p0}, Ljava/lang/reflect/Method;->getDeclaringClass()Ljava/lang/Class;
+    move-result-object v0
+    invoke-virtual {v0}, Ljava/lang/Class;->getName()Ljava/lang/String;
+    move-result-object v0
+    const-string v1, "com.android.systemui.plugins.keyguardstatusview.PluginKeyguardStatusView"
+    invoke-virtual {v1, v0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+    move-result v0
+    if-eqz v0, :legacy_no
+
+    invoke-virtual {p0}, Ljava/lang/reflect/Method;->getReturnType()Ljava/lang/Class;
+    move-result-object v0
+    sget-object v1, Ljava/lang/Void;->TYPE:Ljava/lang/Class;
+    if-ne v0, v1, :legacy_no
+
+    invoke-virtual {p0}, Ljava/lang/reflect/Method;->getParameterTypes()[Ljava/lang/Class;
+    move-result-object v0
+    array-length v1, v0
+    if-nez v1, :legacy_no
+
+    invoke-virtual {p1}, Ljava/lang/Object;->getClass()Ljava/lang/Class;
+    move-result-object v1
+    invoke-virtual {v1}, Ljava/lang/Class;->getName()Ljava/lang/String;
+    move-result-object v2
+    const-string p1, "com.samsung.android.app.facewidget.plugin.PluginKeyguardStatusViewImpl"
+    invoke-virtual {p1, v2}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+    move-result v2
+    if-eqz v2, :legacy_no
+
+    :legacy_try_start
+    invoke-virtual {p0}, Ljava/lang/reflect/Method;->getName()Ljava/lang/String;
+    move-result-object p0
+    invoke-virtual {v1, p0, v0}, Ljava/lang/Class;->getMethod(Ljava/lang/String;[Ljava/lang/Class;)Ljava/lang/reflect/Method;
+    move-result-object p0
+    invoke-virtual {p0}, Ljava/lang/reflect/Method;->getModifiers()I
+    move-result p0
+    invoke-static {p0}, Ljava/lang/reflect/Modifier;->isAbstract(I)Z
+    move-result p0
+    :legacy_try_end
+    .catch Ljava/lang/NoSuchMethodException; {:legacy_try_start .. :legacy_try_end} :legacy_absent
+
+    return p0
+
+    :legacy_absent
+    move-exception p0
+    const/4 v0, 0x1
+    return v0
+
+    :legacy_no
+    const/4 v0, 0x0
+    return v0
+.end method
+
+'''
+ANCHOR = '    const-class p1, Lcom/android/systemui/plugins/annotations/VersionCheck;'
+GUARD = f'''    iget-object v0, p0, {CLASS}->mTargetInstance:Ljava/lang/Object;
+
+    invoke-static {{p2, v0}}, {CLASS}->skipLegacyBackgroundHook(Ljava/lang/reflect/Method;Ljava/lang/Object;)Z
+    move-result v0
+    if-eqz v0, :legacy_invoke_original
+    const/4 v0, 0x0
+    return-object v0
+
+    :legacy_invoke_original
+'''
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def scope():
+    expected = {'ROM_SOURCE_CONFIG': 'essi_a376b_android17', 'ROM_MILESTONE': 'M4',
+                'TARGET_CODENAME': 'star2lte', 'STAR2LTE_BUILD_MODEL': 'SM-G965F',
+                'SOURCE_PLATFORM_SDK_VERSION': '37', 'EXYNOS9810_M4_RUNTIME_COMPAT': 'true'}
+    if any(os.environ.get(k) != v for k, v in expected.items()):
+        raise ValueError('Legacy FaceWidget scope mismatch')
+
+
+def patch_bytes(data):
+    if sha(data) == LOCK['output_sha256']:
+        return data
+    if sha(data) != LOCK['source_sha256']:
+        raise ValueError('Legacy FaceWidget proxy source mismatch')
+    text = data.decode()
+    if text.count(ANCHOR) != 1 or text.count('# virtual methods\n') != 1:
+        raise ValueError('Legacy FaceWidget proxy anchors changed')
+    text = text.replace('# virtual methods\n', METHOD + '# virtual methods\n', 1)
+    result = text.replace(ANCHOR, GUARD + ANCHOR, 1).encode()
+    if sha(result) != LOCK['output_sha256']:
+        raise ValueError('Legacy FaceWidget proxy output mismatch')
+    return result
+
+
+def verify_aod(path):
+    if path.is_symlink() or not path.is_file() or sha(path.read_bytes()) != LOCK['legacy_aod_sha256']:
+        raise ValueError('Legacy AOD payload changed; review optional callback ABI')
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('command', choices=['apply-work', 'verify-work', 'verify-apk', 'fixture'])
+    parser.add_argument('--systemui-dir', type=Path)
+    parser.add_argument('--aod-apk', type=Path, required=True)
+    parser.add_argument('--apk', type=Path)
+    parser.add_argument('--apktool', type=Path)
+    parser.add_argument('--temp-root', type=Path)
+    args = parser.parse_args()
+    scope()
+    verify_aod(args.aod_apk)
+    if args.command == 'verify-apk':
+        with tempfile.TemporaryDirectory(prefix='m4-legacy-proxy-', dir=args.temp_root) as td:
+            decoded = Path(td) / 'decoded'
+            subprocess.run([str(args.apktool), 'd', '--no-res', '--no-debug-info', '-o', str(decoded), str(args.apk)], check=True, capture_output=True)
+            data = (decoded / LOCK['source_class']).read_bytes()
+            if sha(data) != LOCK['roundtrip_sha256']:
+                raise ValueError('Compiled legacy FaceWidget proxy mismatch')
+    else:
+        path = args.systemui_dir / LOCK['source_class']
+        if path.is_symlink():
+            raise ValueError('Legacy FaceWidget proxy cannot be a symlink')
+        data = path.read_bytes()
+        if args.command == 'fixture':
+            result = patch_bytes(data)
+            assert patch_bytes(result) == result
+            wrong = bytearray(data); wrong[0] ^= 1
+            try:
+                patch_bytes(bytes(wrong))
+            except ValueError:
+                pass
+            else:
+                raise ValueError('Changed proxy accepted')
+        elif args.command == 'apply-work':
+            path.write_bytes(patch_bytes(data))
+        elif sha(data) != LOCK['output_sha256']:
+            raise ValueError('Legacy FaceWidget proxy patch absent')
+    print('PASS locked legacy AOD optional-hook bridge: ' + args.command)
+
+
+if __name__ == '__main__':
+    main()
--- /dev/null

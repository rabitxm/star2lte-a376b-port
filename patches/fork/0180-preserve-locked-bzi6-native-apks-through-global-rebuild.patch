--- a/scripts/apktool.sh
+++ b/scripts/apktool.sh
@@ -26,6 +26,35 @@
     if [ ! -d "$OUTPUT_PATH" ]; then
         LOGE "Folder not found: ${OUTPUT_PATH//$SRC_DIR\//}"
         exit 1
+    fi
+
+    # Native BZI6 apps were explicitly retained by finalization. Decoding
+    # for inspection must not platform-sign them in the global rebuild pass.
+    if [ "${ROM_SOURCE_CONFIG:-}" = "essi_a376b_android17" ]; then
+        case "$PARTITION/$FILE" in
+            system/priv-app/SamsungCamera/SamsungCamera.apk|\
+            system/system/priv-app/SamsungCamera/SamsungCamera.apk|\
+            system/priv-app/DressRoom/DressRoom.apk|\
+            system/system/priv-app/DressRoom/DressRoom.apk|\
+            system/priv-app/IPService/IPService.apk|\
+            system/system/priv-app/IPService/IPService.apk|\
+            system/priv-app/RubinVersion38/RubinVersion38.apk|\
+            system/system/priv-app/RubinVersion38/RubinVersion38.apk|\
+            system/priv-app/SamsungSmartSuggestions/SamsungSmartSuggestions.apk|\
+            system/system/priv-app/SamsungSmartSuggestions/SamsungSmartSuggestions.apk|\
+            system/priv-app/PhotoEditor_Full/PhotoEditor_Full.apk|\
+            system/system/priv-app/PhotoEditor_Full/PhotoEditor_Full.apk|\
+            system/priv-app/SecureFolder/SecureFolder.apk|\
+            system/system/priv-app/SecureFolder/SecureFolder.apk)
+                local NATIVE_APP="${FILE##*/}"
+                NATIVE_APP="${NATIVE_APP%.apk}"
+                python3 "$SRC_DIR/unica/patches/exynos9810_device_stack/exynos9810_finalization/verify_bzi6_final_apps.py" \
+                    "$WORK_DIR" "$NATIVE_APP" || return 1
+                LOG "- Preserving locked BZI6 native APK and Samsung signature: $NATIVE_APP"
+                rm -rf "$OUTPUT_PATH/build" "$OUTPUT_PATH/dist"
+                return 0
+                ;;
+        esac
     fi
 
     local SKIP_LIST

 LOCK = HERE / "a376b_android17_runtime_compat.lock.json"
+VENDOR_UEVENTD_SHA256 = "628e3fee174b841c0cf771092034e9e043264c8232e707b4710bba2b0a69645a"
+
+
+def vendor_ueventd(work, stage=False):
+    # M4 ueventd logs an import of /vendor/etc/ueventd.rc, while the pinned
+    # Hybrid Vendor places its hardware permissions at /vendor/ueventd.rc.
+    # Publish the same bytes at the imported path; do not use A37 node rules.
+    source = Path(work) / "vendor/ueventd.rc"
+    target = Path(work) / "vendor/etc/ueventd.rc"
+    if not source.is_file() or source.is_symlink() or digest(source) != VENDOR_UEVENTD_SHA256:
+        raise ValueError("Unreviewed M4 Exynos9810 ueventd source")
+    if target.exists() or target.is_symlink():
+        if not target.is_file() or target.is_symlink() or digest(target) != VENDOR_UEVENTD_SHA256:
+            raise ValueError("Unreviewed M4 imported vendor ueventd configuration")
+    elif stage:
+        target.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(source, target)
+        target.chmod(0o644)
+    else:
+        raise ValueError("M4 imported vendor ueventd configuration missing")
 
 
 def manifest():

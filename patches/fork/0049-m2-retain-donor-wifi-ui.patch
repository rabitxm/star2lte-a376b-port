From: Codex user-selected M2 compatibility limitation
Subject: [PATCH] Retain donor Wi-Fi scan UI for M2 boot test

Reason: user selected temporary donor Wi-Fi UI after exact-descriptor relocation preflight still failed old S22 Settings/SystemUI 80211AX diffs. Skip only these two UI diffs when the explicit M2 profile flag is selected. Validate A376B16/star2lte/M2/Wi-Fi5 scope, keep native HAL/blobs and all other Wi-Fi adaptation branches, reset the flag in M1. Donor scan labels may still say Wi-Fi6; no hardware-capability claim is added.
Files: target/star2lte/profiles/m1-g965f-no-ksu.sh; target/star2lte/profiles/m2-g965f-a376b-android16-no-ksu.sh; unica/patches/product_feature/customize.sh.
Verification: actual dispatch fixtures selected=no UI patches, strict=two patches, wrong donor/milestone rejected; profile reset, shell syntax, patch replay, clean full build. Runtime Wi-Fi needs device logs. Rollback by reverting0049. Kernel and mandatory ADB checks unchanged.

---
--- a/target/star2lte/profiles/m1-g965f-no-ksu.sh
+++ b/target/star2lte/profiles/m1-g965f-no-ksu.sh
@@ -7,6 +7,7 @@
 export EXYNOS9810_FACEUNLOCKFIX_EXPERIMENTAL_BUILD="false"
 export EXYNOS9810_FACEUNLOCKFIX_BUILTIN="false"
 export STAR2LTE_M2_FIXED_RESOLUTION="false"
+export STAR2LTE_M2_KEEP_DONOR_WIFI_UI="false"
 export UN1CA_DONOR_CONFIG="essi"
 export STAR2LTE_BUILD_MODEL="SM-G965F"
 export EXYNOS9810_TARGET_OS_FILE_SYSTEM_TYPE="ext4"
--- a/target/star2lte/profiles/m2-g965f-a376b-android16-no-ksu.sh
+++ b/target/star2lte/profiles/m2-g965f-a376b-android16-no-ksu.sh
@@ -6,3 +6,5 @@
 export EXYNOS9810_FACE_UNLOCK_DISABLED="true"
 # User-selected M2 boot-test limitation: native panel resolution, no switcher.
 export STAR2LTE_M2_FIXED_RESOLUTION="true"
+# User-selected boot-test limitation: retain donor Wi-Fi scan labels/icons.
+export STAR2LTE_M2_KEEP_DONOR_WIFI_UI="true"
--- a/unica/patches/product_feature/customize.sh
+++ b/unica/patches/product_feature/customize.sh
@@ -894,6 +894,15 @@
 
 # SEC_PRODUCT_FEATURE_WLAN_SUPPORT_80211AX
 # SEC_PRODUCT_FEATURE_WLAN_SUPPORT_80211AX_6GHZ
+if [ "${STAR2LTE_M2_KEEP_DONOR_WIFI_UI:-false}" = "true" ]; then
+    if [ "${ROM_SOURCE_CONFIG:-}" != "essi_a376b_android16" ] || \
+            [ "${ROM_MILESTONE:-}" != "M2" ] || [ "$TARGET_CODENAME" != "star2lte" ] || \
+            [ "$TARGET_WLAN_SUPPORT_80211AX" != "false" ] || \
+            [ "$SOURCE_WLAN_SUPPORT_80211AX_6GHZ" != "false" ]; then
+        ABORT "Donor Wi-Fi UI retention is reviewed only for M2 A376B16 star2lte Wi-Fi5"
+        return 1
+    fi
+fi
 if $SOURCE_WLAN_SUPPORT_80211AX; then
     if $TARGET_WLAN_SUPPORT_80211AX; then
         if ! $SOURCE_WLAN_SUPPORT_80211AX_6GHZ; then
@@ -916,10 +925,14 @@
             ABORT "TARGET_WLAN_SUPPORT_80211AX is required by TARGET_WLAN_SUPPORT_80211AX_6GHZ"
         fi
         if ! $SOURCE_WLAN_SUPPORT_80211AX_6GHZ; then
-            APPLY_PATCH "system" "system/priv-app/SecSettings/SecSettings.apk" \
-                "$MODPATH/wifi/80211ax/SecSettings.apk/0001-Disable-80211AX-support.patch"
-            APPLY_PATCH "system_ext" "priv-app/SystemUI/SystemUI.apk" \
-                "$MODPATH/wifi/80211ax/SystemUI.apk/0001-Disable-80211AX-support.patch"
+            if [ "${STAR2LTE_M2_KEEP_DONOR_WIFI_UI:-false}" = "true" ]; then
+                LOGW "M2 user-selected limitation: retain donor Wi-Fi scan labels/icons; target HAL/blobs remain Wi-Fi5"
+            else
+                APPLY_PATCH "system" "system/priv-app/SecSettings/SecSettings.apk" \
+                    "$MODPATH/wifi/80211ax/SecSettings.apk/0001-Disable-80211AX-support.patch"
+                APPLY_PATCH "system_ext" "priv-app/SystemUI/SystemUI.apk" \
+                    "$MODPATH/wifi/80211ax/SystemUI.apk/0001-Disable-80211AX-support.patch"
+            fi
         else
             # TODO handle these conditions
             LOG_MISSING_PATCHES "SOURCE_WLAN_SUPPORT_80211AX" "TARGET_WLAN_SUPPORT_80211AX" || true

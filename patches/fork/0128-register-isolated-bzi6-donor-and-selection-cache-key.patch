+# A376B XXV BZI6: extracted SDK37 / Android17 / OneUI90000.
+# Separate donor registry entry; no M2 profile or compatibility lock is reused.
+# Evidence: docs/m4-donor-dispatch-audit.md and docs/m4-source-selection.md.
+SOURCE_FIRMWARE="SM-A376B/XXV/LOCAL"
+if [ -n "${SOURCE_FIRMWARE_CACHE_SUFFIX:-}" ] && \
+        [ "$SOURCE_FIRMWARE_CACHE_SUFFIX" != A376BXXU5BZI6 ]; then
+    LOGE "BZI6 donor configuration refuses another source cache suffix"
+    return 1
+fi
+SOURCE_FIRMWARE_CACHE_SUFFIX="A376BXXU5BZI6"
+# S22 is a pinned native32 compatibility input; A37 application ABI stays64.
+SOURCE_EXTRA_FIRMWARES=("SM-S901B/EUX/350330051234562")
+SOURCE_PLATFORM_SDK_VERSION=37
+SOURCE_PRODUCT_SHIPPING_API_LEVEL=36
+SOURCE_BOARD_API_LEVEL=34
+SOURCE_SUPER_GROUP_NAME="group_basic"
+SOURCE_AUDIO_CONFIG_RECORDALIVE_LIB_VERSION="07010"
+SOURCE_AUDIO_SUPPORT_ACH_RINGTONE=false
+SOURCE_AUDIO_SUPPORT_DUAL_SPEAKER=true
+SOURCE_AUDIO_SUPPORT_VIRTUAL_VIBRATION_SOUND=false
+SOURCE_BLUETOOTH_SUPPORT_A2DPSINK_PROFILE=none
+SOURCE_BLUETOOTH_SUPPORT_A2DP_SBM=none
+SOURCE_BLUETOOTH_SUPPORT_HEAD_SAR_BACKOFF=none
+SOURCE_BLUETOOTH_SUPPORT_XLNA_CONTROL=none
+if grep -R -q --include='*.sh' 'SOURCE_BLUETOOTH_SUPPORT_' \
+        "$SRC_DIR/unica/patches" "$SRC_DIR/unica/mods" "$SRC_DIR/platform" "$SRC_DIR/target"; then
+    LOGE "A recipe now consumes unknown BZI6 Bluetooth metadata; review donor flags first"
+    return 1
+fi

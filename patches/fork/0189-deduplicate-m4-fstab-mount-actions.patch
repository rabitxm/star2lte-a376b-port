Subject: [PATCH] give M4 canonical hw init sole ownership of fstab mounts

# Reason: M4 probe13 boot6 parses both vendor init variants and the second mount_all reports EBUSY and fs_mgr_mount_all error. Preserve all other legacy actions while mounting only in hw init.
# Affected: a376b_metadata_bind.py and a376b_android17_runtime_compat.py; M4 only, M2 path preserved.
# Verify: real installed rc fixtures, idempotence, rejection of extra/missing mounts, M2 byte preservation, complete runtime self-test, final runtime/ext4 gates; device diagnostic with logcat and rollback required.
# Rollback: revert patch and rebuild; restore saved VENDOR and original BOOT after the controlled device test.

--- a/unica/patches/exynos9810_device_stack/exynos9810_boot_restore/a376b_metadata_bind.py
+++ b/unica/patches/exynos9810_device_stack/exynos9810_boot_restore/a376b_metadata_bind.py
@@ -13,6 +13,37 @@
     mount none /cache/metadata /metadata bind
     restorecon_recursive /metadata
 """
+def single_mounts(canonical, secondary, apply=False):
+    """Keep both legacy rc variants but only the imported hw rc mounts fstab.
+
+    M4 runtime proof: both rc files are parsed and the second mount_all fails
+    with EBUSY. Preserve every other command, including variant differences.
+    """
+    result = secondary
+    for phase in ("early", "late"):
+        command = f"    mount_all /vendor/etc/fstab.${{ro.hardware}} --{phase}\n"
+        marker = f"    # UN1CA M4: --{phase} mount_all is owned by the hw init rc.\n"
+        if canonical.count(command) != 1:
+            raise ValueError("Unreviewed M4 canonical mount_all: " + phase)
+        count, done = result.count(command), result.count(marker)
+        if apply and count == 1 and done == 0:
+            result = result.replace(command, marker, 1)
+        elif count != 0 or done != 1:
+            raise ValueError("Unreviewed M4 secondary mount_all: " + phase)
+    # Reject alternate spellings or additional fstab mounts rather than ignore
+    # a donor/baseline change outside the two reviewed lines.
+    if re.search(r"(?m)^\s*mount_all\s", result):
+        raise ValueError("Unexpected M4 secondary mount_all command")
+    if len(re.findall(r"(?m)^\s*mount_all\s", canonical)) != 2:
+        raise ValueError("Unexpected M4 canonical mount_all command")
+    return result
+
+def verify_single_mounts(root):
+    root = Path(root)
+    canonical = (root/"vendor/etc/init/hw/init.samsungexynos9810.rc").read_text()
+    secondary = (root/"vendor/etc/init/init.samsungexynos9810.rc").read_text()
+    single_mounts(canonical, secondary)
+
 def markers(milestone):

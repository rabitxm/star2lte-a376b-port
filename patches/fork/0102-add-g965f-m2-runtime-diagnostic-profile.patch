+++ b/scripts/internal/prepare_m2_runtime_kernel.py
@@ -0,0 +1,55 @@
+#!/usr/bin/env python3
+"""Prepare the already tested G965F WIPEONFORK kernel in the existing DS-ACK ZIP.
+Reason: the ordinary installer would otherwise overwrite the diagnostic kernel.
+Files: new explicit output only; two ZIP entries differ, DTB/scripts stay pinned
+except a G965F-only guard. No kernel compilation, firmware fetch or device I/O.
+Verify input hashes, decoded BSDIFF result, unchanged entries and recovery install.
+"""
+from pathlib import Path
+import argparse, bz2, hashlib, io, json, struct, zipfile
+SOURCE_SHA = '9a6bad44f3a1a14d43f108fcebeeedfc1b924685f7f13931d902077bceb5c072'
+IMAGE_SHA = '92b14be170225954476869d1fd7700f9c2c92d98eb6447d0181c50a11e80fcdd'
+ENTRY = 'META-INF/com/google/android/update-binary'
+ANCHOR = '\nif [[ $2 = 0 ]]; then\n'
+GUARD = '''
+# Evidence-backed M2 diagnostic: only the calibrated G965F kernel is replaced.
+case "$device" in
+    *G965F*) ;;
+    *) echo "M2 WIPEONFORK diagnostic supports G965F only" >&2; exit 1 ;;
+esac
+'''
+def digest(b): return hashlib.sha256(b).hexdigest()
+def prepare(source, image):
+    if digest(source) != SOURCE_SHA or digest(image) != IMAGE_SHA:
+        raise ValueError('Unreviewed DS-ACK archive or WIPEONFORK Image')
+    # BSDIFF40 extra-only record, interpreted by the original bundled bspatch.
+    ctrl=bz2.compress(struct.pack('<qqq',0,len(image),0),compresslevel=9)
+    diff=bz2.compress(b'',compresslevel=9);extra=bz2.compress(image,compresslevel=9)
+    patch=b'BSDIFF40'+struct.pack('<qqq',len(ctrl),len(diff),len(image))+ctrl+diff+extra
+    assert bz2.decompress(patch[32:32+len(ctrl)])==struct.pack('<qqq',0,len(image),0)
+    assert bz2.decompress(patch[32+len(ctrl)+len(diff):])==image
+    out=io.BytesIO()
+    with zipfile.ZipFile(io.BytesIO(source)) as src, zipfile.ZipFile(out,'w') as dst:
+        script=src.read(ENTRY).decode();assert script.count(ANCHOR)==1
+        for entry in src.infolist():
+            data=src.read(entry)
+            if entry.filename=='floyd/G965F-kernel':data=patch
+            elif entry.filename==ENTRY:data=script.replace(ANCHOR,'\n'+GUARD+ANCHOR,1).encode()
+            entry.compress_type=zipfile.ZIP_STORED
+            dst.writestr(entry,data)
+    data=out.getvalue()
+    with zipfile.ZipFile(io.BytesIO(source)) as src,zipfile.ZipFile(io.BytesIO(data)) as dst:
+        assert src.namelist()==dst.namelist()
+        changed=[n for n in src.namelist() if src.read(n)!=dst.read(n)]
+        assert set(changed)=={ENTRY,'floyd/G965F-kernel'}
+    return data
+if __name__=='__main__':
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--source-zip',type=Path,required=True);p.add_argument('--image',type=Path,required=True)
+    p.add_argument('--output',type=Path,required=True);a=p.parse_args()
+    data=prepare(a.source_zip.read_bytes(),a.image.read_bytes())
+    a.output.parent.mkdir(parents=True,exist_ok=True)
+    with a.output.open('xb') as f:f.write(data)
+    a.output.chmod(0o444)
+    print(json.dumps({'result':'PASS','source_zip_sha256':SOURCE_SHA,'image_sha256':IMAGE_SHA,
+        'output_sha256':digest(data),'bytes':len(data),'dtb_entries_unchanged':True,'model_guard':'G965F only'}))

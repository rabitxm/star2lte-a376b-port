+#!/usr/bin/env python3
+"""Stage and verify the minimal runtime inputs already boot-tested on G965F.
+Reason: A37 25Q4 BPF loader rejects4.9 and retained gralloctypes needs V6.
+Files: existing system Tethering APEX plus one system64 interface only.
+Verify final hashes, selected G965F-only kernel ZIP, persistent metadata and
+compiled Camera enum; ordinary M1/M2 defaults remain independent.
+"""
+from pathlib import Path
+import argparse, hashlib, importlib.util, json, os, re, shutil
+HERE=Path(__file__).resolve().parent
+def lock():return json.loads((HERE/'a376b_runtime_compat.lock.json').read_text())
+def digest(p):return hashlib.sha256(p.read_bytes()).hexdigest()
+def scope():
+    expected={'ROM_SOURCE_CONFIG':'essi_a376b_android16','ROM_MILESTONE':'M2',
+        'TARGET_CODENAME':'star2lte','STAR2LTE_BUILD_MODEL':'SM-G965F',
+        'TARGET_OS_FILE_SYSTEM_TYPE':'ext4','EXYNOS9810_M2_RUNTIME_COMPAT':'true',
+        'EXYNOS9810_ENABLE_METADATA_BIND':'true','EXYNOS9810_ENABLE_KERNELSU_RUNTIME':'false'}
+    for key,value in expected.items():
+        if os.environ.get(key)!=value:raise ValueError('Unreviewed runtime diagnostic scope: '+key)
+    if os.environ.get('EXYNOS9810_M2_BOOTSTRAP_COMPAT','false')!='false':
+        raise ValueError('Do not mix the earlier bootstrap swap with the proven runtime kernel')
+    if digest(Path(os.environ['EXYNOS9810_KERNEL_ZIP']))!=lock()['kernel_zip_sha256']:
+        raise ValueError('Wrong runtime diagnostic kernel archive')
+def apply(work,compat):
+    scope();m=lock();system=work/'system/system'
+    for rel,h in m['files'].items():
+        if digest(compat/rel)!=h:raise ValueError('Unreviewed runtime source: '+rel)
+        dst=system/rel
+        allowed={h,m['original_a37_tethering_sha256']} if rel.startswith('apex/') else {h}
+        if dst.exists() and (dst.is_symlink() or digest(dst) not in allowed):
+            raise ValueError('Unreviewed existing runtime destination: '+rel)
+    for rel in m['files']:
+        dst=system/rel;dst.parent.mkdir(parents=True,exist_ok=True)
+        tmp=dst.with_name(dst.name+'.runtime-tmp');shutil.copyfile(compat/rel,tmp)
+        tmp.chmod(0o644);os.replace(tmp,dst)
+    print('PASS staged pinned M2 Tethering and graphics V6 runtime inputs')
+def verify(work,tools):
+    scope();m=lock();system=work/'system/system'
+    for rel,h in m['files'].items():
+        if digest(system/rel)!=h:raise ValueError('Final runtime file mismatch: '+rel)
+    if digest(system/'bin/cameraserver')!=m['cameraserver_sha256']:
+        raise ValueError('Final cameraserver ABI adaptation lost')
+    # Reapply to an isolated text fixture to verify exact final bind/label state.
+    import tempfile
+    with tempfile.TemporaryDirectory() as td:
+        t=Path(td)
+        paths=['vendor/etc/init/hw/init.samsungexynos9810.rc',
+            'vendor/etc/init/init.samsungexynos9810.rc','system/system/etc/selinux/plat_file_contexts']
+        for rel in paths:
+            p=t/rel;p.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(work/rel,p)
+        spec=importlib.util.spec_from_file_location('m2_meta',HERE/'a376b_metadata_bind.py')
+        meta=importlib.util.module_from_spec(spec);spec.loader.exec_module(meta);meta.apply(t)
+        if any((t/rel).read_bytes()!=(work/rel).read_bytes() for rel in paths):
+            raise ValueError('Final metadata bind/labels missing or duplicated')
+    spec=importlib.util.spec_from_file_location('m2_empty',HERE/'a376b_empty_vendor_flags.py')
+    empty=importlib.util.module_from_spec(spec);spec.loader.exec_module(empty)
+    for n,data in empty.empty_files().items():
+        if (work/'vendor/etc/aconfig'/n).read_bytes()!=data:raise ValueError('Final vendor container drift')
+    adb=HERE.parent/'exynos9810_finalization/adb_defaults.py'
+    spec=importlib.util.spec_from_file_location('m2_adb',adb);checker=importlib.util.module_from_spec(spec);spec.loader.exec_module(checker)
+    text=checker.disassemble_class(system/'priv-app/SamsungCamera/SamsungCamera.apk','x1/k',tools)
+    body=checker.method(text,'a(I)Lx1/k;').group()
+    if not re.search(r'const v0, 0x13a74\s+if-ne p0, v0, (:\w+)\s+sget-object v0, Lx1/k;->V8_0:Lx1/k;\s+return-object v0\s+\1\s+invoke-static',body):
+        raise ValueError('Compiled Camera80500 branch lost')
+    print('PASS final M2 runtime inputs, kernel selection, camera compiled enum and persistent metadata')
+if __name__=='__main__':
+    p=argparse.ArgumentParser(description=__doc__);p.add_argument('mode',choices=['apply','verify'])
+    p.add_argument('--work-dir',type=Path,required=True);p.add_argument('--compat-root',type=Path);p.add_argument('--tools-dir',type=Path)
+    a=p.parse_args()
+    if a.mode=='apply':
+        if a.compat_root is None:p.error('apply needs compat-root')
+        apply(a.work_dir,a.compat_root)
+    else:
+        if a.tools_dir is None:p.error('verify needs tools-dir')
+        verify(a.work_dir,a.tools_dir)

+source "$(dirname -- "${BASH_SOURCE[0]}")/m2-g965f-a376b-android16-no-ksu.sh" || return 1
+_M2_RUNTIME_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"
+export EXYNOS9810_M2_RUNTIME_COMPAT="true"
+export EXYNOS9810_M2_BOOTSTRAP_COMPAT="false"

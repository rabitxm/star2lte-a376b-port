+                    [ "${STAR2LTE_BUILD_MODEL:-}" != SM-G965F ] || \
+                    [ "${SOURCE_PLATFORM_SDK_VERSION:-}" != 37 ] || \
+                    [ "${TARGET_PLATFORM_SDK_VERSION:-}" != 31 ] || \
+                    [ "${TARGET_BOARD_API_LEVEL:-}" != 33 ] || \
+                    [ "${SOURCE_FIRMWARE_CACHE_SUFFIX:-}" != A376BXXU5BZI6 ] || \
+                    [ "${SOURCE_FIRMWARE:-}" != SM-A376B/XXV/LOCAL ]; then
+                LOGE "Unreviewed BZI6 UN1CA suggestion shortcut scope"
+                return 1
+            fi
+            LOGW "BZI6 SecSettings relocates FOTA suggestion DEX; retaining donor behavior and skipping the optional UN1CA shortcut"
             continue
         fi

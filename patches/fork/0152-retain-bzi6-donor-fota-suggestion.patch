From: Codex <codex@openai.com>
Subject: [PATCH] Retain BZI6 donor FOTA suggestion behavior

# Reason: attempt24 line1179 shows the optional legacy UN1CA Updates suggestion patch expects Settings$FOTASuggestionActivity in smali_classes2, but BZI6 relocates the class to smali. The shortcut is optional and retaining donor behavior avoids an unreviewed Android17 Settings edit.
# Affected: scripts/internal/apply_modules.sh.
# Verify: exact M4/G965F/BZI6 branch skips this one patch; wrong model/milestone/donor fail closed; unrelated and AZH4 routes retain existing behavior; shell syntax and dispatcher tests pass; clean attempt25.
# Rollback: remove patch0152 from patches/fork/series and sources.lock.json, then restore the previous module dispatcher.

--- a/scripts/internal/apply_modules.sh
+++ b/scripts/internal/apply_modules.sh
@@ -194,6 +194,21 @@
         if [ "${ROM_SOURCE_CONFIG:-}" = "essi_a376b_android16" ] && \
                 [[ "$p" == */choidujour/smali/system/priv-app/SecSettings/SecSettings.apk/0001-Launch-UN1CA-Updates-from-suggestions.patch ]]; then
             LOGW "A376B AZH4 has no legacy FOTA suggestion activity; skipping only the UN1CA Updates suggestion shortcut"
+            continue
+        fi
+        if [ "${ROM_SOURCE_CONFIG:-}" = "essi_a376b_android17" ] && \
+                [[ "$p" == */choidujour/smali/system/priv-app/SecSettings/SecSettings.apk/0001-Launch-UN1CA-Updates-from-suggestions.patch ]]; then

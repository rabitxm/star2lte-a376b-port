@@ -0,0 +1,77 @@
+# A376B XXV AZH4: imported/MD5+CRC verified, Android16 SDK36.1 / OneUI80500.
+# Parallel donor configuration; ESSI layout and S22 config remain independent.
+# Evidence: project logs/20261021-m2-inputs and docs/m2-build.md.
+SOURCE_FIRMWARE="SM-A376B/XXV/LOCAL"
+SOURCE_EXTRA_FIRMWARES=()
+SOURCE_PLATFORM_SDK_VERSION=36
+SOURCE_PRODUCT_SHIPPING_API_LEVEL=36
+# AZH4 exports board.first_api_level=34, not ro.board.api_level.
+SOURCE_BOARD_API_LEVEL=34
+SOURCE_SUPER_GROUP_NAME="group_basic"
+SOURCE_AUDIO_CONFIG_RECORDALIVE_LIB_VERSION="07010"
+SOURCE_AUDIO_SUPPORT_ACH_RINGTONE=false
+SOURCE_AUDIO_SUPPORT_DUAL_SPEAKER=true
+SOURCE_AUDIO_SUPPORT_VIRTUAL_VIBRATION_SOUND=false
+# These four legacy metadata flags have no recipe consumer in this checkout.
+# Unknown native Bluetooth build flags are explicit rather than copied from S22.
+SOURCE_BLUETOOTH_SUPPORT_A2DPSINK_PROFILE=none
+SOURCE_BLUETOOTH_SUPPORT_A2DP_SBM=none
+SOURCE_BLUETOOTH_SUPPORT_HEAD_SAR_BACKOFF=none
+SOURCE_BLUETOOTH_SUPPORT_XLNA_CONTROL=none
+if grep -R -q --include='*.sh' 'SOURCE_BLUETOOTH_SUPPORT_' \
+        "$SRC_DIR/unica/patches" "$SRC_DIR/unica/mods" "$SRC_DIR/platform" "$SRC_DIR/target"; then
+    LOGE "A recipe now consumes unknown A376B Bluetooth metadata; review donor flags first"
+    return 1
+fi
+SOURCE_CAMERA_SUPPORT_CAMERAX_EXTENSION=true
+SOURCE_CAMERA_SUPPORT_CUTOUT_PROTECTION=false
+SOURCE_CAMERA_SUPPORT_MASS_APP_FLAVOR=true
+SOURCE_CAMERA_SUPPORT_SDK_SERVICE=false
+SOURCE_COMMON_CONFIG_MDNIE_MODE="37905"
+SOURCE_COMMON_SUPPORT_DYN_RESOLUTION_CONTROL=false
+SOURCE_COMMON_SUPPORT_EMBEDDED_SIM=true
+SOURCE_COMMON_SUPPORT_HDR_EFFECT=false
+SOURCE_DVFSAPP_CONFIG_DVFS_POLICY_FILENAME="dvfs_policy_default"
+SOURCE_DVFSAPP_CONFIG_SSRM_POLICY_FILENAME="siop_a37x_s5e8845"
+SOURCE_FINGERPRINT_CONFIG_SENSOR="google_touch_display_optical,settings=3"
+SOURCE_LCD_CONFIG_COLOR_WEAKNESS_SOLUTION="3"
+SOURCE_LCD_CONFIG_CONTROL_AUTO_BRIGHTNESS="5"
+SOURCE_LCD_CONFIG_HFR_DEFAULT_REFRESH_RATE="120"
+SOURCE_LCD_CONFIG_HFR_MODE="2"
+SOURCE_LCD_CONFIG_HFR_SUPPORTED_REFRESH_RATE="60,120"
+SOURCE_LCD_CONFIG_HFR_SUPPORTED_REFRESH_RATE_NS="none"
+SOURCE_LCD_CONFIG_SEAMLESS_BRT="89,91"
+SOURCE_LCD_CONFIG_SEAMLESS_LUX="260,2500"
+SOURCE_LCD_SUPPORT_MDNIE_HW=false
+SOURCE_SECURITY_CONFIG_ESE_CHIP_VENDOR="NXP_SKU"
+SOURCE_SECURITY_CONFIG_ESE_COS_NAME="JCOP6.5U"
+SOURCE_RIL_FEATURES="onebinary"
+SOURCE_RIL_SIM_CONFIG_MULTISIM_TRAYCOUNT="1"
+SOURCE_RIL_SUPPORT_WATERPROOF_SIM_TRAY_MSG=true
+SOURCE_WLAN_CONFIG_CONNECTION_PERSONALIZATION="1"
+SOURCE_WLAN_CONFIG_CPU_CSTATE_DISABLE_THRESHOLD="0"
+SOURCE_WLAN_CONFIG_CUSTOM_BACKOFF="CAM_BACK -1 -1 -1 9 -1 -1"
+SOURCE_WLAN_CONFIG_DATA_ACTIVITY_AFFINITY_BOOSTER_THRESHOLD="0"
+SOURCE_WLAN_CONFIG_DYNAMIC_SWITCH="0"
+SOURCE_WLAN_CONFIG_L1SS_DISABLE_THRESHOLD="0"
+SOURCE_WLAN_SUPPORT_80211AX=true
+SOURCE_WLAN_SUPPORT_80211AX_6GHZ=false
+SOURCE_WLAN_SUPPORT_APE_SERVICE=true
+# AZH4 does not preseed legacy feature IDs 2/3. Runtime HAL feature detection
+# remains dynamic; these describe the static default, not hardware acceptance.
+SOURCE_WLAN_SUPPORT_LOWLATENCY=false
+SOURCE_WLAN_SUPPORT_MBO=true
+# Antenna count is parsed from HAL capability bits; preserve that runtime path.
+SOURCE_WLAN_SUPPORT_MIMO=true
+SOURCE_WLAN_SUPPORT_MOBILEAP_11AX=true
+SOURCE_WLAN_SUPPORT_MOBILEAP_5G_BASEDON_COUNTRY=false
+SOURCE_WLAN_SUPPORT_MOBILEAP_6G=false
+SOURCE_WLAN_SUPPORT_MOBILEAP_DUALAP=false
+SOURCE_WLAN_SUPPORT_MOBILEAP_OWE=false
+SOURCE_WLAN_SUPPORT_MOBILEAP_POWER_SAVEMODE=true
+SOURCE_WLAN_SUPPORT_MOBILEAP_PRIORITIZE_TRAFFIC=false
+SOURCE_WLAN_SUPPORT_MOBILEAP_WIFI_CONCURRENCY=true
+SOURCE_WLAN_SUPPORT_MOBILEAP_WIFISHARING_LITE=false
+SOURCE_WLAN_SUPPORT_SWITCH_FOR_INDIVIDUAL_APPS=true
+SOURCE_WLAN_SUPPORT_TWT_CONTROL=false
+SOURCE_WLAN_SUPPORT_WIFI_TO_CELLULAR=false

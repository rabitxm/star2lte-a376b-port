+#!/usr/bin/env python3
+"""Keep the BZI6 FaceWidget lifecycle initialization on SystemUI's main looper.
+
+Reason: a fresh crash shows PluginFaceWidgetManager's BG Handler calls the
+plugin setter, whose Dagger constructor reaches LifecycleRegistry.setCurrentState.
+Files: three exact BZI6 SystemUI Smali classes only.
+Verify: source/output hashes, generation + instance guards, APK decode roundtrip,
+and ext4 image byte check. Runtime race/UI checks remain required.
+Rollback: rebuild from the unmodified BZI6 SystemUI APK; no AOD feature is removed.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+HERE = Path(__file__).resolve().parent
+LOCK = HERE / "a376b_android17_facewidget_thread.lock.json"
+BASE = Path("smali_classes2/com/android/systemui/facewidget/plugin")
+FILES = {
+    "manager": BASE / "PluginFaceWidgetManager.smali",
+    "bg": BASE / "PluginFaceWidgetManager$6.smali",
+    "ui": BASE / "PluginFaceWidgetManager$5.smali",
+}
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def replace_once(text, before, after, label):
+    count = text.count(before)
+    if count != 1:
+        raise ValueError(f"BZI6 FaceWidget {label} anchor count {count}, expected 1")
+    return text.replace(before, after, 1)
+
+
+def load_lock():
+    return json.loads(LOCK.read_text())
+
+
+def source_files(root):
+    return {key: Path(root) / rel for key, rel in FILES.items()}
+
+
+def verify_tree(root, expected):
+    paths = source_files(root)
+    for key, path in paths.items():
+        if not path.is_file() or path.is_symlink() or sha(path.read_bytes()) != expected[key]:
+            raise ValueError("M4 FaceWidget class hash mismatch: " + key)
+    manager, bg, ui = (paths[k].read_text() for k in ("manager", "bg", "ui"))
+    checks = [
+        ("manager generation", "mFaceWidgetConnectionGeneration" in manager),
+        ("main dispatch validates generation", "mFaceWidgetConnectionGeneration" in ui),
+        ("main dispatch validates plugin instance", "mConnectedPlugin" in ui),
+        ("main dispatch invokes init directly", "PluginFaceWidgetManager$6;->handleMessage(Landroid/os/Message;)V" in ui),
+        ("background handler routes init", "Message;->arg2:I" in bg and "mUiHandler" in bg),
+        ("callback remains present", "setPluginFaceWidgetCallback" in bg),
+    ]
+    failed = [name for name, ok in checks if not ok]
+    if failed:
+        raise ValueError("M4 FaceWidget compiled structure missing: " + ", ".join(failed))
+    return {"result": "PASS", "classes": {k: sha(p.read_bytes()) for k, p in paths.items()},
+            "guards": [name for name, _ in checks]}
+
+
+def apply(root):
+    lock = load_lock()
+    paths = source_files(root)
+    texts = {}
+    for key, path in paths.items():
+        if not path.is_file() or path.is_symlink():
+            raise ValueError("BZI6 SystemUI FaceWidget class missing: " + key)
+        raw = path.read_bytes()
+        if sha(raw) != lock["source_classes"][key]:
+            raise ValueError("Unreviewed BZI6 SystemUI FaceWidget preimage: " + key)
+        texts[key] = raw.decode()
+
+    m = texts["manager"]
+    m = replace_once(m,
+        ".field public mFaceWidgetPlugin:Lcom/android/systemui/plugins/keyguardstatusview/PluginKeyguardStatusView;\n",
+        ".field public mFaceWidgetPlugin:Lcom/android/systemui/plugins/keyguardstatusview/PluginKeyguardStatusView;\n.field public mFaceWidgetConnectionGeneration:I\n",
+        "generation field")
+    m = replace_once(m,
+        "    iput-object p1, p0, Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager;->mConnectedPlugin:Lcom/android/systemui/plugins/keyguardstatusview/PluginKeyguardStatusView;\n\n    iget-object p0, p0, Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager;->mBgHandler:",
+        "    iput-object p1, p0, Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager;->mConnectedPlugin:Lcom/android/systemui/plugins/keyguardstatusview/PluginKeyguardStatusView;\n\n    iget v0, p0, Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager;->mFaceWidgetConnectionGeneration:I\n\n    add-int/lit8 v0, v0, 0x1\n\n    iput v0, p0, Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager;->mFaceWidgetConnectionGeneration:I\n\n    iget-object p0, p0, Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager;->mBgHandler:",
+        "connect generation")
+    m = replace_once(m,
+        "    invoke-virtual {p0, p2, p1}, Landroid/os/Handler;->obtainMessage(ILjava/lang/Object;)Landroid/os/Message;\n\n    move-result-object p1\n\n    invoke-virtual {p0, p1}, Landroid/os/Handler;->sendMessage(Landroid/os/Message;)Z",
+        "    invoke-virtual {p0, p2, p1}, Landroid/os/Handler;->obtainMessage(ILjava/lang/Object;)Landroid/os/Message;\n\n    move-result-object p1\n\n    iget-object v0, p0, Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager$6;->this$0:Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager;\n\n    iget v0, v0, Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager;->mFaceWidgetConnectionGeneration:I\n\n    iput v0, p1, Landroid/os/Message;->arg1:I\n\n    invoke-virtual {p0, p1}, Landroid/os/Handler;->sendMessage(Landroid/os/Message;)Z",
+        "connect message generation")
+    m = replace_once(m,
+        "    iput-object v0, p0, Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager;->mConnectedPlugin:Lcom/android/systemui/plugins/keyguardstatusview/PluginKeyguardStatusView;\n\n    iget-object v0, p0, Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager;->mBgHandler:",
+        "    iput-object v0, p0, Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager;->mConnectedPlugin:Lcom/android/systemui/plugins/keyguardstatusview/PluginKeyguardStatusView;\n\n    iget v2, p0, Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager;->mFaceWidgetConnectionGeneration:I\n\n    add-int/lit8 v2, v2, 0x1\n\n    iput v2, p0, Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager;->mFaceWidgetConnectionGeneration:I\n\n    iget-object v0, p0, Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager;->mBgHandler:",
+        "disconnect generation")
+
+    bg = texts["bg"]
+    bg = replace_once(bg,
+        "    iget v0, p1, Landroid/os/Message;->what:I\n\n    const/4 v1, 0x0\n",
+        "    iget v0, p1, Landroid/os/Message;->what:I\n\n    if-eqz v0, :facewidget_check_main_dispatch\n\n    goto :facewidget_dispatch_ready\n\n    :facewidget_check_main_dispatch\n    iget v1, p1, Landroid/os/Message;->arg2:I\n\n    const/4 v2, 0x1\n\n    if-eq v1, v2, :facewidget_dispatch_ready\n\n    iget-object v1, p0, Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager$6;->this$0:Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager;\n\n    iget-object v1, v1, Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager;->mUiHandler:Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager$5;\n\n    const/4 v2, 0x5\n\n    iget-object v3, p1, Landroid/os/Message;->obj:Ljava/lang/Object;\n\n    invoke-virtual {v1, v2, v3}, Landroid/os/Handler;->obtainMessage(ILjava/lang/Object;)Landroid/os/Message;\n\n    move-result-object v2\n\n    iget v3, p1, Landroid/os/Message;->arg1:I\n\n    iput v3, v2, Landroid/os/Message;->arg1:I\n\n    invoke-virtual {v1, v2}, Landroid/os/Handler;->sendMessage(Landroid/os/Message;)Z\n\n    return-void\n\n    :facewidget_dispatch_ready\n    const/4 v1, 0x0\n",
+        "BG to UI handoff")
+
+    ui = texts["ui"]
+    ui = replace_once(ui,
+        "    const/4 v5, 0x2\n\n    if-eq v0, v5, :cond_4\n",
+        "    const/4 v5, 0x5\n\n    if-ne v0, v5, :m4_facewidget_existing_dispatch\n\n    move-object/from16 v6, p1\n\n    iget-object v1, v6, Landroid/os/Message;->obj:Ljava/lang/Object;\n\n    iget v2, v6, Landroid/os/Message;->arg1:I\n\n    iget v4, v3, Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager;->mFaceWidgetConnectionGeneration:I\n\n    if-ne v2, v4, :m4_facewidget_stale_main_dispatch\n\n    iget-object v4, v3, Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager;->mConnectedPlugin:Lcom/android/systemui/plugins/keyguardstatusview/PluginKeyguardStatusView;\n\n    if-ne v1, v4, :m4_facewidget_stale_main_dispatch\n\n    iget-object v4, v3, Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager;->mBgHandler:Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager$6;\n\n    const/4 v5, 0x0\n\n    invoke-virtual {v4, v5, v1}, Landroid/os/Handler;->obtainMessage(ILjava/lang/Object;)Landroid/os/Message;\n\n    move-result-object v1\n\n    iput v2, v1, Landroid/os/Message;->arg1:I\n\n    const/4 v5, 0x1\n\n    iput v5, v1, Landroid/os/Message;->arg2:I\n\n    invoke-virtual {v4, v1}, Lcom/android/systemui/facewidget/plugin/PluginFaceWidgetManager$6;->handleMessage(Landroid/os/Message;)V\n\n    return-void\n\n    :m4_facewidget_stale_main_dispatch\n    return-void\n\n    :m4_facewidget_existing_dispatch\n    const/4 v5, 0x2\n\n    if-eq v0, v5, :cond_4\n",
+        "main generation and instance gate")
+
+    for key, text in (("manager", m), ("bg", bg), ("ui", ui)):
+        path = paths[key]
+        path.write_text(text)
+    report = verify_tree(root, lock["output_classes"])
+    print(json.dumps(report, sort_keys=True))
+
+
+def verify_apk(apk, apktool, temp_root):
+    lock = load_lock()
+    temp_root = Path(temp_root)
+    temp_root.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix="m4-facewidget-roundtrip-", dir=temp_root) as td:
+        decoded = Path(td) / "decoded"
+        subprocess.run([str(apktool), "d", "--no-res", "--no-debug-info", "-o", str(decoded), str(apk)],
+                       check=True, capture_output=True, text=True)
+        report = verify_tree(decoded, lock["roundtrip_classes"])
+    report["apk_sha256"] = sha(Path(apk).read_bytes())
+    print(json.dumps(report, sort_keys=True))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    sub = parser.add_subparsers(dest="command", required=True)
+    apply_p = sub.add_parser("apply-work")
+    apply_p.add_argument("--systemui-dir", type=Path, required=True)
+    check = sub.add_parser("verify-work")
+    check.add_argument("--systemui-dir", type=Path, required=True)
+    apk = sub.add_parser("verify-apk")
+    apk.add_argument("--apk", type=Path, required=True)
+    apk.add_argument("--apktool", type=Path, required=True)
+    apk.add_argument("--temp-root", type=Path, required=True)
+    args = parser.parse_args()
+    if args.command != "verify-apk":
+        expected_env = {"ROM_SOURCE_CONFIG": "essi_a376b_android17", "ROM_MILESTONE": "M4",
+                        "TARGET_CODENAME": "star2lte", "STAR2LTE_BUILD_MODEL": "SM-G965F",
+                        "SOURCE_PLATFORM_SDK_VERSION": "37", "EXYNOS9810_M4_RUNTIME_COMPAT": "true"}
+        import os
+        for key, value in expected_env.items():
+            if os.environ.get(key) != value:
+                raise ValueError("M4 FaceWidget scope mismatch: " + key)
+    if args.command == "apply-work":
+        apply(args.systemui_dir)
+    elif args.command == "verify-work":
+        print(json.dumps(verify_tree(args.systemui_dir, load_lock()["output_classes"]), sort_keys=True))
+    else:
+        verify_apk(args.apk, args.apktool, args.temp_root)
+
+
+if __name__ == "__main__":
+    main()

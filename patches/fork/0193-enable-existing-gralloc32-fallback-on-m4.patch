+def mapper_fallback(work, donor, stage=False):
+    for rel, entry in manifest()["runtime_patches"].items():
+        source = Path(donor) / rel
+        if not source.is_file() or source.is_symlink() or digest(source) != entry["source_sha256"]:
+            raise ValueError("Unreviewed M4 mapper source: " + rel)
+        data = source.read_bytes()
+        if data[:6] != b"\x7fELF\x02\x01" or struct.unpack_from("<H", data, 18)[0] != 183:
+            raise ValueError("M4 mapper source must be ELF64 AArch64")
+        phoff = struct.unpack_from("<Q", data, 32)[0]
+        size, count = struct.unpack_from("<HH", data, 54)
+        va = entry["branch_va"]
+        offsets = []
+        for index in range(count):
+            kind, flags, offset, start, _, length, _, _ = struct.unpack_from(
+                "<IIQQQQQQ", data, phoff + index * size)
+            if kind == 1 and flags & 1 and start <= va < start + length:
+                offsets.append(offset + va - start)
+        if len(offsets) != 1:
+            raise ValueError("M4 mapper branch must map to one executable segment")
+        offset = offsets[0]
+        before = bytes.fromhex(entry["instruction_before"])
+        after = bytes.fromhex(entry["instruction_after"])
+        instruction = int.from_bytes(before, "little")
+        immediate = (instruction >> 5) & 0x7ffff
+        if immediate & 0x40000:
+            immediate -= 0x80000
+        if len(before) != 4 or after != bytes.fromhex("1f2003d5") or \
+                instruction & 0xff00001f != 0x5400000c or \
+                va + immediate * 4 != entry["branch_target_va"] or \
+                data[offset:offset + 4] != before or \
+                data[offset - 8:offset + 20].hex() != entry["context_before_bytes"]:
+            raise ValueError("M4 API-level mapper branch/context mismatch")
+        patched = data[:offset] + after + data[offset + 4:]
+        if hashlib.sha256(patched).hexdigest() != entry["output_sha256"]:
+            raise ValueError("M4 mapper four-byte output mismatch")
+        target = Path(work) / rel
+        if target.exists() or target.is_symlink():
+            allowed = {entry["source_sha256"], entry["output_sha256"]} if stage else {entry["output_sha256"]}
+            if not target.is_file() or target.is_symlink() or digest(target) not in allowed:
+                raise ValueError("Unreviewed M4 mapper destination: " + rel)
+        elif not stage:
+            raise ValueError("Missing M4 mapper fallback library")
+        if stage and (not target.exists() or digest(target) != entry["output_sha256"]):
+            target.parent.mkdir(parents=True, exist_ok=True)
+            target.write_bytes(patched)
+            target.chmod(0o644)
+

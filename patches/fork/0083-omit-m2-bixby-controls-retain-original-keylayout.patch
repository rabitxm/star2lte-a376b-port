             COUNT=$((COUNT + 1))
         fi
     done < <(find "$KEYLAYOUT_DIR" -maxdepth 1 -type f -name "*.kl" -print0)
 
-    LOG "  - Remapped key 703 in $COUNT keylayout file(s) to USER"

+def ion_file_context(work, donor, stage=False):
+    # BZI6 removed the /dev/ion pathname while the Hybrid Vendor gralloc
+    # still opens that legacy node inside app processes. Restore only the
+    # exact node label; existing policy permissions and Enforcing stay intact.
+    entry = manifest()["legacy_ion_context"]
+    source = Path(donor) / entry["path"]
+    if source.is_symlink() or not source.is_file() or digest(source) != entry["donor_sha256"]:
+        raise ValueError("Unreviewed BZI6 platform file contexts source")
+    target = Path(work) / entry["path"]
+    if target.is_symlink() or not target.is_file():
+        raise ValueError("M4 platform file contexts missing or symlinked")
+    data = target.read_text()
+    rows = [line for line in data.splitlines()
+            if line.split() and line.split()[0] == "/dev/ion"]
+    if rows == [entry["rule"]]:
+        return
+    if rows:
+        raise ValueError("Conflicting or duplicated M4 /dev/ion file context")
+    if not stage:
+        raise ValueError("M4 /dev/ion file context missing")
+    target.write_text(data.rstrip("\n") + "\n" + entry["rule"] + "\n")
 
 

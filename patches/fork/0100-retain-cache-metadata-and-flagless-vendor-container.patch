+++ b/unica/patches/exynos9810_device_stack/exynos9810_boot_restore/a376b_empty_vendor_flags.py
@@ -0,0 +1,44 @@
+#!/usr/bin/env python3
+"""Describe the flagless VNDK33 vendor using an empty aconfig v2 container.
+Reason: A37 aconfigd skips absent vendor storage then fails applying vendor
+staged overrides. No vendor flag is invented or copied from the A37 hardware.
+Files: four generated vendor/etc/aconfig files only. Existing nonempty/unknown
+storage is refused. Format is from the fork's AOSP platform_build/tools/aconfig/
+aconfig_storage_file Rust serializers; validate with independent AOSP Java
+readers and the actual donor aconfigd before accepting.
+"""
+from pathlib import Path
+import struct, argparse, json, hashlib
+
+def empty_files():
+    out={}
+    for kind,name in enumerate(('package.map','flag.map','flag.val','flag.info')):
+        prefix=struct.pack('<II',2,6)+b'vendor'+bytes([kind])
+        if kind<2:
+            header=len(prefix)+16;size=header+7*4
+            data=prefix+struct.pack('<IIII',size,0,header,size)+bytes(28)
+        else:
+            header=len(prefix)+12
+            data=prefix+struct.pack('<III',header,0,header)
+        assert struct.unpack_from('<I',data,len(prefix))[0]==len(data)
+        out[name]=data
+    return out
+
+def apply(work):
+    dest=Path(work)/'vendor/etc/aconfig';files=empty_files()
+    if dest.exists():
+        if dest.is_symlink() or not dest.is_dir() or any(p.name not in files for p in dest.iterdir()):
+            raise ValueError('Unreviewed vendor aconfig content')
+        for name,data in files.items():
+            path=dest/name
+            if path.exists() and (path.is_symlink() or path.read_bytes()!=data):
+                raise ValueError('Refuse replacing actual vendor flags: '+name)
+    dest.mkdir(parents=True,exist_ok=True)
+    for name,data in files.items():
+        path=dest/name
+        if not path.exists():path.write_bytes(data)
+        path.chmod(0o444)
+    return {n:hashlib.sha256(v).hexdigest() for n,v in files.items()}
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('work_dir',type=Path)
+    print(json.dumps({'result':'PASS','vendor_packages':0,'vendor_flags':0,'sha256':apply(parser.parse_args().work_dir)},indent=2))

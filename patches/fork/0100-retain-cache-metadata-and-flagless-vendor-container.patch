+++ b/unica/patches/exynos9810_device_stack/exynos9810_boot_restore/a376b_metadata_bind.py
@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+"""Finalize the fork's existing CACHE-backed metadata mount for M2.
+Reason: vendor baseline restore removes the early recipe's metadata bind.
+Files: canonical vendor hw init, duplicate init block if present, system file contexts.
+Verify actual CACHE-backed /metadata, aconfig labels, flags and reboot persistence.
+"""
+from pathlib import Path
+import argparse, re, json
+ANCHOR = "    mount_all /vendor/etc/fstab.${ro.hardware} --early\n"
+BIND = """
+    # UN1CA Exynos9810 metadata bind mount for devices without a metadata partition.
+    mkdir /cache/metadata 0771 root system
+    mount none /cache/metadata /metadata bind
+    restorecon_recursive /metadata
+"""
+START = "# UN1CA M2 CACHE metadata label aliases BEGIN"
+END = "# UN1CA M2 CACHE metadata label aliases END"
+def apply(root):
+    root=Path(root)
+    hw=root/"vendor/etc/init/hw/init.samsungexynos9810.rc"
+    duplicate=root/"vendor/etc/init/init.samsungexynos9810.rc"
+    fc=root/"system/system/etc/selinux/plat_file_contexts"
+    updates={}
+    for path in (hw, duplicate):
+        text=path.read_text()
+        if text.count(ANCHOR)!=1:raise ValueError(f"Unreviewed init mount_all anchor: {path}")
+        # Remove only this fork's exact block, including a pre-restore copy.
+        text=text.replace(BIND, "")
+        if "mount none /cache/metadata /metadata bind" in text:
+            raise ValueError(f"Unreviewed metadata mount: {path}")
+        if path==hw:text=text.replace(ANCHOR, ANCHOR+BIND,1)
+        updates[path]=text
+    text=fc.read_text()
+    text=re.sub(r"\n?"+re.escape(START)+r"\n.*?"+re.escape(END)+r"\n?", "\n", text, flags=re.S)
+    metadata=[line for line in text.splitlines() if line.startswith("/metadata") and line.split()[0].startswith("/metadata")]
+    if not metadata or not any("aconfig_storage_flags_metadata_file" in s for s in metadata):
+        raise ValueError("Donor metadata/aconfig labels incomplete")
+    # /cache is restorecon_recursive'd by core init after the fs-stage bind.
+    # Mirror every original metadata label at its persistent CACHE path.
+    aliases=["/cache"+line for line in metadata]
+    if any(line.startswith("/cache/metadata") for line in text.splitlines()):
+        raise ValueError("Unreviewed existing CACHE metadata labels")
+    updates[fc]=text.rstrip()+"\n\n"+START+"\n"+"\n".join(aliases)+"\n"+END+"\n"
+    for path,data in updates.items():path.write_text(data)
+    return {"result":"PASS","mount":"/cache/metadata -> /metadata","canonical_rc":str(hw),"aliases":len(aliases)}
+if __name__=="__main__":
+    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument("work_dir",type=Path)
+    print(json.dumps(apply(parser.parse_args().work_dir)))

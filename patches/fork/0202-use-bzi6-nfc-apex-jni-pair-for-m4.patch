+#!/usr/bin/env python3
+"""Select and verify the matching BZI6 NFC APEX Java/JNI pair for M4/G965F.
+
+Reason: the observed crash was caused by the PHN system JNI's missing provider,
+but audit found its NativeNfcManager contract differs from BZI6 Java (72 vs 54
+declared native methods). The BZI6 APEX contains the JNI built with its Java.
+Files: removes only the PHN global libnfc_nci_jni.so from the M4 work tree;
+keeps target SLSI vendor/HAL and Samsung NFC JNI untouched.
+Verify: lock the input blobs and embedded APEX JNI; verify the final work tree
+contains the exact BZI6 APEX and has no global PHN JNI shadow. Runtime HAL/JNI
+registration and tag I/O remain required.
+Rollback: reverse this profile-scoped call and restore the original target JNI;
+no source firmware or device partition is modified.
+"""
+from pathlib import Path
+import argparse
+import hashlib
+import io
+import json
+import subprocess
+import tempfile
+import zipfile
+
+HERE = Path(__file__).resolve().parent
+LOCK = HERE / "a376b_android17_nfc_native.lock.json"
+
+
+def sha(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def read_lock():
+    return json.loads(LOCK.read_text())
+
+
+def extract_apex_jni(capex, lock):
+    with zipfile.ZipFile(capex) as capex_zip:
+        original_apex = capex_zip.read("original_apex")
+    with zipfile.ZipFile(io.BytesIO(original_apex)) as apex_zip:
+        payload = apex_zip.read("apex_payload.img")
+    with tempfile.TemporaryDirectory(prefix="m4-nfc-apex-") as td:
+        payload_path = Path(td) / "apex_payload.img"
+        jni_path = Path(td) / "libnfc_nci_jni.so"
+        payload_path.write_bytes(payload)
+        subprocess.run(["debugfs", "-R", "dump " + lock["apex_embedded_jni_path"] + " " + str(jni_path),
+                        str(payload_path)], check=True, capture_output=True, text=True)
+        if not jni_path.is_file() or sha(jni_path) != lock["apex_embedded_jni_sha256"]:
+            raise ValueError("BZI6 NFC APEX embedded JNI hash mismatch")
+
+
+def verify_sources(target_root, donor_root):
+    lock = read_lock()
+    target_root, donor_root = Path(target_root), Path(donor_root)
+    target_jni = target_root / "system/system/lib64/libnfc_nci_jni.so"
+    if not target_jni.is_file() or sha(target_jni) != lock["target_jni_sha256"]:
+        raise ValueError("Unreviewed G965F PHN NFC JNI input")
+    capex = donor_root / lock["source_capex_path"]
+    if not capex.is_file() or sha(capex) != lock["source_capex_sha256"]:
+        raise ValueError("Unreviewed BZI6 NFC APEX input")
+    sec_nfc = donor_root / lock["system_sec_nfc_apk_path"]
+    if not sec_nfc.is_file() or sha(sec_nfc) != lock["system_sec_nfc_apk_sha256"]:
+        raise ValueError("Unreviewed BZI6 SecNfc input")
+    extract_apex_jni(capex, lock)
+    return lock
+
+
+def verify_work(work, target_root, donor_root):
+    lock = verify_sources(target_root, donor_root)
+    work = Path(work)
+    for rel, expected in ((lock["source_capex_path"], lock["source_capex_sha256"]),
+                          (lock["system_sec_nfc_apk_path"], lock["system_sec_nfc_apk_sha256"])):
+        path = work / "system" / rel.removeprefix("system/")
+        if not path.is_file() or sha(path) != expected:
+            raise ValueError("M4 NFC donor input is not retained in work tree: " + rel)
+    shadow = work / "system/system/lib64/libnfc_nci_jni.so"
+    if shadow.exists() or shadow.is_symlink():
+        raise ValueError("PHN NFC JNI still shadows the BZI6 APEX implementation")
+    return {"apex_jni_sha256": lock["apex_embedded_jni_sha256"],
+            "system_phn_jni": "omitted", "target_hal": "star2lte SLSI retained"}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    sub = parser.add_subparsers(dest="command", required=True)
+    for name in ("verify-source", "apply-work", "verify-work"):
+        p = sub.add_parser(name)
+        p.add_argument("--work-dir", type=Path)
+        p.add_argument("--target-root", type=Path, required=True)
+        p.add_argument("--donor-root", type=Path, required=True)
+    args = parser.parse_args()
+    if args.command == "verify-source":
+        lock = verify_sources(args.target_root, args.donor_root)
+        result = {"apex_jni_sha256": lock["apex_embedded_jni_sha256"], "result": "PASS"}
+    else:
+        if not args.work_dir:
+            parser.error("--work-dir is required")
+        if args.command == "apply-work":
+            verify_sources(args.target_root, args.donor_root)
+            shadow = args.work_dir / "system/system/lib64/libnfc_nci_jni.so"
+            shadow.unlink(missing_ok=True)
+        result = verify_work(args.work_dir, args.target_root, args.donor_root)
+        result["result"] = "PASS"
+    print(json.dumps(result, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()

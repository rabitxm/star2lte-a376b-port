--- a/unica/patches/exynos9810_device_stack/customize.sh
+++ b/unica/patches/exynos9810_device_stack/customize.sh
@@ -264,6 +264,41 @@
     if [ ! -f "$SMALI" ]; then
         LOGE "SyntheticPasswordManager.smali not found in decoded services.jar"
         return 1
+    fi
+
+    # Android 17 replaced the legacy createSpBlob/decryptSpBlob methods with
+    # createSyntheticPasswordBlob/unwrapSyntheticPasswordBlob. The BZI6 flow
+    # stores an AES key through Android Keystore and wraps the blob with that
+    # key. Keep that donor implementation intact for the reviewed M4 profile;
+    # applying the older software-crypto bodies would change its blob format.
+    if [ "${ROM_SOURCE_CONFIG:-}" = "essi_a376b_android17" ]; then
+        IS_A376B_M4_BOOT_TEST && \
+            [ "${EXYNOS9810_M4_RUNTIME_COMPAT:-false}" = "true" ] || {
+            LOGE "Android 17 synthetic-password handling is restricted to the reviewed M4 G965F profile"
+            return 1
+        }
+
+        local REQUIRED_ANCHOR
+        for REQUIRED_ANCHOR in \
+                '.method public final createSyntheticPasswordBlob(JBLcom/android/server/locksettings/SyntheticPasswordManager$SyntheticPassword;[BJI)V' \
+                '.method public final unwrapSyntheticPasswordBlob(JB[BJI)Lcom/android/server/locksettings/SyntheticPasswordManager$SyntheticPassword;' \
+                'Ljavax/crypto/KeyGenerator;->getInstance(Ljava/lang/String;)Ljavax/crypto/KeyGenerator;' \
+                'Ljava/security/KeyStore;->setEntry(Ljava/lang/String;Ljava/security/KeyStore$Entry;Ljava/security/KeyStore$ProtectionParameter;)V' \
+                'Ljava/security/KeyStore;->getKey(Ljava/lang/String;[C)Ljava/security/Key;' \
+                'SyntheticPasswordCrypto;->encrypt([BLjavax/crypto/SecretKey;)[B' \
+                'SyntheticPasswordCrypto;->decrypt([BLjavax/crypto/SecretKey;)[B'; do
+            grep -Fq "$REQUIRED_ANCHOR" "$SMALI" || {
+                LOGE "BZI6 SyntheticPasswordManager is missing reviewed Keystore blob anchor: $REQUIRED_ANCHOR"
+                return 1
+            }
+        done
+        if grep -Eq '^\.method[^\n]* (createSpBlob|decryptSpBlob)\(' "$SMALI"; then
+            LOGE "Unexpected legacy synthetic-password methods in the BZI6 Android 17 class"
+            return 1
+        fi
+
+        LOG "- Keeping BZI6 Android 17 Keystore-backed synthetic-password blob implementation"
+        return 0
     fi
 
     CREATE_BODY="$(cat <<'EOF'

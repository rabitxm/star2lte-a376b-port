+#!/usr/bin/env python3
+"""Avoid a missing BZI6 KG30 provider blocking the S9+ SystemServer startup.
+
+Reason: first-boot ANR evidence traces SystemServer through the KnoxGuard30
+constructor into a worker whose KG30 lookup uses waitForService. The reviewed
+G965F vendor image has no KG30 provider. Switch only that lookup to the
+framework's nonblocking checkService; the existing 0xff02 fail-closed response,
+three-attempt retry policy, binder conversion, death check and lock cleanup stay
+intact.
+
+Files: one exact BZI6 KnoxGuard30VendorController Smali method, pinned to the
+donor services.jar and adjacent lock. The final image verifier decodes the
+compiled services.jar and checks the lookup and fail-closed/retry contracts.
+
+Verify: wrong profile/donor/class hashes fail; apply is idempotent; built JAR
+decodes with checkService and without waitForService; retries remain bounded;
+safeCall still returns the existing error response. Device cold-boot/watchdog
+and later provider-available behavior remain runtime gates.
+
+Rollback: remove this helper call and restore services.jar from the pinned BZI6
+donor, then rebuild. No KnoxGuard state, vendor, radio, kernel or EFS is edited.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+HERE = Path(__file__).resolve().parent
+LOCK = HERE / "a376b_android17_kg30_nonblocking.lock.json"
+CLASS = Path("smali_classes2/com/samsung/android/knoxguard30/service/KnoxGuard30VendorController.smali")
+NATIVE = Path("smali_classes2/com/samsung/android/knoxguard30/service/KnoxGuardNative.smali")
+SERVICE = Path("smali_classes2/com/samsung/android/knoxguard30/service/KnoxGuard30Service.smali")
+UTILS = Path("smali_classes2/com/samsung/android/knoxguard30/service/utils/Utils.smali")
+WAIT = "invoke-static {v0}, Landroid/os/ServiceManager;->waitForService(Ljava/lang/String;)Landroid/os/IBinder;"
+CHECK = "invoke-static {v0}, Landroid/os/ServiceManager;->checkService(Ljava/lang/String;)Landroid/os/IBinder;"
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def source_tree(apktool_dir):
+    return {name: Path(apktool_dir) / rel for name, rel in
+            (("controller", CLASS), ("native", NATIVE), ("service", SERVICE), ("utils", UTILS))}
+
+
+def method(text, name, signature=None):
+    starts = [m.start() for m in re.finditer(r"^\.method[^\n]*$", text, re.M)
+              if (m.group().endswith(signature) if signature else
+                  re.search(re.escape(name) + r"\(", m.group()))]
+    if len(starts) != 1:
+        raise ValueError(f"KG30 expected one {name} method, found {len(starts)}")
+    end = text.find("\n.end method", starts[0])
+    if end < 0:
+        raise ValueError(f"KG30 method has no terminator: {name}")
+    return text[starts[0]:end + len("\n.end method")]
+
+
+def scope():
+    expected = {
+        "ROM_SOURCE_CONFIG": "essi_a376b_android17",
+        "ROM_MILESTONE": "M4",
+        "TARGET_CODENAME": "star2lte",
+        "STAR2LTE_BUILD_MODEL": "SM-G965F",
+        "SOURCE_PLATFORM_SDK_VERSION": "37",
+        "SOURCE_FIRMWARE_CACHE_SUFFIX": "A376BXXU5BZI6",
+        "STAR2LTE_M4_BOOT_LIMITS": "true",
+        "EXYNOS9810_M4_RUNTIME_COMPAT": "true",
+    }
+    for key, value in expected.items():
+        if os.environ.get(key) != value:
+            raise ValueError("M4 KG30 scope mismatch: " + key)
+
+
+def verify_donor(path, lock):
+    path = Path(path)
+    if not path.is_file() or path.is_symlink():
+        raise ValueError("Pinned BZI6 donor services.jar is missing or symlinked")
+    found = sha(path.read_bytes())
+    if found != lock["donor_services_jar_sha256"]:
+        raise ValueError("BZI6 donor services.jar hash mismatch: " + found)
+    return found
+
+
+def read_tree(apktool_dir):
+    paths = source_tree(apktool_dir)
+    for name, path in paths.items():
+        if not path.is_file() or path.is_symlink():
+            raise ValueError("BZI6 KG30 decoded class missing or symlinked: " + name)
+    return paths, {name: path.read_text() for name, path in paths.items()}
+
+
+def verify_semantics(texts, compiled=False):
+    get_service = method(texts["controller"], "getService")
+    if get_service.count(CHECK) != 1 or WAIT in get_service:
+        raise ValueError("KG30 getService must use one nonblocking checkService lookup")
+    safe_call = method(texts["controller"], "safeCall")
+    for marker in ("const v12, 0xff02", "generateFailCloseResponse(I)Ljava/lang/String;",
+                   "monitor-enter v11", "monitor-exit v11"):
+        if marker not in safe_call:
+            raise ValueError("KG30 fail-closed/lock contract missing: " + marker)
+
+    timeout = method(texts["native"], "executeMethodWithTimeOut")
+    if "const-wide/16 v8, 0x61a8" not in timeout or \
+            "ExecutorService;->shutdown()V" not in timeout:
+        raise ValueError("KG30 worker timeout/shutdown contract changed")
+    retry = method(texts["native"], "performTAApiCallWithRetry")
+    for marker in ("const/4 v2, 0x3", "if-ge v3, v2, :cond_1",
+                   "const-wide/16 v1, 0x64", "executeMethodWithTimeOut"):
+        if marker not in retry:
+            raise ValueError("KG30 bounded retry contract changed: " + marker)
+
+    constructor = method(texts["service"], "<init>", "<init>(Landroid/content/Context;)V")
+    if "Utils;->getStateAndSetToKGSystemProperty()" not in constructor:
+        raise ValueError("KG30 constructor no longer uses the reviewed state path")
+    state = method(texts["native"], "getTAStateData",
+                   "getTAStateData(Lcom/samsung/android/knoxguard30/service/KgTaResponse;)I")
+    if "const/4 p0, 0x5" not in state or "return p0" not in state:
+        raise ValueError("KG30 failed TA response no longer maps to its existing fail-closed state")
+    set_state = method(texts["utils"], "getStateAndSetToKGSystemProperty")
+    if 'const-string/jumbo v4, "knox.kg.state"' not in set_state:
+        raise ValueError("KG30 state property update contract changed")
+    return {"lookup": "checkService", "waitForService": False,
+            "fail_close_error": "0xff02", "bounded_attempts": 3,
+            "worker_timeout_ms": 25000, "compiled_dex": compiled}
+
+
+def verify_work(apktool_dir, donor_services_jar):
+    scope()
+    lock = json.loads(LOCK.read_text())
+    donor_hash = verify_donor(donor_services_jar, lock)
+    paths, texts = read_tree(apktool_dir)
+    actual = {name: sha(path.read_bytes()) for name, path in paths.items()}
+    for name, expected in lock["source_classes"].items():
+        if name != "controller" and actual[name] != expected:
+            raise ValueError("Unexpected BZI6 KG30 support class: " + name)
+    if actual["controller"] != lock["output_controller_sha256"]:
+        raise ValueError("M4 KG30 patched controller hash mismatch")
+    contract = verify_semantics(texts)
+    return {"result": "PASS", "donor_services_jar_sha256": donor_hash,
+            "controller_sha256": actual["controller"], "contract": contract}
+
+
+def apply_work(apktool_dir, donor_services_jar):
+    scope()
+    lock = json.loads(LOCK.read_text())
+    donor_hash = verify_donor(donor_services_jar, lock)
+    paths, texts = read_tree(apktool_dir)
+    actual = {name: sha(path.read_bytes()) for name, path in paths.items()}
+    for name, expected in lock["source_classes"].items():
+        if actual[name] != expected:
+            if name == "controller" and actual[name] == lock["output_controller_sha256"]:
+                return verify_work(apktool_dir, donor_services_jar)
+            raise ValueError("Unexpected BZI6 KG30 preimage: " + name)
+    get_service = method(texts["controller"], "getService")
+    if get_service.count(WAIT) != 1 or CHECK in get_service:
+        raise ValueError("KG30 waitForService preimage does not match the reviewed donor")
+    updated = get_service.replace(WAIT, CHECK, 1)
+    texts["controller"] = texts["controller"].replace(get_service, updated, 1)
+    paths["controller"].write_text(texts["controller"])
+    result = verify_work(apktool_dir, donor_services_jar)
+    print(json.dumps(result, sort_keys=True))
+
+
+def verify_apk(apk, donor_services_jar, apktool, temp_root):
+    scope()
+    lock = json.loads(LOCK.read_text())
+    verify_donor(donor_services_jar, lock)
+    apk = Path(apk)
+    apktool = Path(apktool)
+    if not apk.is_file() or apk.is_symlink() or not apktool.is_file() or apktool.is_symlink():
+        raise ValueError("M4 services.jar or pinned Apktool is missing or symlinked")
+    temp_root = Path(temp_root)
+    temp_root.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix="m4-kg30-compiled-", dir=temp_root) as td:
+        decoded = Path(td) / "decoded"
+        subprocess.run([str(apktool), "d", "--no-res", "--no-debug-info", "--force",
+                        "-o", str(decoded), str(apk)], check=True, capture_output=True, text=True)
+        paths, texts = read_tree(decoded)
+        contract = verify_semantics(texts, compiled=True)
+        controller_hash = sha(paths["controller"].read_bytes())
+        expected_roundtrip = lock.get("compiled_controller_sha256")
+        if expected_roundtrip and controller_hash != expected_roundtrip:
+            raise ValueError("Compiled M4 KG30 controller roundtrip hash mismatch: " + controller_hash)
+    result = {"result": "PASS", "services_jar_sha256": sha(apk.read_bytes()),
+              "compiled_controller_sha256": controller_hash, "contract": contract}
+    print(json.dumps(result, sort_keys=True))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    sub = parser.add_subparsers(dest="command", required=True)
+    for name in ("apply-work", "verify-work"):
+        cmd = sub.add_parser(name)
+        cmd.add_argument("--apktool-dir", type=Path, required=True)
+        cmd.add_argument("--donor-services-jar", type=Path, required=True)
+    compiled = sub.add_parser("verify-apk")
+    compiled.add_argument("--apk", type=Path, required=True)
+    compiled.add_argument("--donor-services-jar", type=Path, required=True)
+    compiled.add_argument("--apktool", type=Path, required=True)
+    compiled.add_argument("--temp-root", type=Path, required=True)
+    args = parser.parse_args()
+    if args.command == "apply-work":
+        apply_work(args.apktool_dir, args.donor_services_jar)
+    elif args.command == "verify-work":
+        print(json.dumps(verify_work(args.apktool_dir, args.donor_services_jar), sort_keys=True))
+    else:
+        verify_apk(args.apk, args.donor_services_jar, args.apktool, args.temp_root)
+
+
+if __name__ == "__main__":
+    main()

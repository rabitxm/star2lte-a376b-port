     --work-dir "$WORK_DIR" --apktool-dir "$APKTOOL_DIR" || return 1
 
+# BZI6 has no KG30 provider on the S9+ vendor stack. Keep Knox Guard's
+# fail-closed response, but do not block SystemServer waiting for a service
+# that this device cannot provide. The helper pins the donor jar and exact
+# controller class and is limited to the reviewed M4 G965F runtime profile.
+if [ "${ROM_SOURCE_CONFIG:-}" = "essi_a376b_android17" ]; then
+    IS_A376B_M4_BOOT_TEST && \
+            [ "${EXYNOS9810_M4_RUNTIME_COMPAT:-false}" = "true" ] || {
+        LOGE "BZI6 KG30 nonblocking bridge is restricted to reviewed M4 G965F profile"
+        return 1
+    }
+    python3 "$SRC_DIR/unica/patches/exynos9810_device_stack/exynos9810_finalization/a376b_android17_kg30_nonblocking.py" \
+        apply-work \
+        --apktool-dir "$APKTOOL_DIR/system/framework/services.jar" \
+        --donor-services-jar "$FW_DIR/$EXYNOS9810_SOURCE_CACHE_KEY/system/system/framework/services.jar" || return 1
+    python3 "$SRC_DIR/unica/patches/exynos9810_device_stack/exynos9810_finalization/a376b_android17_kg30_nonblocking.py" \
+        verify-work \
+        --apktool-dir "$APKTOOL_DIR/system/framework/services.jar" \
+        --donor-services-jar "$FW_DIR/$EXYNOS9810_SOURCE_CACHE_KEY/system/system/framework/services.jar" || return 1
+fi
+

+#!/usr/bin/env python3
+"""A376B M2 native32 adapter, invoked by the existing vendor-restore module.
+
+Uses the fork's ext4/AVB/signapk tools, preserving A37 files and adding only
+pinned S22 native32 files. No app_process32/ART32 and no kernel changes.
+APEX signing/4KiB procedure follows the existing AOSP apex_utils.py and apexer.
+"""
+from pathlib import Path
+import argparse, hashlib, json, os, re, shutil, subprocess, tempfile, zipfile
+LOCK_PATH=Path(__file__).with_name('a376b_native32.lock.json')
+def digest(path): return hashlib.sha256(path.read_bytes()).hexdigest()
+def locked(): return json.loads(LOCK_PATH.read_text())
+def run(args,allowed=(0,)):
+ x=subprocess.run([str(a) for a in args],capture_output=True,text=True)
+ if x.returncode not in allowed:raise RuntimeError(str(args[0])+': '+x.stdout+'\n'+x.stderr)
+ return x.stdout
+
+def build(a37_apex, s22_apex, scratch, tools, keys):
+    A=scratch; O=A/'hybrid'; O.mkdir(); T=tools; K=keys
+    for tag,apex in [('a37',a37_apex),('s22',s22_apex)]:
+        directory=A/tag; directory.mkdir(); image=directory/'payload.img'
+        with zipfile.ZipFile(apex) as z: image.write_bytes(z.read('apex_payload.img'))
+        root=directory/'root'; root.mkdir()
+        run(['debugfs','-R',f'rdump / "{root}"',image])
+        if not (root/'bin/linker64').is_file(): raise RuntimeError('Failed runtime extraction: '+tag)
+    image=O/'payload.img'
+    source=A/'s22/root';source_image=A/'s22/payload.img'
+    add=['lib','lib/bionic','bin/linker','bin/crash_dump32','bin/linker_asan']+[str(p.relative_to(source)) for p in sorted((source/'lib').rglob('*')) if not p.is_dir()]
+    merged=O/'merged-root'
+    if merged.exists():shutil.rmtree(merged)
+    shutil.copytree(A/'a37/root',merged,symlinks=True)
+    for rel in add:
+     p=source/rel;q=merged/rel
+     assert not q.exists() and not q.is_symlink(),rel
+     if p.is_dir():q.mkdir(exist_ok=True)
+     else:shutil.copy2(p,q,follow_symlinks=False)
+    config=[];contexts=[]
+    for i,p in enumerate([merged]+sorted(merged.rglob('*'))):
+     rel=str(p.relative_to(merged));rel='' if rel=='.' else rel
+     srcimage=source_image if rel in add else A/'a37/payload.img'
+     st=run(['debugfs','-R','stat /'+rel,srcimage]);mode=re.search(r'Mode:\s+0*(\d+)',st).group(1);uid,gid=re.search(r'User:\s+(\d+)\s+Group:\s+(\d+)',st).groups()
+     config.append(f'{rel or "/"} {uid} {gid} 0{mode}')
+     label=O/f'metadata-label{i}'
+     run(['debugfs','-R',f'ea_get -f "{label}" /{rel} security.selinux',srcimage])
+     assert label.exists() and label.stat().st_size,rel
+     context=label.read_bytes().rstrip(b'\0').decode();contexts.append(re.escape('/'+rel)+' '+context)
+    fsconfig=O/'fs_config.txt';fsconfig.write_text('\n'.join(config)+'\n');fc=O/'file_contexts';fc.write_text('\n'.join(contexts)+'\n')
+    if image.exists():image.unlink()
+    os.environ['MKE2FS_CONFIG']=str(T/'mke2fs.conf');os.environ['E2FSPROGS_FAKE_TIME']='1'
+    uuid='7d1522e1-9dfa-5edb-a43e-98e3a4d20250'
+    run([T/'mke2fs','-O','^has_journal','-b','4096','-m','0','-t','ext4','-I','256','-N','256','-U',uuid,'-E','hash_seed='+uuid,image,'32M'])
+    run([T/'e2fsdroid','-e','-f',merged,'-T','0','-S',fc,'-C',fsconfig,'-a','/',image])
+    run(['debugfs','-w','-R','set_inode_field /lost+found uid 0',image])
+    run(['debugfs','-w','-R','set_inode_field /lost+found gid 0',image])
+    for field in ['atime','mtime','ctime','crtime']:
+        run(['debugfs','-w','-R',f'set_inode_field /lost+found {field} 0',image])
+    run(['e2fsck','-fn',image])
+    # Compare every original payload file/symlink with the untouched A37 extraction.
+    verify=O/'verified-root'
+    if verify.exists():shutil.rmtree(verify)
+    verify.mkdir()
+    run(['debugfs','-R',f'rdump / "{verify}"',image])
+    for p in (A/'a37/root').rglob('*'):
+     if p.is_dir():continue
+     q=verify/p.relative_to(A/'a37/root')
+     if p.is_symlink():assert q.is_symlink() and os.readlink(p)==os.readlink(q),str(p)
+     else:assert p.read_bytes()==q.read_bytes(),str(p)
+    for rel in add:
+     p=source/rel;q=verify/rel
+     if p.is_dir():assert q.is_dir()
+     elif p.is_symlink():assert os.readlink(p)==os.readlink(q)
+     else:assert p.read_bytes()==q.read_bytes(),rel
+    salt=hashlib.sha256((A/'a37/payload.img').read_bytes()+(A/'s22/payload.img').read_bytes()).hexdigest()
+    run([T/'avbtool','add_hashtree_footer','--do_not_generate_fec','--algorithm','SHA256_RSA4096','--key',K/'payload.pem','--prop','apex.key:com.android.runtime','--image',image,'--salt',salt,'--hash_algorithm','sha256'])
+    run([T/'avbtool','verify_image','--image',image,'--key',K/'payload.pem'])
+    original=a37_apex;unsigned=O/'unsigned.apex';signed=O/'com.android.runtime.apex'
+    with zipfile.ZipFile(original) as src,zipfile.ZipFile(unsigned,'w',compression=zipfile.ZIP_STORED) as out:
+     for entry in src.infolist():
+      if entry.filename.startswith('META-INF/') or entry.filename in ['apex_payload.img','apex_pubkey']:continue
+      out.writestr(entry,src.read(entry))
+     out.write(image,'apex_payload.img',compress_type=zipfile.ZIP_STORED);out.write(K/'apex_pubkey','apex_pubkey',compress_type=zipfile.ZIP_STORED)
+    run([T/'signapk','-a','4096','--align-file-size','--min-sdk-version','36',K/'container.x509.pem',K/'container.pk8',unsigned,signed])
+    with zipfile.ZipFile(signed) as z:
+     info=z.getinfo('apex_payload.img')
+     with signed.open('rb') as f:
+      f.seek(info.header_offset+26);import struct;nlen,elen=struct.unpack('<HH',f.read(4))
+     offset=info.header_offset+30+nlen+elen;assert offset%4096==0;assert info.compress_type==0
+    java=O/'VerifyApex.java';java.write_text('''import java.io.File; import com.android.apksig.ApkVerifier; public class VerifyApex { public static void main(String[] args) throws Exception { var r=new ApkVerifier.Builder(new File(args[0])).build().verify(); System.out.println("verified="+r.isVerified()+" v2="+r.isVerifiedUsingV2Scheme()+" v3="+r.isVerifiedUsingV3Scheme()+" errors="+r.getErrors()); if (!r.isVerified() || !r.isVerifiedUsingV3Scheme()) System.exit(1); }}''')
+    verification=run(['java','--class-path',T/'signapk.jar',java,signed])
+    report={'status':'PASS','output':signed.name,'sha256':hashlib.sha256(signed.read_bytes()).hexdigest(),'a37_original_payload_files_unchanged':True,'added_s22_paths':add,'payload_avb_verified':True,'container_verification':verification.strip(),'payload_zip_offset':offset,'payload_zip_alignment':4096}
+    (O/'report.json').write_text(json.dumps(report,indent=2)+'\n');return signed, report
+
+def verify(work):
+    lock=locked(); system=work/'system/system'
+    if digest(system/'apex/com.android.runtime.apex') != lock['output_apex_sha256']:
+        raise RuntimeError('Missing/unreviewed A37 native32 runtime APEX')
+    for name,expected in lock['system32'].items():
+        if digest(system/'lib'/name)!=expected:
+            raise RuntimeError('Native32 platform library mismatch: '+name)
+    for name,expected in lock['retained_radio_system32'].items():
+        if digest(system/'lib'/name)!=expected:raise RuntimeError('Retained fork radio wrapper mismatch: '+name)
+    def props(path):
+        return dict(line.split('=',1) for line in path.read_text().splitlines() if '=' in line and not line.startswith('#'))
+    s=props(system/'build.prop');v=props(work/'vendor/build.prop')
+    if v.get('ro.zygote')!='zygote64':raise RuntimeError('A37 app ABI requires zygote64')
+    if any(s.get(key)!=value for key,value in {'ro.product.cpu.abilist':'arm64-v8a','ro.product.cpu.abilist32':'','ro.product.cpu.abilist64':'arm64-v8a'}.items()):
+        raise RuntimeError('A37 global app ABI properties are inconsistent')
+    if (system/'bin/app_process32').exists() or not (system/'bin/app_process64').is_file():
+        raise RuntimeError('A37 app_process ABI changed')
+    if not (system/'etc/init/hw/init.zygote64.rc').is_file():raise RuntimeError('Missing zygote64 init entry')
+    linker=system/'bin/linker'
+    if not linker.is_symlink() or os.readlink(linker)!='/apex/com.android.runtime/bin/linker':
+        raise RuntimeError('Unexpected native32 linker entry')
+    print('PASS A37 app64/native-vendor32 ABI payload and zygote policy')
+
+def apply(work, compat, tools, cache, keys):
+    lock=locked(); apex=work/'system/system/apex/com.android.runtime.apex';s22=compat/'apex/com.android.runtime.apex'
+    if digest(apex) not in (lock['a37_apex_sha256'],lock['output_apex_sha256']):raise RuntimeError('Unreviewed A37 runtime input')
+    if digest(s22)!=lock['s22_apex_sha256']:raise RuntimeError('Unreviewed S22 runtime input')
+    for name,expected in lock['system32'].items():
+        source=compat/'lib'/name;dest=work/'system/system/lib'/name
+        if digest(source)!=expected:raise RuntimeError('Unreviewed S22 native32 input: '+name)
+        if dest.exists() and digest(dest)!=expected:
+            raise RuntimeError('Existing system32 library differs from reviewed input: '+name)
+    for name,expected in lock['retained_radio_system32'].items():
+        if digest(work/'system/system/lib'/name)!=expected:raise RuntimeError('Retained fork radio wrapper mismatch: '+name)
+    if digest(keys/'apex_pubkey')!=lock['payload_public_key_sha256'] or digest(keys/'container.x509.pem')!=lock['container_certificate_sha256']:
+        raise RuntimeError('Native32 APEX signing identity mismatch')
+    cache.mkdir(parents=True,exist_ok=True);cached=cache/(lock['output_apex_sha256']+'.apex')
+    if not cached.exists():
+        if digest(apex)!=lock['a37_apex_sha256']:raise RuntimeError('Cannot rebuild native32 cache from an already modified APEX')
+        with tempfile.TemporaryDirectory(prefix='native32-',dir=cache) as td:
+            candidate,report=build(apex,s22,Path(td),tools,keys)
+            if digest(candidate)!=lock['output_apex_sha256']:
+                shutil.copyfile(candidate,cache/'debug-candidate.apex')
+                raise RuntimeError('Native32 APEX reproducibility/hash gate failed')
+            # Exclusive publication; an existing immutable cache must match.
+            try:os.link(candidate,cached)
+            except FileExistsError:
+                if digest(cached)!=lock['output_apex_sha256']:raise
+    if digest(cached)!=lock['output_apex_sha256']:raise RuntimeError('Corrupt native32 APEX cache')
+    # All checks/builds complete before staging any file. A clean build remains required.
+    for name in lock['system32']:
+        dest=work/'system/system/lib'/name;dest.parent.mkdir(parents=True,exist_ok=True)
+        tmp=dest.with_name(dest.name+'.native32-tmp');shutil.copyfile(compat/'lib'/name,tmp);os.chmod(tmp,0o644);os.replace(tmp,dest)
+    tmp=apex.with_name(apex.name+'.native32-tmp');shutil.copyfile(cached,tmp);os.chmod(tmp,0o644);os.replace(tmp,apex)
+    print('PASS prepared pinned A37 runtime64 plus S22 native32 and '+str(len(lock['system32']))+' native platform libraries')
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('mode',choices=['apply','verify'])
+    parser.add_argument('--work-dir',type=Path,required=True)
+    for name in ['compat-root','tools-dir','cache-dir','keys-dir']:parser.add_argument('--'+name,type=Path)
+    args=parser.parse_args()
+    if args.mode=='verify':verify(args.work_dir)
+    else:
+        if not all([args.compat_root,args.tools_dir,args.cache_dir,args.keys_dir]):parser.error('apply requires all input directories')
+        apply(args.work_dir,args.compat_root,args.tools_dir,args.cache_dir,args.keys_dir)

 def verify(work: Path, target: str) -> None:
     if target not in ("starlte","star2lte","crownlte"): raise RuntimeError("Unsupported target")
     system=work/"system/system"
+    if os.environ.get("ROM_SOURCE_CONFIG") == "essi_a376b_android16":
+        if (target, os.environ.get("ROM_MILESTONE")) != ("star2lte", "M2"):
+            raise RuntimeError("Unreviewed native32 A376B release profile")
+        import importlib.util
+        adapter=ROOT/"unica/patches/exynos9810_device_stack/exynos9810_boot_restore/a376b_native32.py"
+        spec=importlib.util.spec_from_file_location("a376b_native32",adapter)

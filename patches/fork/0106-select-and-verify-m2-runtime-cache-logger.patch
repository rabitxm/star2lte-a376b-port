From: Codex M2 diagnostic integration
Subject: [PATCH] Select and verify retained CACHE init logger with M2 runtime profile

Reason: attempt54 booted but omitted the init-debug opt-in; a config/cache
cannot prove or select logger presence without recording this variable.
Files: existing profile, config serialization/regeneration, build-cache key, real-ext4
verifier, and a parallel G965F runtime-init-debug profile.
Verification: profile isolation/reset, repeated buildenv config regeneration,
cache-key divergence, full patch replay,
real-ext4 logger bytes/mode/UID/GID/SELinux labels, clean build and G965F boot.
Only new runtime behavior is the existing patch0095 logger. No kernel, BPF,
seapp/RIL/blob or production-kernel replacement. Roll back this profile selection
to runtime-diagnostic; retain packages and diagnostic evidence.

diff --git a/buildenv.sh b/buildenv.sh
--- a/buildenv.sh
+++ b/buildenv.sh
@@ -186,7 +186,9 @@
 exec {CONFIG_LOCK_FD}>"$CONFIG_LOCK_FILE"
 flock "$CONFIG_LOCK_FD"
 # shellcheck disable=SC2046
-[ -f "$OUT_DIR/config.sh" ] && unset $(sed "/Automatically/d" "$OUT_DIR/config.sh" | cut -d "=" -f 1)
+# Preserve explicit profile logger opt-ins when regenerating an existing config.
+# Production profiles reset both flags, so a previous diagnostic cannot leak.
+[ -f "$OUT_DIR/config.sh" ] && unset $(sed "/Automatically/d; /^EXYNOS9810_ENABLE_INIT_DEBUG=/d; /^EXYNOS9810_ENABLE_SYSTEM_BOOT_DEBUG=/d" "$OUT_DIR/config.sh" | cut -d "=" -f 1)
 if ! "$SRC_DIR/scripts/internal/gen_config_file.sh" "$SELECTED_TARGET"; then
     flock -u "$CONFIG_LOCK_FD"
     exec {CONFIG_LOCK_FD}>&-
diff --git a/scripts/make_rom.sh b/scripts/make_rom.sh
--- a/scripts/make_rom.sh
+++ b/scripts/make_rom.sh
@@ -52,7 +52,9 @@
         "$(cat "$FW_DIR/$SOURCE_FIRMWARE_PATH/.extracted" 2>/dev/null)" \
         "runtime=${EXYNOS9810_M2_RUNTIME_COMPAT:-false}" \
         "kernel=${EXYNOS9810_EXPECTED_KERNEL_SHA256:-default}" \
-        "metadata=${EXYNOS9810_ENABLE_METADATA_BIND:-false}" | sha256sum | cut -d ' ' -f 1)"
+        "metadata=${EXYNOS9810_ENABLE_METADATA_BIND:-false}" \
+        "init_debug=${EXYNOS9810_ENABLE_INIT_DEBUG:-false}" \
+        "system_boot_debug=${EXYNOS9810_ENABLE_SYSTEM_BOOT_DEBUG:-false}" | sha256sum | cut -d ' ' -f 1)"
 
     SOURCE_HASH="$(find "$SRC_DIR/platform/$TARGET_PLATFORM" "$SRC_DIR/unica" "$SRC_DIR/target/$TARGET_CODENAME" \
         -type d -name __pycache__ -prune -o -type f -print0 | \
diff --git a/scripts/internal/gen_config_file.sh b/scripts/internal/gen_config_file.sh
--- a/scripts/internal/gen_config_file.sh
+++ b/scripts/internal/gen_config_file.sh
@@ -467,6 +467,8 @@
     GET_BUILD_VAR "TARGET_PLATFORM" "none"
     GET_BUILD_VAR "TARGET_SIM_VARIANT"
     GET_BUILD_VAR "EXYNOS9810_ENABLE_KERNELSU_RUNTIME" "true"
+    GET_BUILD_VAR "EXYNOS9810_ENABLE_INIT_DEBUG" "false"
+    GET_BUILD_VAR "EXYNOS9810_ENABLE_SYSTEM_BOOT_DEBUG" "false"
     if [ "${#TARGET_ASSERT_MODEL[@]}" -ge 1 ]; then
         echo "TARGET_ASSERT_MODEL=\"$(IFS=":"; printf '%s' "${TARGET_ASSERT_MODEL[*]}")\""
     else
diff --git a/scripts/internal/verify_m2_runtime_image.py b/scripts/internal/verify_m2_runtime_image.py
--- a/scripts/internal/verify_m2_runtime_image.py
+++ b/scripts/internal/verify_m2_runtime_image.py
@@ -25,6 +25,16 @@
        ('etc/init/hw/init.samsungexynos9810.rc',0o644,None),
        ('etc/init/init.samsungexynos9810.rc',0o644,None),
        *[('etc/aconfig/'+n,0o444,'vendor_aconfig_storage_file') for n in ['package.map','flag.map','flag.val','flag.info']]]}
+    if os.environ.get('EXYNOS9810_ENABLE_INIT_DEBUG','false')=='true' and partition=='vendor':
+        entries['vendor'].extend([
+          ('etc/init/init.debug.rc',0o644,'vendor_configs_file'),
+          ('bin/init_debug_log.sh',0o755,'vendor_file')])
+        rc=(work/'vendor/etc/init/init.debug.rc').read_text()
+        logger=(work/'vendor/bin/init_debug_log.sh').read_text()
+        for marker in ('on post-fs\n', 'write /cache/unica/init_debug_post_fs.txt',
+                       'service unica9810_init_debug /vendor/bin/init_debug_log.sh'):
+            if marker not in rc:raise ValueError('Missing CACHE init logger trigger/service: '+marker)
+        if 'OUT=/cache/unica' not in logger:raise ValueError('CACHE logger output changed')
     def cmd(text):
         r=subprocess.run(['debugfs','-R',text,str(image)],capture_output=True,text=True,check=True)
         return r.stdout+r.stderr
@@ -39,7 +49,7 @@
             if mode is not None:
                 m=re.search(r'Type:\s+regular\s+Mode:\s+(\d+)',stat)
                 if not m or int(m[1],8)!=mode:raise ValueError('Image mode mismatch: '+rel+' '+stat)
-                owner=(0,2000) if partition=='system' and rel=='system/bin/cameraserver' else (0,0)
+                owner=(0,2000) if (partition,rel) in {('system','system/bin/cameraserver'),('vendor','bin/init_debug_log.sh')} else (0,0)
                 found=re.search(r'User:\s+(\d+)\s+Group:\s+(\d+)',stat)
                 if not found or tuple(map(int,found.groups()))!=owner:
                     raise ValueError('Image owner mismatch: '+rel+' expected='+str(owner))
diff --git a/target/star2lte/profiles/m1-g965f-no-ksu.sh b/target/star2lte/profiles/m1-g965f-no-ksu.sh
--- a/target/star2lte/profiles/m1-g965f-no-ksu.sh
+++ b/target/star2lte/profiles/m1-g965f-no-ksu.sh
@@ -41,3 +41,7 @@
 unset _STAR2LTE_M1_ROOT _STAR2LTE_M1_HASH
 export EXYNOS9810_ENABLE_METADATA_BIND="false"
 export EXYNOS9810_M2_RUNTIME_COMPAT="false"
+
+# Reset opt-in diagnostics when selecting another profile in the same shell.
+export EXYNOS9810_ENABLE_INIT_DEBUG="false"
+export EXYNOS9810_ENABLE_SYSTEM_BOOT_DEBUG="false"
diff --git a/target/star2lte/profiles/m2-g965f-a376b-android16-runtime-init-debug.sh b/target/star2lte/profiles/m2-g965f-a376b-android16-runtime-init-debug.sh
--- /dev/null
+++ b/target/star2lte/profiles/m2-g965f-a376b-android16-runtime-init-debug.sh
@@ -0,0 +1,5 @@
+# Attempt55: attempt54 runtime inputs plus only the retained CACHE init logger.
+# Reason/files/verification: docs/m2-integrated-runtime-build.md in parent project.
+# Require real-ext4 bytes, owner/mode/label checks before any device installation.
+source "$(dirname -- "${BASH_SOURCE[0]}")/m2-g965f-a376b-android16-runtime-diagnostic.sh" || return 1
+export EXYNOS9810_ENABLE_INIT_DEBUG="true"

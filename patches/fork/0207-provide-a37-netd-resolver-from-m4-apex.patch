+    b=data[i];i+=1;length|=(b&0x7f)<<shift
+    if not b&0x80:break
+    shift+=7
+   value=data[i:i+length];i+=length
+   if number==field_number:found.append(value.decode())
+  elif wire==0:
+   while data[i]&0x80:i+=1
+   i+=1
+  elif wire==1:i+=8
+  elif wire==5:i+=4
+  else:raise ValueError('Unsupported APEX manifest protobuf wire type')
+  assert i>start
+ return found
+
+def encode_varint(value):
+ out=bytearray()
+ while value>0x7f:out.append((value&0x7f)|0x80);value>>=7
+ out.append(value);return bytes(out)

+#!/usr/bin/env python3
+"""Port fork PIF call sites to reviewed BZI6 methods; keep upstream hook classes."""
+from pathlib import Path
+from hashlib import sha256
+import importlib.util
+import re
+import sys
+
+HERE = Path(__file__).resolve().parent
+SPEC = importlib.util.spec_from_file_location("bzi6_product", HERE.parent.parent / "patches/product_feature/a376b_android17_product.py")
+PRODUCT = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(PRODUCT)
+KEYSTORE = "android/security/keystore2/AndroidKeyStoreSpi"
+ATMS = "com/android/server/wm/ActivityTaskManagerService"
+PIF = "io/mesalabs/unica/PlayIntegrityHooks"
+CERT = "engineGetCertificateChain(Ljava/lang/String;)[Ljava/security/cert/Certificate;"
+TASKS = {
+    "getFocusedRootTaskInfo()Landroid/app/ActivityTaskManager$RootTaskInfo;": "708af2e0f3829e272a1b1d55d4cc5ebfe01b7fbdce0bf63d3115c99aad5115ab",
+    "registerTaskStackListener(Landroid/app/ITaskStackListener;)V": "00fa51f9c1de9f4d56b4991af9f9d51a9107092a116e390963c13a773dd7ba8b",
+}
+
+def exact(root, descriptor):
+    paths = list(root.glob("smali*/" + descriptor + ".smali"))
+    if len(paths) != 1:
+        raise RuntimeError("Expected one BZI6 class: " + descriptor)
+    return paths[0]
+
+def rewrite(text, signature, digest, transform):
+    match = PRODUCT.method(text, signature)
+    if sha256(match.group().encode()).hexdigest() != digest:
+        raise RuntimeError("Unreviewed BZI6 PIF method preimage: " + signature)
+    body = transform(match.group())
+    return text[:match.start()] + body + text[match.end():]
+
+def stage(apktool):
+    PRODUCT.scope()
+    framework = apktool / "system/framework/framework.jar"
+    services = apktool / "system/framework/services.jar"
+    key = exact(framework, KEYSTORE)
+    task = exact(services, ATMS)
+    key_text = rewrite(key.read_text(), CERT,
+        "60d02668fe3d93762bcf04575d59b75129673eef3b94e095bd949dc431577285",
+        lambda body: body.replace("    .locals 4\n", "    .locals 4\n\n    invoke-static {}, L" + PIF + ";->onEngineGetCertificateChain()V\n", 1))
+    task_text = task.read_text()
+    for signature, digest in TASKS.items():
+        def inject(body):
+            marker = "    const-string/jumbo v0, \"" + signature.split("(")[0] + "()\""
+            enforce = "    invoke-static {v0}, L" + ATMS + ";->enforceTaskPermission(Ljava/lang/String;)V"
+            if body.count(marker) != 1 or body.count(enforce) != 1 or ":unica_pif_permission_ok" in body:
+                raise RuntimeError("BZI6 task permission shape differs")
+            pre = "    iget-object v0, p0, L" + ATMS + ";->mContext:Landroid/content/Context;\n\n" + \
+                "    invoke-static {v0}, L" + PIF + ";->shouldBypassTaskPermission(Landroid/content/Context;)Z\n\n" + \
+                "    move-result v0\n\n    if-nez v0, :unica_pif_permission_ok\n\n"
+            return body.replace(marker, pre + marker, 1).replace(enforce, enforce + "\n\n    :unica_pif_permission_ok", 1)
+        task_text = rewrite(task_text, signature, digest, inject)
+    # Only copy upstream added helper files; AndroidKeyStoreSpi is patched above
+    # in its actual BZI6 DEX location. Validate all outputs before writing any.
+    upstream = (HERE / "framework.jar/0001-Introduce-PlayIntegrityHooks.patch").read_text()
+    outputs = [(key, key_text), (task, task_text)]
+    for suffix in ("", "$1", "$$ExternalSyntheticLambda0"):
+        rel = "smali_classes6/" + PIF + suffix + ".smali"
+        chunk = upstream.split("diff --git a/" + rel + " b/" + rel + "\n", 1)[1].split("diff --git ", 1)[0]
+        text = "\n".join(line[1:] for line in chunk.splitlines() if line.startswith("+") and not line.startswith("+++")) + "\n"
+        path = framework / rel
+        if path.exists() or not text.startswith(".class "):
+            raise RuntimeError("Stale/malformed BZI6 PIF helper: " + rel)
+        outputs.append((path, text))
+    for path, text in outputs:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(text)
+    print("PASS BZI6 PIF: moved keystore DEX, two preserved donor task flows, three upstream helpers")
+
+def verify(work, tools):
+    PRODUCT.scope()
+    framework = work / "system/system/framework/framework.jar"
+    services = work / "system/system/framework/services.jar"
+    key = PRODUCT.method(PRODUCT.compiled_class(framework, KEYSTORE, tools), CERT).group()
+    if key.count("L" + PIF + ";->onEngineGetCertificateChain()V") != 1:
+        raise RuntimeError("Compiled BZI6 keystore PIF hook missing/duplicated")
+    task = PRODUCT.compiled_class(services, ATMS, tools)
+    for signature in TASKS:
+        body = PRODUCT.method(task, signature).group()
+        if body.count("L" + PIF + ";->shouldBypassTaskPermission(Landroid/content/Context;)Z") != 1 or \
+                body.count("->enforceTaskPermission(Ljava/lang/String;)V") != 1:
+            raise RuntimeError("Compiled BZI6 task PIF hook/permission fallback mismatch")
+    instr = PRODUCT.compiled_class(framework, "android/app/Instrumentation", tools)
+    for sig in ("newApplication(Ljava/lang/Class;Landroid/content/Context;)Landroid/app/Application;",
+                "newApplication(Ljava/lang/ClassLoader;Ljava/lang/String;Landroid/content/Context;)Landroid/app/Application;"):
+        body = PRODUCT.method(instr, sig).group()
+        if body.count("L" + PIF + ";->setProps(Landroid/content/Context;)V") != 1:
+            raise RuntimeError("Compiled BZI6 application PIF hook missing/duplicated")
+    hook = PRODUCT.compiled_class(framework, PIF, tools)
+    for suffix in ("$1", "$$ExternalSyntheticLambda0"):
+        PRODUCT.compiled_class(framework, PIF + suffix, tools)
+    enabled = PRODUCT.method(hook, "isPIFEnabled()Z").group()
+    if '"persist.sys.unica.pif"' not in enabled or "->getBoolean(" not in enabled:
+        raise RuntimeError("Compiled BZI6 PIF does not honor Settings toggle")
+    blocked = PRODUCT.method(hook, "shouldBlockKeyAttestation()Z").group()
+    if "const/4 v0, 0x1" not in blocked or "return v0" not in blocked:
+        raise RuntimeError("BZI6 no-keybox PIF attestation fallback differs")
+    print("PASS compiled BZI6 PIF: application/keystore/task hooks, helpers and live property toggle")
+
+if __name__ == "__main__":
+    if len(sys.argv) == 3 and sys.argv[1] == "stage":
+        stage(Path(sys.argv[2]))
+    elif len(sys.argv) == 4 and sys.argv[1] == "verify":
+        verify(Path(sys.argv[2]), Path(sys.argv[3]))
+    else:
+        raise SystemExit("usage: a376b_android17_pif.py stage APKTOOL | verify WORK TOOLS")

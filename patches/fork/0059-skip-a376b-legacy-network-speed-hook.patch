From: Codex local A376B compatibility adaptation
Subject: [PATCH] Keep donor network speed Settings behavior on AZH4

Reason: attempt27.txt:1237-1241 reports three missing SecSettings classes
for the fork's real-time network speed patch. Retain AZH4's donor behavior for
this optional CSC feature in M2 and keep the old patch for other donors.
Files: scripts/internal/apply_modules.sh.
Verification: exact donor/module dispatch guard, shell syntax and patch replay;
clean M2 build follows. Revert0059.

---
--- a/scripts/internal/apply_modules.sh
+++ b/scripts/internal/apply_modules.sh
@@ -115,6 +115,11 @@ APPLY_SMALI_PATCHES()
             LOGW "A376B AZH4 has no legacy FOTA suggestion activity; skipping only the UN1CA Updates suggestion shortcut"
             continue
         fi
+        if [ "${ROM_SOURCE_CONFIG:-}" = "essi_a376b_android16" ] && \
+                [[ "$p" == */csc/smali/system/priv-app/SecSettings/SecSettings.apk/0001-Enable-real-time-network-speed-in-status-bar.patch ]]; then
+            LOGW "A376B AZH4 relocated the network-speed Settings classes; retaining donor behavior for M2"
+            continue
+        fi
         APPLY_PATCH "$PARTITION" "$FILE" "$p"

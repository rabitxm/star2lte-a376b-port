@@ -0,0 +1,142 @@
+#!/usr/bin/env python3
+"""Extend BZI6's split/mutable lights API for the pinned legacy SehLights HAL."""
+from hashlib import sha256
+from pathlib import Path
+import os
+import re
+import subprocess
+import sys
+import tempfile
+
+
+LIGHT = "Lcom/android/server/lights/LightsService$LightImpl;"
+PROXY = "Lvendor/samsung/hardware/light/ISehLights$Stub$Proxy;"
+EXT = "mLegacyExtendedBrightness:I"
+FILES = {
+    "smali/com/android/server/display/LocalDisplayAdapter$BacklightAdapter.smali":
+        "a673e484f7471dc6529d0e3e0ae518086692c021336bfa2ed35e5c31b3b90c88",
+    "smali/com/android/server/lights/LightsService$LightImpl.smali":
+        "138130e1d78cc59bda8e32c36d2838ea112022263175203702187c7b9df5e4dd",
+    "smali_classes2/vendor/samsung/hardware/light/ISehLights$Stub$Proxy.smali":
+        "d58686d0991004576adc28df56ac45d0f5f848a81537321fcb53bd12c1b3cbef",
+    "smali_classes2/com/android/server/power/PowerManagerUtil.smali":
+        "4aa994fe4caec4e1edbe4bd7aca8726db962ec386018f8baf00bd68395861ee2",
+}
+
+
+def method(text, name):
+    matches = list(re.finditer(
+        r"(?ms)^\.method[^\n]* " + re.escape(name) + r"\n.*?^\.end method$", text))
+    if len(matches) != 1:
+        raise RuntimeError("Expected one BZI6 light method: " + name)
+    return matches[0]
+
+
+def once(text, old, new):
+    if text.count(old) != 1:
+        raise RuntimeError("BZI6 lights preimage changed: " + old)
+    return text.replace(old, new, 1)
+
+
+def wrapper(name, extended):
+    return f""".method public final {name}(IIII)V
+    .locals 6
+
+    move-object v0, p0
+    move v1, p1
+    const/4 v2, -0x1
+{extended}
+    move v3, p2
+    move v4, p3
+    move v5, p4
+    invoke-virtual/range {{v0 .. v5}}, {LIGHT}->{name}(IIIII)V
+    return-void
+.end method"""
+
+
+def adapt(root, backlight_patch):
+    for key, value in {
+        "ROM_SOURCE_CONFIG": "essi_a376b_android17", "ROM_MILESTONE": "M4",
+        "TARGET_CODENAME": "star2lte", "STAR2LTE_BUILD_MODEL": "SM-G965F",
+        "SOURCE_PLATFORM_SDK_VERSION": "37",
+        "SOURCE_FIRMWARE_CACHE_SUFFIX": "A376BXXU5BZI6",
+    }.items():
+        if os.environ.get(key) != value:
+            raise RuntimeError("Unreviewed BZI6 SehLights scope: " + key)
+    texts = {}
+    for relative, digest in FILES.items():
+        path = root / relative
+        if sha256(path.read_bytes()).hexdigest() != digest:
+            raise RuntimeError("Unreviewed BZI6 lights class: " + relative)
+        texts[relative] = path.read_text()
+    if sha256(backlight_patch.read_bytes()).hexdigest() != "c56f85d1af62f0433b14adb5d97fd6b6da53dcf0a98d2370eb654ca46ac3c975":
+        raise RuntimeError("Reviewed BZI6 backlight diff changed")
+
+    # Patch only a temporary copy; all input/transform checks finish before
+    # any class in the actual decoded artifact is changed.
+    backlight, light_rel, proxy_rel, power_rel = FILES
+    with tempfile.TemporaryDirectory(prefix="bzi6-backlight-") as directory:
+        temporary = Path(directory) / backlight
+        temporary.parent.mkdir(parents=True)
+        temporary.write_text(texts[backlight])
+        subprocess.run(["patch", "--batch", "--forward", "--fuzz=0", "-d", directory,
+                        "-p1", "-i", str(backlight_patch.resolve())], check=True,
+                       stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        texts[backlight] = temporary.read_text()
+
+    light = texts[light_rel]
+    constructor = method(light, "<init>(Lcom/android/server/lights/LightsService;Landroid/hardware/light/HwLight;)V")
+    body = once(constructor.group(), "    .locals 0", "    .locals 1")
+    body = once(body, "    return-void", f"    const/4 v0, -0x1\n\n    iput v0, p0, {LIGHT}->{EXT}\n\n    return-void")
+    light = light[:constructor.start()] + body + light[constructor.end():]
+    light = once(light, "# instance fields\n", "# instance fields\n.field public " + EXT + "\n\n")
+    for name in ("setLightLocked", "setLightUnchecked"):
+        old = method(light, name + "(IIII)V")
+        body = once(old.group(), name + "(IIII)V", name + "(IIIII)V")
+        # Match the fork's existing extension API order:
+        # color, extended brightness, flash mode, on ms, off ms.
+        body = re.sub(r"\bp[234]\b", lambda m: "p" + str(int(m.group()[1]) + 1), body)
+        if name == "setLightLocked":
+            anchor = f"    iget-boolean v0, v1, Lcom/android/server/lights/LightsService;->mIsSvcLightChanged:Z"
+            body = once(body, anchor,
+                f"    iget v0, p0, {LIGHT}->{EXT}\n\n    if-ne p2, v0, :cond_0\n\n" + anchor)
+            body = once(body, "    :cond_0\n", f"    :cond_0\n    iput p2, p0, {LIGHT}->{EXT}\n\n")
+            body = once(body,
+                f"    invoke-virtual {{p0, p1, p3, p4, p5}}, {LIGHT}->setLightUnchecked(IIII)V",
+                f"    invoke-virtual/range {{p0 .. p5}}, {LIGHT}->setLightUnchecked(IIIII)V")
+            compatibility = wrapper(name, "")
+        else:
+            body = once(body,
+                f"    invoke-virtual {{p1, p0, v2}}, {PROXY}->setLightState(ILandroid/hardware/light/HwLightState;)V",
+                f"    invoke-virtual {{p1, p0, v2, p2}}, {PROXY}->setLightState(ILandroid/hardware/light/HwLightState;I)V")
+            # Mute writes color0 without changing cached extended brightness;
+            # the existing unmute path replays the cached value for nonzero color.
+            compatibility = wrapper(name,
+                f"    if-eqz p1, :legacy_unchecked_ready\n    iget v2, p0, {LIGHT}->{EXT}\n    :legacy_unchecked_ready\n")
+        light = light[:old.start()] + compatibility + "\n\n" + body + light[old.end():]
+    texts[light_rel] = light
+
+    proxy = texts[proxy_rel]
+    old = method(proxy, "setLightState(ILandroid/hardware/light/HwLightState;)V")
+    body = once(old.group(), "setLightState(ILandroid/hardware/light/HwLightState;)V",
+                "setLightState(ILandroid/hardware/light/HwLightState;I)V")
+    body = once(body,
+        "    const/4 p2, -0x1\n\n    invoke-virtual {v0, p2}, Landroid/os/Parcel;->writeInt(I)V",
+        "    invoke-virtual {v0, p3}, Landroid/os/Parcel;->writeInt(I)V")
+    compatibility = f""".method public final setLightState(ILandroid/hardware/light/HwLightState;)V
+    .locals 1
+    const/4 v0, -0x1
+    invoke-virtual {{p0, p1, p2, v0}}, {PROXY}->setLightState(ILandroid/hardware/light/HwLightState;I)V
+    return-void
+.end method"""
+    texts[proxy_rel] = proxy[:old.start()] + compatibility + "\n\n" + body + proxy[old.end():]
+    power = texts[power_rel]
+    anchor = "    sput-boolean v0, Lcom/android/server/power/PowerManagerUtil;->SEC_FEATURE_USE_LIGHTS_HAL_EXTENSION:Z"
+    texts[power_rel] = once(power, anchor, "    const/4 v0, 0x1\n\n" + anchor)
+    for relative, text in texts.items():
+        (root / relative).write_text(text)
+    print("PASS BZI6 SehLights: LogicalLight, mute/cache state, extension Parcel and compatibility overloads")
+
+
+if __name__ == "__main__":
+    adapt(Path(sys.argv[1]), Path(sys.argv[2]))

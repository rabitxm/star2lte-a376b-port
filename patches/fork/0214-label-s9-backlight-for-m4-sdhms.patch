+#!/usr/bin/env python3
+"""Stage the exact S9+ backlight sysfs label needed by M4 SDHMS.
+
+Reason: BZI6 labels the Exynos9810 panel_drv@001 backlight as generic sysfs,
+which lacks the getattr permission SDHMS needs for fstat. The existing
+sysfs_ski_display_writable type already has the reviewed display permissions.
+Files: one exact vendor CIL genfscon rule, pinned by the adjacent lock.
+Verify exact scope, required existing policy permissions, idempotence and
+conflict rejection before the vendor image gate.
+"""
+from pathlib import Path
+import argparse
+import hashlib
+import json
+import tempfile
+
+
+HERE = Path(__file__).resolve().parent
+LOCK = HERE / "a376b_android17_thermal.lock.json"
+
+
+def lock():
+    return json.loads(LOCK.read_text())
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def cil_path(work):
+    return Path(work) / "vendor/etc/selinux/vendor_sepolicy.cil"
+
+
+def policy_text(data):
+    rules = lock()["policy"]
+    for required in rules["required_existing_rules"]:
+        if required not in data:
+            raise ValueError("M4 backlight policy lost an existing permission: " + required)
+    rule = rules["genfscon"]
+    conflicts = [line for line in data.splitlines()
+                 if line.lstrip().startswith('(genfscon sysfs ') and
+                 rules["path"] in line and line.strip() != rule]
+    if conflicts:
+        raise ValueError("Conflicting M4 backlight genfscon: " + conflicts[0])
+    occurrences = data.splitlines().count(rule)
+    if occurrences > 1:
+        raise ValueError("Duplicate M4 backlight genfscon")
+    if occurrences == 0:
+        data = data.rstrip("\n") + "\n" + rule + "\n"
+    return data
+
+
+def apply(work):
+    path = cil_path(work)
+    if path.is_symlink() or not path.is_file():
+        raise ValueError("M4 vendor policy is missing or symlinked")
+    before = path.read_text(errors="strict")
+    after = policy_text(before)
+    if after != before:
+        path.write_text(after)
+    verify(work)
+
+
+def verify(work):
+    path = cil_path(work)
+    if path.is_symlink() or not path.is_file():
+        raise ValueError("M4 vendor policy is missing or symlinked")
+    data = path.read_text(errors="strict")
+    expected = lock()["policy"]["genfscon"]
+    if data.splitlines().count(expected) != 1:
+        raise ValueError("Exact M4 backlight genfscon is missing or duplicated")
+    # Validate all pre-existing rules without changing the compiled policy.
+    policy_text(data)
+    return {"path": str(path), "rule": expected, "sha256": digest(path)}
+
+
+def self_test():
+    rules = lock()["policy"]
+    seed = "\n".join(rules["required_existing_rules"]) + "\n"
+    with tempfile.TemporaryDirectory(prefix="m4-backlight-policy-") as tmp:
+        root = Path(tmp)
+        target = cil_path(root)
+        target.parent.mkdir(parents=True)
+        target.write_text(seed)
+        apply(root)
+        staged = target.read_bytes()
+        apply(root)
+        if target.read_bytes() != staged:
+            raise ValueError("M4 backlight genfscon staging is not idempotent")
+        bad = seed + rules["genfscon"] + "\n" + rules["genfscon"] + "\n"
+        target.write_text(bad)
+        try:
+            verify(root)
+        except ValueError as error:
+            if "missing or duplicated" not in str(error):
+                raise
+        else:
+            raise ValueError("Duplicate M4 backlight genfscon was accepted")
+        target.write_text(seed + rules["conflicting_genfscon"] + "\n")
+        try:
+            apply(root)
+        except ValueError as error:
+            if "Conflicting M4 backlight" not in str(error):
+                raise
+        else:
+            raise ValueError("Conflicting M4 backlight genfscon was accepted")
+        target.write_text(seed)
+        target.write_text(target.read_text().replace(
+            rules["required_existing_rules"][0], "(type sysfs_ski_display_writable_missing)"))
+        try:
+            apply(root)
+        except ValueError as error:
+            if "lost an existing permission" not in str(error):
+                raise
+        else:
+            raise ValueError("Missing existing SDHMS policy permission was accepted")
+    print("PASS M4 backlight exact policy scope, required permissions, idempotence and negative fixtures")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    sub = parser.add_subparsers(dest="command", required=True)
+    apply_parser = sub.add_parser("apply")
+    apply_parser.add_argument("--work-dir", type=Path, required=True)
+    verify_parser = sub.add_parser("verify")
+    verify_parser.add_argument("--work-dir", type=Path, required=True)
+    sub.add_parser("self-test")
+    args = parser.parse_args()
+    if args.command == "self-test":
+        self_test()
+    elif args.command == "apply":
+        apply(args.work_dir)
+        print("PASS staged exact M4 S9+ backlight genfscon")
+    else:
+        print(json.dumps({"result": "PASS", **verify(args.work_dir)}))
+
+
+if __name__ == "__main__":
+    main()

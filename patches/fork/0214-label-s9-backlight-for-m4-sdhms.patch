+{
+  "schema": 1,
+  "scope": "M4 BZI6 Android17 G965F star2lte SDHMS backlight read metadata",
+  "reason": "SDHMS fstat on the real panel_drv@001 brightness node fails with EACCES under generic sysfs. The existing display type grants system_app getattr/read and is already used for the neighboring legacy panel backlight path.",
+  "files": [
+    "vendor/etc/selinux/vendor_sepolicy.cil"
+  ],
+  "policy": {
+    "path": "/devices/platform/panel_drv@001/backlight/panel/brightness",
+    "genfscon": "(genfscon sysfs \"/devices/platform/panel_drv@001/backlight/panel/brightness\" (u object_r sysfs_ski_display_writable ((s0) (s0))))",
+    "conflicting_genfscon": "(genfscon sysfs \"/devices/platform/panel_drv@001/backlight/panel/brightness\" (u object_r sysfs_ski_display_readable ((s0) (s0))))",
+    "required_existing_rules": [
+      "(type sysfs_ski_display_writable)",
+      "(allow system_app_33_0 sysfs_ski_display_writable (file (ioctl read write getattr lock append map open watch watch_reads)))"
+    ]
+  },
+  "verification": "exact CIL genfscon and existing system_app display permission are present in the final vendor ext4 image; device restorecon/reboot and SDHMS fstat must pass while Enforcing"
+}

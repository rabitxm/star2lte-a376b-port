+#!/usr/bin/env python3
+"""Normalize unsupported BZI6 DBFW+ and omit audited optional debug sends.
+
+Reason: the HFP capability quirk alone still leaves FDF1 timeouts on G965F.
+Files: thirteen locked instructions in JNI, with existing transport intact.
+Verify: exact Build ID, contexts, opcode/callback/call semantics, retained
+non-null callback guard, negative fixtures and final composed image hash.
+"""
+from pathlib import Path
+import argparse
+import hashlib
+import importlib.util
+import json
+import os
+import struct
+
+HERE = Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location('m4_fdf1', HERE / 'a376b_android17_fdf1_skip.py')
+fdf1 = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(fdf1)
+LOCK = json.loads((HERE / 'a376b_android17_dbfw_senders.lock.json').read_text())
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def code(data, va, size=4):
+    start = fdf1.file_offset_for_va(data, int(va, 16) if isinstance(va, str) else va)
+    return start, data[start:start + size]
+
+
+def layout(data):
+    if fdf1.build_id(data) != LOCK['gnu_build_id']:
+        raise ValueError('DBFW sender Build ID changed')
+    table_va = int(LOCK['indirect_enqueue_table_va'], 16)
+    phoff, phentsize, phnum, *_ = fdf1.elf_tables(data)
+    pointers = []
+    for index in range(phnum):
+        typ, _, off, va, _, size, _, _ = struct.unpack_from('<IIQQQQQQ', data, phoff + index * phentsize)
+        if typ == 1 and va <= table_va and table_va + 8 <= va + size:
+            pointers.append(struct.unpack_from('<Q', data, off + table_va - va)[0])
+    if pointers != [int(LOCK['indirect_enqueue_target_va'], 16)]:
+        raise ValueError('DBFW indirect enqueue table changed')
+    guard = LOCK['nonnull_callback_guard']
+    _, body = code(data, guard['start_va'], int(guard['end_va_exclusive'], 16) - int(guard['start_va'], 16))
+    if sha(body) != guard['sha256']:
+        raise ValueError('DBFW non-null callback/guard must remain intact')
+    edits = []
+    for edit in LOCK['edits']:
+        offset, instruction = code(data, edit['va'])
+        before, after = bytes.fromhex(edit['preimage_hex']), bytes.fromhex(edit['replacement_hex'])
+        if len(before) != 4 or len(after) != 4:
+            raise ValueError('DBFW edit is not one instruction')
+        original = struct.unpack('<I', before)[0]
+        if edit['kind'] == 'null-callback-send':
+            if code(data, edit['opcode_va'])[1] != bytes.fromhex('20be9f52') or code(data, edit['null_callback_va'])[1] != bytes.fromhex('e3031faa'):
+                raise ValueError('DBFW send is not locked FDF1 with null callback')
+            if after != bytes.fromhex('1f2003d5'):
+                raise ValueError('DBFW send replacement must be NOP')
+            if edit['blr_register'] is None:
+                imm = original & 0x3ffffff
+                if imm & 0x2000000:
+                    imm -= 0x4000000
+                if original & 0xfc000000 != 0x94000000 or int(edit['va'], 16) + imm * 4 != int(edit['direct_target_va'], 16):
+                    raise ValueError('DBFW BL target changed')
+            elif original != 0xd63f0000 | (edit['blr_register'] << 5):
+                raise ValueError('DBFW indirect call register changed')
+        elif edit['kind'] == 'global-capability-zero':
+            replacement = struct.unpack('<I', after)[0]
+            if original != 0x392d8288 or replacement != original | 31:
+                raise ValueError('DBFW global quirk must only zero STRB [x20,#0xb60]')
+        else:
+            raise ValueError('Unknown DBFW edit kind')
+        start, context = code(data, edit['context_start_va'], int(edit['context_end_va_exclusive'], 16) - int(edit['context_start_va'], 16))
+        state = 'before' if instruction == before and sha(context) == edit['context_preimage_sha256'] else 'after' if instruction == after and sha(context) == edit['context_output_sha256'] else None
+        if state is None:
+            raise ValueError('DBFW sender context mismatch at ' + edit['va'])
+        edits.append((offset, after, state))
+    if len(edits) != 13 or len({offset for offset, _, _ in edits}) != 13:
+        raise ValueError('Expected exactly thirteen distinct DBFW instructions')
+    return edits
+
+
+def patch_bytes(data):
+    edits = layout(data)
+    states = {state for _, _, state in edits}
+    if len(states) != 1:
+        raise ValueError('Partially applied DBFW sender patch rejected')
+    if states == {'after'}:
+        return data, 'already-patched'
+    result = bytearray(data)
+    for offset, after, _ in edits:
+        result[offset:offset + 4] = after
+    layout(bytes(result))
+    return bytes(result), 'patched'
+
+
+def fixture():
+    donor = fdf1.extract_donor_jni()
+    result, state = patch_bytes(donor)
+    if state != 'patched' or sha(result) != LOCK['donor_output_sha256'] or patch_bytes(result) != (result, 'already-patched'):
+        raise ValueError('DBFW donor output/idempotence mismatch')
+    allowed = {offset + byte for offset, _, _ in layout(donor) for byte in range(4)}
+    if any(a != b and i not in allowed for i, (a, b) in enumerate(zip(donor, result))) or len(result) != len(donor):
+        raise ValueError('DBFW mutation escaped thirteen instruction slots')
+    negative = [fdf1.file_offset_for_va(donor, int(e['context_start_va'], 16)) for e in LOCK['edits']]
+    negative += [fdf1.file_offset_for_va(donor, int(e['null_callback_va'], 16)) for e in LOCK['edits'] if e['kind'] == 'null-callback-send']
+    negative += [fdf1.file_offset_for_va(donor, int(LOCK['nonnull_callback_guard']['call_va'], 16))]
+    for offset in negative:
+        wrong = bytearray(donor)
+        wrong[offset] ^= 1
+        try:
+            patch_bytes(bytes(wrong))
+        except ValueError:
+            continue
+        raise ValueError('Changed DBFW context/callback accepted')
+    partial = bytearray(donor)
+    offset, after, _ = layout(donor)[0]
+    partial[offset:offset + 4] = after
+    try:
+        patch_bytes(bytes(partial))
+    except ValueError:
+        pass
+    else:
+        raise ValueError('Partial DBFW patch accepted')
+    print('PASS thirteen instruction boundary; null callbacks/BL/BLR table; global zero; nonnull callback retained; donor, idempotence and negative fixtures')
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('command', choices=['fixture', 'apply', 'verify'])
+    parser.add_argument('--jni', type=Path)
+    parser.add_argument('--final-hash', action='store_true')
+    args = parser.parse_args()
+    fdf1.check_scope()
+    if args.command == 'fixture':
+        fixture()
+        return
+    if not args.jni or args.jni.is_symlink() or not args.jni.is_file():
+        raise ValueError('DBFW sender JNI target missing or symlinked')
+    data = args.jni.read_bytes()
+    result, state = patch_bytes(data)
+    if args.command == 'apply' and state == 'patched':
+        temp = args.jni.with_name(args.jni.name + '.senders.tmp')
+        temp.write_bytes(result)
+        temp.chmod(args.jni.stat().st_mode & 0o777)
+        os.replace(temp, args.jni)
+    if args.command == 'verify' and (state != 'already-patched' or args.final_hash and sha(data) != LOCK['final_work_jni_sha256']):
+        raise ValueError('DBFW final composed JNI mismatch')
+    print('PASS locked BZI6 DBFW senders: ' + state)
+
+
+if __name__ == '__main__':
+    main()

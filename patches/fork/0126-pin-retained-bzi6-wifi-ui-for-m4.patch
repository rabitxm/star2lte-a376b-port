diff --git a/unica/patches/product_feature/wifi/a376b_android17_ui.py b/unica/patches/product_feature/wifi/a376b_android17_ui.py
--- /dev/null
+++ b/unica/patches/product_feature/wifi/a376b_android17_ui.py
@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+"""Verify the explicitly retained BZI6 Wi-Fi UI; no hardware capability edit."""
+from hashlib import sha256
+from pathlib import Path
+import importlib.util
+import json
+import os
+import re
+import sys
+
+SPEC = importlib.util.spec_from_file_location("bzi6_product", Path(__file__).resolve().parent.parent / "a376b_android17_product.py")
+PRODUCT = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(PRODUCT)
+ABSENT = "com/samsung/android/settings/wifi/WifiEntriesFilter$$ExternalSyntheticLambda0.smali"
+
+
+def scope():
+    PRODUCT.scope()
+    for key, value in {
+        "STAR2LTE_M4_KEEP_DONOR_WIFI_UI": "true", "STAR2LTE_M2_KEEP_DONOR_WIFI_UI": "false",
+        "SOURCE_WLAN_SUPPORT_80211AX": "true", "TARGET_WLAN_SUPPORT_80211AX": "false",
+        "SOURCE_WLAN_SUPPORT_80211AX_6GHZ": "false", "TARGET_WLAN_SUPPORT_80211AX_6GHZ": "false",
+    }.items():
+        if os.environ.get(key) != value:
+            raise RuntimeError("Unreviewed BZI6 retained Wi-Fi UI selection: " + key)
+
+
+def rules():
+    return json.loads(Path(__file__).with_suffix(".json").read_text())
+
+
+def canonical(text):
+    # DEX pool size can change const-string/jumbo encoding. Source markers,
+    # comments and hidden-API access labels are not executable UI behavior.
+    lines = []
+    for line in text.splitlines():
+        line = line.strip()
+        if not line or line.startswith(("#", ".source ")):
+            continue
+        line = line.replace("const-string/jumbo ", "const-string ")
+        if line.startswith((".method ", ".field ")):
+            line = re.sub(r"\b(?:blacklist|whitelist|greylist(?:-max-[a-z])?|core-platform-api|test-api)\s+", "", line)
+        lines.append(line)
+    return sha256("\n".join(lines).encode()).hexdigest()
+
+
+def verify_source(root):
+    scope()
+    for row in rules():
+        paths = list((root / row["artifact"]).glob("smali*/" + row["descriptor"] + ".smali"))
+        if len(paths) != 1 or sha256(paths[0].read_bytes()).hexdigest() != row["sha256"]:
+            raise RuntimeError("Unreviewed retained BZI6 Wi-Fi UI class: " + row["descriptor"])
+    if list((root / "system/priv-app/SecSettings/SecSettings.apk").glob("smali*/" + ABSENT)):
+        raise RuntimeError("Old BZI6 Wi-Fi filter lambda unexpectedly present")
+    print("PASS retained BZI6 Wi-Fi UI: 13 source class pins, replacement filter and old-lambda absence; target Wi-Fi5")
+
+
+def verify_compiled(work, tools):
+    scope()
+    for row in rules():
+        artifact = row["artifact"]
+        path = work / ("system/" + artifact if artifact.startswith("system/") else artifact)
+        text = PRODUCT.compiled_class(path, row["descriptor"], tools)
+        if canonical(text) != row["canonical_sha256"]:
+            raise RuntimeError("Retained compiled BZI6 Wi-Fi UI changed: " + row["descriptor"])
+    print("PASS retained compiled BZI6 Wi-Fi UI: all13 class bodies match reviewed donor behavior; hardware remains Wi-Fi5")
+
+
+if __name__ == "__main__":
+    if len(sys.argv) == 3 and sys.argv[1] == "verify-source":
+        verify_source(Path(sys.argv[2]))
+    elif len(sys.argv) == 4 and sys.argv[1] == "verify-compiled":
+        verify_compiled(Path(sys.argv[2]), Path(sys.argv[3]))
+    else:
+        raise SystemExit("usage: a376b_android17_ui.py verify-source DECODED | verify-compiled WORK TOOLS")

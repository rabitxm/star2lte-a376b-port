+    checks = [
+        (lock["source_capex_path"], lock["source_capex_sha256"], "Android17 NFC APEX"),
+        (lock["system_sec_nfc_apk_path"], lock["system_sec_nfc_apk_sha256"], "Android17 SecNfc.apk"),
+    ]
+    rels = []
+    for source_rel, expected_hash, label in checks:
+        image_rel = source_rel.removeprefix("system/")
+        paths = (("donor", donor / source_rel), ("work", work / "system" / image_rel))
+        for tree_name, path in paths:
+            if not path.is_file():
+                raise ValueError("M4 " + label + " is missing from " + tree_name + ": " + str(path))
+            found_hash = hashlib.sha256(path.read_bytes()).hexdigest()
+            if found_hash != expected_hash:
+                raise ValueError("M4 " + label + " hash mismatch in " + tree_name + ": " + found_hash)
+        rels.append(image_rel)
+    return rels

From: Codex M2 boot diagnostics
Subject: [PATCH] Retain cache init logger after vendor baseline restore

Reason: M1 calibration showed vendor baseline restoration removed the final
init.debug rc and logger payload. Recreate both only when the existing opt-in
flag is enabled, after all vendor restores, and fail closed if they do not
survive into the final work tree.

Files: unica/patches/exynos9810_device_stack/exynos9810_boot_restore/customize.sh.
Verification: bash -n, complete patch replay, final image metadata audit, M1
calibration and M2 CACHE marker capture. This changes no kernel, radio, EFS,
modem, bootloader, or production image when the flag is false.

diff --git a/unica/patches/exynos9810_device_stack/exynos9810_boot_restore/customize.sh b/unica/patches/exynos9810_device_stack/exynos9810_boot_restore/customize.sh
--- a/unica/patches/exynos9810_device_stack/exynos9810_boot_restore/customize.sh
+++ b/unica/patches/exynos9810_device_stack/exynos9810_boot_restore/customize.sh
@@ -1498,6 +1498,82 @@
     _EXYNOS9810_SET_METADATA_SAFE "vendor" "vendor/etc/init/unica_exynos9810_trace.rc" 0 0 644 "u:object_r:vendor_file:s0"
 }
 
+_EXYNOS9810_WRITE_FINAL_INIT_DEBUG()
+{
+    local RC="$WORK_DIR/vendor/etc/init/init.debug.rc"
+    local LOGGER="$WORK_DIR/vendor/bin/init_debug_log.sh"
+    if [ "${EXYNOS9810_ENABLE_INIT_DEBUG:-false}" != "true" ]; then
+        rm -f "$RC" "$LOGGER"
+        _EXYNOS9810_DELETE_METADATA "vendor" "vendor/etc/init/init.debug.rc" "/vendor/etc/init/init.debug.rc"
+        _EXYNOS9810_DELETE_METADATA "vendor" "vendor/bin/init_debug_log.sh" "/vendor/bin/init_debug_log.sh"
+        return 0
+    fi
+
+    LOG "- Restoring final Exynos9810 CACHE init logger"
+    mkdir -p "$(dirname "$RC")" "$(dirname "$LOGGER")"
+    cat > "$RC" <<'EOF'
+on early-init
+    write /dev/kmsg "UN1CA-9810: init.debug early-init reached"
+
+on post-fs
+    write /dev/kmsg "UN1CA-9810: init.debug post-fs reached"
+    mkdir /cache/unica 0777 root root
+    write /cache/unica/init_debug_post_fs.txt "post-fs reached"
+    copy /proc/cmdline /cache/unica/cmdline.txt
+    copy /proc/mounts /cache/unica/mounts_post_fs.txt
+    copy /proc/partitions /cache/unica/partitions.txt
+    start unica9810_init_debug
+
+on post-fs-data
+    write /dev/kmsg "UN1CA-9810: init.debug post-fs-data reached"
+    mkdir /cache/unica 0777 root root
+    write /cache/unica/init_debug_post_fs_data.txt "post-fs-data reached"
+    copy /proc/mounts /cache/unica/mounts_post_fs_data.txt
+
+on boot
+    write /dev/kmsg "UN1CA-9810-BOOT: boot"
+
+on property:sys.boot_completed=1
+    write /dev/kmsg "UN1CA-9810-BOOT: boot_completed"
+    write /cache/unica/boot_completed.txt "1"
+
+service unica9810_init_debug /vendor/bin/init_debug_log.sh
+    class core
+    user root
+    group root log readproc
+    disabled
+    oneshot
+    seclabel u:r:init:s0
+EOF
+    cat > "$LOGGER" <<'EOF'
+#!/system/bin/sh
+OUT=/cache/unica
+mkdir -p "$OUT"
+{
+    echo "UN1CA Exynos9810 init.debug logger"
+    date
+    echo "cmdline:"; cat /proc/cmdline
+    echo "mounts:"; cat /proc/mounts
+    echo "partitions:"; cat /proc/partitions
+} > "$OUT/init_debug_start.txt" 2>&1
+getprop > "$OUT/props_start.txt" 2>&1
+dmesg > "$OUT/dmesg_start.txt" 2>&1
+logcat -b all -d -v threadtime > "$OUT/logcat_start.txt" 2>&1
+logcat -b all -v threadtime -f "$OUT/logcat_live.txt" &
+sleep 15
+dmesg > "$OUT/dmesg_15s.txt" 2>&1
+logcat -b all -d -v threadtime > "$OUT/logcat_15s.txt" 2>&1
+sleep 45
+dmesg > "$OUT/dmesg_60s.txt" 2>&1
+logcat -b all -d -v threadtime > "$OUT/logcat_60s.txt" 2>&1
+sync
+EOF
+    chmod 644 "$RC"
+    chmod 755 "$LOGGER"
+    _EXYNOS9810_SET_METADATA_SAFE "vendor" "vendor/etc/init/init.debug.rc" 0 0 644 "u:object_r:vendor_configs_file:s0"
+    _EXYNOS9810_SET_METADATA_SAFE "vendor" "vendor/bin/init_debug_log.sh" 0 2000 755 "u:object_r:vendor_file:s0"
+}
+
 _EXYNOS9810_RESTORE_VENDOR_BIN_GROUPS()
 {
     local ROOT="$WORK_DIR/vendor/bin"
@@ -1906,7 +1982,15 @@
 _EXYNOS9810_FIX_ENFORCING_INIT_DATA_DIRS
 _EXYNOS9810_APPLY_TARGET_VENDOR_IDENTITY || return 1
 _EXYNOS9810_SANITIZE_RESTORED_TEXT
-_EXYNOS9810_WRITE_FINAL_BOOT_TRACE
+    _EXYNOS9810_WRITE_FINAL_BOOT_TRACE
+    _EXYNOS9810_WRITE_FINAL_INIT_DEBUG
+    if [ "${EXYNOS9810_ENABLE_INIT_DEBUG:-false}" = "true" ]; then
+        [ -s "$WORK_DIR/vendor/etc/init/init.debug.rc" ] &&
+            [ -x "$WORK_DIR/vendor/bin/init_debug_log.sh" ] || {
+                LOGE "Exynos9810 diagnostic CACHE init logger was not retained in final vendor tree"
+                return 1
+            }
+    fi
 if [ "$EXYNOS9810_USED_VENDOR_METADATA_SNAPSHOT" != true ]; then
     _EXYNOS9810_RESTORE_VENDOR_BIN_GROUPS
 fi

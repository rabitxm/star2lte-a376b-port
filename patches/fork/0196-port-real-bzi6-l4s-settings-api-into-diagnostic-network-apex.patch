+"""Port the real BZI6 L4S Settings API into the diagnostic S22 Java provider.
+Reason: observed SystemServer getL4sDeveloperOption NoSuchMethodError.
+Scope: four donor method bodies and five constants; retain all old Java behavior.
+Verify: donor/input hashes, DEX round-trip of every class/method, unchanged JAR entries.
+"""
+from pathlib import Path
+import re,shutil,zipfile,hashlib,json
+
+def digest(p):return hashlib.file_digest(Path(p).open('rb'),'sha256').hexdigest()
+def methods(t):
+ out={}
+ for m in re.finditer(r'^\.method [^\n]+\n.*?^\.end method$',t,re.M|re.S):
+  signature=m.group().splitlines()[0].split()[-1]
+  assert signature not in out
+  out[signature]=m.group()
+ return out
+
+def canonical(t):
+ ms=methods(t)
+ rest=re.sub(r'^\.method [^\n]+\n.*?^\.end method$','',t,flags=re.M|re.S)
+ def clean(s):return '\n'.join(x.strip() for x in s.splitlines() if x.strip() and not x.lstrip().startswith('#'))
+ # DEX permits omitted encoded static false; smali canonicalizes exactly that default.
+ fields=sorted(re.sub(r':Z = false$', ':Z', clean(x)) for x in rest.splitlines() if x.startswith('.field '))
+ rest='\n'.join(x for x in rest.splitlines() if not x.startswith('.field '))
+ return {'header':clean(rest),'fields':fields,'methods':{k:clean(v) for k,v in ms.items()}}
+
+def apply(s22,bzi6,output,tools,run):
+ output=Path(output);output.mkdir(exist_ok=False)
+ assert digest(s22)=='e36da5426bcec43d537d756e0b0e36a16edde945915a8b342c9c6b5f110fe0a7'
+ assert digest(bzi6)=='391f21176a39a112285efe9b492fdb8d50b3c1dc36b5ea4f07da7dabe91c3b33'
+ # Both locked donors use DEX039; API29 selects that format, not a device SDK spoof.
+ jar=tools/'apktool.jar';base=['java','-cp',jar]
+ for tag,source in [('s22',s22),('bzi6',bzi6)]:
+  with zipfile.ZipFile(source) as z:
+   assert [x for x in z.namelist() if re.fullmatch(r'classes\d*\.dex',x)]==['classes.dex']
+   dex=z.read('classes.dex');assert dex[:8]==b'dex\n039\0';(output/(tag+'.dex')).write_bytes(dex)
+  run(base+['com.android.tools.smali.baksmali.Main','disassemble','-a','29','-l','-j','8','-o',output/tag,output/(tag+'.dex')])
+ work=output/'merged';shutil.copytree(output/'s22',work)
+ selections={
+  'android/net/ConnectivitySettingsManager.smali':(['getL4sDeveloperOption(Landroid/content/Context;)I','setL4sDeveloperOption(Landroid/content/Context;I)V'],['L4S_DEVELOPER_OPTION','L4S_DEVELOPER_OPTION_AUTOMATIC','L4S_DEVELOPER_OPTION_DISABLED','L4S_DEVELOPER_OPTION_ENABLED']),
+  'android/net/connectivity/com/android/net/module/util/ConnectivitySettingsUtils.smali':(['getL4sDeveloperOptionSetting(Landroid/content/Context;)I','setL4sDeveloperOptionSetting(Landroid/content/Context;I)V'],['L4S_DEVELOPER_OPTION'])}
+ expected={};added={}
+ for rel,(names,fields) in selections.items():
+  old=(work/rel).read_text();donor=(output/'bzi6'/rel).read_text();om=methods(old);dm=methods(donor)
+  assert not set(names)&set(om)
+  extra=[]
+  for name in fields:
+   matches=re.findall(r'^\.field [^\n]* '+re.escape(name)+r':[^\n]*$',donor,re.M)
+   assert len(matches)==1 and not re.search(r'^\.field [^\n]* '+re.escape(name)+r':',old,re.M)
+   extra+=matches
+  old=old.replace('# static fields','# static fields\n'+'\n\n'.join(extra),1)
+  for name in names:old+='\n\n'+dm[name]+'\n'
+  (work/rel).write_text(old);added[rel]={'methods':names,'fields':fields};expected[rel]=canonical(old)
+ assembly=run(base+['com.android.tools.smali.smali.Main','assemble','-a','29','-j','1','-o',output/'classes.dex']+sorted(work.rglob('*.smali'),key=str))
+ (output/'assemble.txt').write_text(assembly)
+ assert (output/'classes.dex').is_file() and (output/'classes.dex').read_bytes()[:8]==b'dex\n039\0',assembly
+ run(base+['com.android.tools.smali.baksmali.Main','disassemble','-a','29','-l','-j','8','-o',output/'verified',output/'classes.dex'])
+ originals={str(p.relative_to(output/'s22')) for p in (output/'s22').rglob('*.smali')}
+ actual={str(p.relative_to(output/'verified')) for p in (output/'verified').rglob('*.smali')}
+ assert originals==actual
+ for rel in sorted(originals):
+  want=expected.get(rel,canonical((output/'s22'/rel).read_text()))
+  assert canonical((output/'verified'/rel).read_text())==want,rel
+ target=output/'framework-connectivity.jar'
+ with zipfile.ZipFile(s22) as src,zipfile.ZipFile(target,'w') as dst:
+  for entry in src.infolist():dst.writestr(entry,(output/'classes.dex').read_bytes() if entry.filename=='classes.dex' else src.read(entry))
+ with zipfile.ZipFile(s22) as src,zipfile.ZipFile(target) as dst:
+  assert src.namelist()==dst.namelist()
+  for n in src.namelist():
+   if n!='classes.dex':assert src.read(n)==dst.read(n)
+ report={'result':'PASS','classes_verified':len(actual),'additions':added,'output_sha256':digest(target),'no_old_methods_replaced':True,'runtime_network_acceptance':False}
+ (output/'report.json').write_text(json.dumps(report,indent=2)+'\n')
+ return target,report

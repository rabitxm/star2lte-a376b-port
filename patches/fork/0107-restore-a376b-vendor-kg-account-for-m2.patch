+"""Stage and verify reviewed M2 compatibility inputs for G965F.
+Reason: A37 Tethering/V6 need retained donor inputs; kgclient seapp requires
+the donor-pinned vendor_kg account name for UID/GID 5959.
+Files: retained system inputs and only the exact donor account rows.
+Verify source hashes, collision-free account merge, final ext4 metadata,
+selected diagnostic kernel, persistent metadata and compiled Camera enum.
 """
 from pathlib import Path
 import argparse, hashlib, importlib.util, json, os, re, shutil
 HERE=Path(__file__).resolve().parent
 def lock():return json.loads((HERE/'a376b_runtime_compat.lock.json').read_text())
 def digest(p):return hashlib.sha256(p.read_bytes()).hexdigest()
+
+def donor_kg_rows(vendor):
+    """Read only the A37-pinned vendor accounts needed by the retained seapp rule."""
+    expected=lock()['vendor_kg_accounts'];rows={}
+    for kind in ('passwd','group'):
+        path=vendor/'etc'/kind
+        if digest(path)!=expected[kind+'_sha256']:
+            raise ValueError('A376B vendor '+kind+' source hash mismatch')
+        lines=path.read_text().splitlines();wanted=expected[kind+'_line']
+        named=[line for line in lines if line.split(':',1)[0]=='vendor_kg']
+        identified=[]
+        for line in lines:
+            fields=line.split(':')
+            try:account_id=int(fields[2])
+            except (IndexError,ValueError):continue
+            if account_id==5959:identified.append(line)
+        if named!=[wanted] or identified!=[wanted]:
+            raise ValueError('A376B vendor '+kind+' must contain exactly the locked vendor_kg UID/GID 5959 row')
+        rows[kind]=wanted
+    return rows
+
+def merge_vendor_account(path,kind,wanted):
+    """Idempotently add one locked account; reject any duplicate name or ID."""
+    lines=path.read_text().splitlines() if path.exists() else []
+    named=[];identified=[]
+    for line in lines:
+        fields=line.split(':')
+        try:account_id=int(fields[2])
+        except (IndexError,ValueError):continue
+        if fields[0]=='vendor_kg':named.append(line)
+        if account_id==5959:identified.append(line)
+    if named or identified:
+        if named==[wanted] and identified==[wanted]:return
+        raise ValueError('Hybrid Vendor '+kind+' has a conflicting vendor_kg name or UID/GID 5959')
+    prefix='\n' if lines and path.read_bytes()[-1:]!=b'\n' else ''
+    path.parent.mkdir(parents=True,exist_ok=True)
+    with path.open('a') as output:output.write(prefix+wanted+'\n')
+
+def verify_vendor_kg(work):
+    expected=lock()['vendor_kg_accounts']
+    for kind in ('passwd','group'):
+        lines=(work/'vendor/etc'/kind).read_text().splitlines();wanted=expected[kind+'_line']
+        named=[line for line in lines if line.split(':',1)[0]=='vendor_kg'];identified=[]
+        for line in lines:
+            fields=line.split(':')
+            try:account_id=int(fields[2])
+            except (IndexError,ValueError):continue
+            if account_id==5959:identified.append(line)
+        if named!=[wanted] or identified!=[wanted]:
+            raise ValueError('Final Hybrid Vendor '+kind+' has missing, duplicate or conflicting vendor_kg UID/GID 5959')
+
+def self_test(vendor):
+    rows=donor_kg_rows(vendor)
+    import tempfile
+    with tempfile.TemporaryDirectory(prefix='a376b-vendor-kg-') as td:
+        root=Path(td);(root/'vendor/etc').mkdir(parents=True)
+        for kind in ('passwd','group'):
+            path=root/'vendor/etc'/kind
+            other='existing_test::5900:5900::/:/bin/sh\n' if kind=='passwd' else 'existing_test::5900:\n'
+            path.write_text(other);merge_vendor_account(path,kind,rows[kind]);first=path.read_bytes()
+            merge_vendor_account(path,kind,rows[kind])
+            if path.read_bytes()!=first:raise ValueError('vendor_kg merge is not idempotent')
+        verify_vendor_kg(root)
+        for kind in ('passwd','group'):
+            path=root/'vendor/etc'/kind
+            other='other_test::5959:5959::/:/bin/sh\n' if kind=='passwd' else 'other_test::5959:\n'
+            path.write_text(other)
+            try:merge_vendor_account(path,kind,rows[kind])
+            except ValueError:pass
+            else:raise ValueError('vendor_kg UID/GID collision accepted for '+kind)
+    print('PASS donor hashes, exact rows, idempotent merge and UID/GID collision rejection')
+

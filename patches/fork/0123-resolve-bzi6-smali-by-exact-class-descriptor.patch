         local CLASS_PATH="${SMALI#*/}"
         local CANDIDATE
         local MATCHED=()
@@ -91,6 +102,9 @@
         elif [ "${#MATCHED[@]}" -eq 1 ]; then
             SMALI="${MATCHED[0]#"$FILE_PATH/"}"
             LOG "- Resolved A376B DEX class location: $SMALI"
+        elif [ "${ROM_SOURCE_CONFIG:-}" = "essi_a376b_android17" ]; then

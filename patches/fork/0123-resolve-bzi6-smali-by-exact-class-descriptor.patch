diff --git a/scripts/utils/smali_utils.sh b/scripts/utils/smali_utils.sh
--- a/scripts/utils/smali_utils.sh
+++ b/scripts/utils/smali_utils.sh
@@ -27,6 +27,16 @@
     local SMALI="$3"
     local OPERATION="$4"
 

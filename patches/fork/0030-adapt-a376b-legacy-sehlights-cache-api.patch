+            EVAL "python3 \"$MODPATH/lights/patch_a376b_sehlights.py\" \"$APKTOOL_DIR/system/framework/services.jar\" \"$MODPATH/lights/services.jar/0001-Backport-legacy-SehLights-HAL-code.patch\"" || return 1

@@ -0,0 +1,120 @@
+#!/usr/bin/env python3
+"""Adapt the existing legacy SehLights backport to the reviewed A376B16 layout."""
+from __future__ import annotations
+
+import re
+import sys
+from pathlib import Path
+
+
+def fail(message: str) -> None:
+    raise SystemExit(message)
+
+
+root, upstream_patch = map(Path, sys.argv[1:3])
+patch_lines = upstream_patch.read_text().splitlines()
+try:
+    hunk_start = next(i for i, line in enumerate(patch_lines) if line.startswith("@@ -384,257 +384,334"))
+    hunk_end = next(i for i in range(hunk_start + 1, len(patch_lines)) if patch_lines[i].startswith("diff --git "))
+except StopIteration:
+    fail("upstream SehLights LightImpl hunk changed; review required")
+
+# Reuse the fork's reviewed implementation, then adapt only its HAL cache API.
+new_lines: list[str] = []
+for line in patch_lines[hunk_start + 1 : hunk_end]:
+    if line.startswith((" ", "+")):
+        new_lines.append(line[1:])
+    elif line.startswith(("-", "\\")):
+        continue
+    elif not line:
+        new_lines.append("")
+    else:
+        fail(f"unexpected upstream diff line: {line!r}")
+new_block = "\n".join(new_lines) + "\n"
+old_signature = ".method public final setLightLocked(IIII)V"
+try:
+    method_start = new_block.index(old_signature)
+    method_end = new_block.index(".method public final turnOff()V", method_start)
+except ValueError:
+    fail("upstream SehLights LightImpl method layout changed; review required")
+new_block = new_block[method_start:method_end]
+new_block = new_block.replace(
+    "invoke-interface {v1}, Ljava/util/function/Supplier;->get()",
+    "invoke-virtual {v1}, Lcom/android/server/lights/LightsService$VintfHalCache;->get()",
+)
+new_block = new_block.replace(
+    "Ljava/util/function/Supplier;",
+    "Lcom/android/server/lights/LightsService$VintfHalCache;",
+)
+if "java/util/function/Supplier" in new_block or "invoke-interface {v1}" in new_block:
+    fail("unadapted Supplier assumption remains in A376B backport")
+
+light_path = root / "smali/com/android/server/lights/LightsService$LightImpl.smali"
+light = light_path.read_text()
+if light.count(old_signature) != 1:
+    fail("expected one A376B setLightLocked(IIII)V; donor layout changed")
+old_start = light.index(old_signature)
+old_end = light.index(".end method", old_start) + len(".end method")
+old_method = light[old_start:old_end]
+for required in (
+    "mVintfLights:Lcom/android/server/lights/LightsService$VintfHalCache;",
+    "mVintfSehLights:Lcom/android/server/lights/LightsService$VintfHalCache;",
+    "->setLightState(ILandroid/hardware/light/HwLightState;)V",
+):
+    if required not in old_method:
+        fail(f"A376B LightImpl expected pattern missing: {required}")
+light = light[:old_start] + new_block.rstrip() + light[old_end:]
+
+proxy_path = root / "smali_classes2/vendor/samsung/hardware/light/ISehLights$Stub$Proxy.smali"
+proxy = proxy_path.read_text()
+proxy_old = ".method public final setLightState(ILandroid/hardware/light/HwLightState;)V"
+proxy_new = ".method public final setLightState(ILandroid/hardware/light/HwLightState;I)V"
+if proxy.count(proxy_old) != 1:
+    fail("expected one A376B two-argument SehLights proxy method")
+proxy = proxy.replace(proxy_old, proxy_new, 1)
+legacy_wrapper = """.method public final setLightState(ILandroid/hardware/light/HwLightState;)V
+    .locals 1
+
+    const/4 v0, -0x1
+
+    invoke-virtual {p0, p1, p2, v0}, Lvendor/samsung/hardware/light/ISehLights$Stub$Proxy;->setLightState(ILandroid/hardware/light/HwLightState;I)V
+
+    return-void
+.end method
+
+"""
+proxy = proxy.replace(proxy_new, legacy_wrapper + proxy_new, 1)
+if proxy.count(proxy_old) != 1 or proxy.count(proxy_new) != 1:
+    fail("A376B proxy compatibility overload was not generated")
+
+power_path = root / "smali_classes2/com/android/server/power/PowerManagerUtil.smali"
+power = power_path.read_text()
+flag_context = re.compile(
+    r"    if-eqz v10, :cond_1d\n.*?"
+    r"    sput-boolean v16, Lcom/android/server/power/PowerManagerUtil;->SEC_FEATURE_USE_LIGHTS_HAL_EXTENSION:Z",
+    re.S,
+)
+if len(flag_context.findall(power)) != 1:
+    fail("A376B PowerManagerUtil legacy lights flag context changed")
+power = flag_context.sub(
+    "    sput-boolean v3, Lcom/android/server/power/PowerManagerUtil;->SEC_FEATURE_USE_LIGHTS_HAL_EXTENSION:Z",
+    power,
+    count=1,
+)
+flag_marker = power.index("sput-boolean v3, Lcom/android/server/power/PowerManagerUtil;->SEC_FEATURE_USE_LIGHTS_HAL_EXTENSION:Z")
+flag_end = flag_marker + len("SEC_FEATURE_USE_LIGHTS_HAL_EXTENSION:Z")
+concurrency_end = power.index(
+    "sput-boolean v0, Lcom/android/server/power/PowerManagerUtil;->SEC_FEATURE_DISPLAY_STATE_CONCURRENCY:Z"
+)
+start = power.rfind("    if-eqz v9, :cond_1e", flag_end, concurrency_end)
+section = power[start:concurrency_end]
+if start < 0 or section.count(":cond_1e") != 3 or section.count(":goto_1d") != 2:
+    fail("A376B display concurrency labels changed; review required")
+section = section.replace(":cond_1e", ":cond_1d").replace(":goto_1d", ":goto_1c")
+power = power[:start] + section + power[concurrency_end:]
+
+# Do not leave a half-patched services.jar source tree if any layout check fails.
+light_path.write_text(light)
+proxy_path.write_text(proxy)
+power_path.write_text(power)
+print("PASS A376B AZH4 SehLights bridge: VintfHalCache retained; two-argument callers preserved; extension mode forwarded")

diff --git a/scripts/utils/common_utils.sh b/scripts/utils/common_utils.sh
--- a/scripts/utils/common_utils.sh
+++ b/scripts/utils/common_utils.sh
@@ -25,6 +25,40 @@
     fi
 
     return 0
+}
+
+# GET_FIRMWARE_CACHE_KEY <firmware> returns the existing model/CSC cache key,
+# with an optional locked source-build suffix. This keeps donor builds with the
+# same model/CSC in separate caches while leaving all existing profiles intact.
+GET_FIRMWARE_CACHE_KEY()
+{
+    _CHECK_NON_EMPTY_PARAM "FIRMWARE" "$1" || return 1
+
+    local MODEL_NAME="$(cut -d "/" -f 1 -s <<< "$1")"
+    local CSC_NAME="$(cut -d "/" -f 2 -s <<< "$1")"
+    [ "$MODEL_NAME" ] && [ "$CSC_NAME" ] || {
+        LOGE "Invalid firmware cache selector: $1"
+        return 1
+    }
+
+    local CACHE_SUFFIX=""
+    if [ "${SOURCE_FIRMWARE:-}" ]; then
+        local SOURCE_MODEL="$(cut -d "/" -f 1 -s <<< "$SOURCE_FIRMWARE")"
+        local SOURCE_CSC="$(cut -d "/" -f 2 -s <<< "$SOURCE_FIRMWARE")"
+        if [[ "$MODEL_NAME/$CSC_NAME" == "$SOURCE_MODEL/$SOURCE_CSC" ]]; then
+            CACHE_SUFFIX="${SOURCE_FIRMWARE_CACHE_SUFFIX:-}"
+        fi
+    fi
+
+    if [ "$CACHE_SUFFIX" ]; then
+        [[ "$CACHE_SUFFIX" =~ ^[A-Za-z0-9._-]+$ ]] || {
+            LOGE "Invalid SOURCE_FIRMWARE_CACHE_SUFFIX: $CACHE_SUFFIX"
+            return 1
+        }
+        printf '%s_%s_%s\n' "$MODEL_NAME" "$CSC_NAME" "$CACHE_SUFFIX"
+    else
+        printf '%s_%s\n' "$MODEL_NAME" "$CSC_NAME"
+    fi
 }
 
 _GET_PROP_FILES_PATH()
@@ -211,7 +245,7 @@
 
     if [ ! -d "$SOURCE" ]; then
         if [ "$(cut -d "/" -f 2 -s <<< "$SOURCE")" ]; then
-            SOURCE="$FW_DIR/$(cut -d "/" -f 1 <<< "$SOURCE")_$(cut -d "/" -f 2 <<< "$SOURCE")"
+            SOURCE="$FW_DIR/$(GET_FIRMWARE_CACHE_KEY "$SOURCE")" || return 1
         else
             SOURCE="$SRC_DIR/prebuilts/samsung/$SOURCE"
         fi

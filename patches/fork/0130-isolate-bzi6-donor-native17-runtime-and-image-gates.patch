+#!/usr/bin/env python3
+"""Stage and verify the donor-native M4 runtime boundary.
+
+Reason: keep BZI6 camera/audio/graphics/Tethering ABI paired at Android 17 while
+adding only the reviewed vendor_kg account and an empty vendor aconfig v2 set.
+Files: exact files in the M4 lock, vendor passwd/group and vendor/etc/aconfig.
+Verify source marker/hashes, aconfig v2 provenance, final work tree and scope.
+"""
+from pathlib import Path
+import argparse
+import hashlib
+import importlib.util
+import json
+import os
+import shutil
+import struct
+
+HERE = Path(__file__).resolve().parent
+LOCK = HERE / "a376b_android17_runtime_compat.lock.json"
+
+
+def manifest():
+    return json.loads(LOCK.read_text())
+
+
+def digest(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def scope():
+    expected = {
+        "ROM_SOURCE_CONFIG": "essi_a376b_android17",
+        "ROM_MILESTONE": "M4",
+        "TARGET_CODENAME": "star2lte",
+        "TARGET_PLATFORM": "exynos9810",
+        "STAR2LTE_BUILD_MODEL": "SM-G965F",
+        "SOURCE_PLATFORM_SDK_VERSION": "37",
+        "TARGET_PLATFORM_SDK_VERSION": "31",
+        "SOURCE_PRODUCT_SHIPPING_API_LEVEL": "36",
+        "TARGET_PRODUCT_SHIPPING_API_LEVEL": "26",
+        "TARGET_BOARD_API_LEVEL": "33",
+        "SOURCE_FIRMWARE": "SM-A376B/XXV/LOCAL",
+        "SOURCE_FIRMWARE_CACHE_SUFFIX": "A376BXXU5BZI6",
+        "TARGET_OS_FILE_SYSTEM_TYPE": "ext4",
+        "EXYNOS9810_M4_RUNTIME_COMPAT": "true",
+        "EXYNOS9810_ENABLE_METADATA_BIND": "true",
+        "EXYNOS9810_ENABLE_KERNELSU_RUNTIME": "false",
+    }
+    for key, value in expected.items():
+        if os.environ.get(key) != value:
+            raise ValueError("Unreviewed M4 runtime scope: " + key)
+    for key in ("EXYNOS9810_M2_RUNTIME_COMPAT", "EXYNOS9810_M2_BOOTSTRAP_COMPAT"):
+        if os.environ.get(key, "false") != "false":
+            raise ValueError("Mixed M2/M4 runtime selection: " + key)
+
+
+def source_root(path):
+    root = Path(path)
+    expected = manifest()["source_firmware_marker"]
+    marker = root / ".extracted"
+    if not marker.is_file() or marker.read_text().strip() != expected:
+        raise ValueError("BZI6 runtime donor marker mismatch")
+    return root
+
+
+def verify_source(donor):
+    m = manifest()
+    donor = source_root(donor)
+    for rel, expected in m["files"].items():
+        if digest(donor / rel) != expected:
+            raise ValueError("BZI6 runtime source hash mismatch: " + rel)
+    for rel, expected in m.get("adb_source_files", {}).items():
+        if digest(donor / rel) != expected:
+            raise ValueError("BZI6 ADB donor source hash mismatch: " + rel)
+    vendor_aconfig = donor / "vendor/etc/aconfig"
+    if m["aconfig_v2"]["vendor_source_absent"] and vendor_aconfig.exists():
+        raise ValueError("BZI6 unexpectedly contains vendor aconfig input")
+    for rel in ("system/system/etc/aconfig/package.map",
+                "system/system/etc/aconfig/flag.map",
+                "system/system/etc/aconfig/flag.val",
+                "system/system/etc/aconfig/flag.info"):
+        data = (donor / rel).read_bytes()
+        if len(data) < 15 or struct.unpack_from("<I", data, 0)[0] != 2:
+            raise ValueError("BZI6 aconfig table is not storage v2: " + rel)
+        if data[8:14] != b"system":
+            raise ValueError("BZI6 aconfig table container mismatch: " + rel)
+    print("PASS BZI6 marker, locked Android17 inputs and system aconfig v2 provenance")
+
+
+def donor_account_rows(donor):
+    expected = manifest()["vendor_kg_accounts"]
+    rows = {}
+    for kind in ("passwd", "group"):
+        path = donor / "vendor/etc" / kind
+        if digest(path) != expected[kind + "_sha256"]:
+            raise ValueError("BZI6 vendor " + kind + " source hash mismatch")
+        wanted = expected[kind + "_line"]
+        lines = path.read_text().splitlines()
+        named = [line for line in lines if line.split(":", 1)[0] == "vendor_kg"]
+        identified = []
+        for line in lines:
+            fields = line.split(":")
+            try:
+                uid_or_gid = int(fields[2])
+            except (IndexError, ValueError):
+                continue
+            if uid_or_gid == 5959:
+                identified.append(line)
+        if named != [wanted] or identified != [wanted]:
+            raise ValueError("BZI6 vendor " + kind + " has an unreviewed vendor_kg row")
+        rows[kind] = wanted
+    return rows
+
+
+def merge_account(path, kind, wanted):
+    path = Path(path)
+    lines = path.read_text().splitlines() if path.exists() else []
+    named = []
+    identified = []
+    for line in lines:
+        fields = line.split(":")
+        try:
+            uid_or_gid = int(fields[2])
+        except (IndexError, ValueError):
+            continue
+        if fields[0] == "vendor_kg":
+            named.append(line)
+        if uid_or_gid == 5959:
+            identified.append(line)
+    if named or identified:
+        if named == [wanted] and identified == [wanted]:
+            return
+        raise ValueError("Hybrid Vendor " + kind + " has a conflicting vendor_kg UID/GID 5959")
+    prefix = "\n" if lines and path.read_bytes()[-1:] != b"\n" else ""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("a") as output:
+        output.write(prefix + wanted + "\n")
+
+
+def verify_vendor_account(work):
+    expected = manifest()["vendor_kg_accounts"]
+    for kind in ("passwd", "group"):
+        lines = (Path(work) / "vendor/etc" / kind).read_text().splitlines()
+        wanted = expected[kind + "_line"]
+        named = [line for line in lines if line.split(":", 1)[0] == "vendor_kg"]
+        identified = []
+        for line in lines:
+            fields = line.split(":")
+            try:
+                uid_or_gid = int(fields[2])
+            except (IndexError, ValueError):
+                continue
+            if uid_or_gid == 5959:
+                identified.append(line)
+        if named != [wanted] or identified != [wanted]:
+            raise ValueError("Final M4 Hybrid Vendor " + kind + " account row mismatch")
+
+
+def empty_vendor_flags():
+    spec = importlib.util.spec_from_file_location(
+        "a376b_empty_vendor_flags", HERE / "a376b_empty_vendor_flags.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.empty_files()
+
+
+def stage_vendor_flags(work):
+    destination = Path(work) / "vendor/etc/aconfig"
+    files = empty_vendor_flags()
+    if destination.exists():
+        if destination.is_symlink() or not destination.is_dir():
+            raise ValueError("Unreviewed M4 vendor aconfig destination")
+        if any(p.name not in files for p in destination.iterdir()):
+            raise ValueError("Unknown M4 vendor aconfig file")
+        for name, data in files.items():
+            path = destination / name
+            if path.exists() and (path.is_symlink() or path.read_bytes() != data):
+                raise ValueError("Refusing to overwrite nonempty vendor aconfig " + name)
+    destination.mkdir(parents=True, exist_ok=True)
+    for name, data in files.items():
+        path = destination / name
+        if not path.exists():
+            path.write_bytes(data)
+        path.chmod(0o444)
+
+
+def apply(work, donor):
+    scope()
+    donor = source_root(donor)
+    verify_source(donor)
+    work = Path(work)
+    m = manifest()
+    rows = donor_account_rows(donor)
+    for rel, expected in m["files"].items():
+        source = donor / rel
+        destination = work / rel
+        if destination.exists() or destination.is_symlink():
+            if destination.is_symlink() or digest(destination) != expected:
+                raise ValueError("Refusing unreviewed M4 runtime destination: " + rel)
+        else:
+            destination.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copyfile(source, destination)
+    for kind in ("passwd", "group"):
+        merge_account(work / "vendor/etc" / kind, kind, rows[kind])
+    verify_vendor_account(work)
+    stage_vendor_flags(work)
+    print("PASS staged donor-native M4 camera/audio/V7/Tethering, vendor_kg and empty vendor aconfig v2")
+
+
+def verify(work, donor):
+    scope()
+    donor = source_root(donor)
+    verify_source(donor)
+    work = Path(work)
+    for rel, expected in manifest()["files"].items():
+        path = work / rel
+        if not path.is_file() or path.is_symlink() or digest(path) != expected:
+            raise ValueError("Final M4 runtime input mismatch: " + rel)
+    verify_vendor_account(work)
+    flags = empty_vendor_flags()
+    directory = work / "vendor/etc/aconfig"
+    if not directory.is_dir() or {p.name for p in directory.iterdir()} != set(flags):
+        raise ValueError("Final M4 vendor aconfig file set mismatch")
+    for name, data in flags.items():
+        if (directory / name).read_bytes() != data:
+            raise ValueError("Final M4 empty vendor aconfig v2 file mismatch: " + name)
+    canonical = work / "vendor/etc/init/hw/init.samsungexynos9810.rc"
+    secondary = work / "vendor/etc/init/init.samsungexynos9810.rc"
+    bind = "mount none /cache/metadata /metadata bind"
+    if canonical.read_text().count(bind) != 1:
+        raise ValueError("Final M4 persistent CACHE metadata bind missing or duplicated")
+    if bind in secondary.read_text():
+        raise ValueError("Final M4 secondary vendor init duplicates metadata bind")
+    contexts = (work / "system/system/etc/selinux/plat_file_contexts").read_text()
+    if "# UN1CA M4 CACHE metadata label aliases BEGIN" not in contexts or \
+            "# UN1CA M4 CACHE metadata label aliases END" not in contexts:
+        raise ValueError("Final M4 CACHE metadata label aliases missing")
+    print("PASS final M4 donor-native runtime closure, vendor_kg account and aconfig v2 set")
+
+
+def self_test(donor):
+    verify_source(donor)
+    import tempfile
+    with tempfile.TemporaryDirectory(prefix="m4-runtime-compat-") as td:
+        root = Path(td)
+        donor = source_root(donor)
+        for rel in manifest()["files"]:
+            dst = root / rel
+            dst.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copyfile(donor / rel, dst)
+        (root / "vendor/etc").mkdir(parents=True)
+        anchor = "    mount_all /vendor/etc/fstab.${ro.hardware} --early\n"
+        canonical = root / "vendor/etc/init/hw/init.samsungexynos9810.rc"
+        secondary = root / "vendor/etc/init/init.samsungexynos9810.rc"
+        canonical.parent.mkdir(parents=True, exist_ok=True)
+        canonical.write_text("on fs\n" + anchor)
+        secondary.parent.mkdir(parents=True, exist_ok=True)
+        secondary.write_text("on fs\n" + anchor)
+        contexts = root / "system/system/etc/selinux/plat_file_contexts"
+        contexts.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(donor / "system/system/etc/selinux/plat_file_contexts", contexts)
+        for kind in ("passwd", "group"):
+            (root / "vendor/etc" / kind).write_text("existing_test::5900:5900::/:/bin/sh\n"
+                                                    if kind == "passwd" else "existing_test::5900:\n")
+        apply(root, donor)
+        metadata_spec = importlib.util.spec_from_file_location(
+            "a376b_metadata_bind", HERE / "a376b_metadata_bind.py")
+        metadata_module = importlib.util.module_from_spec(metadata_spec)
+        metadata_spec.loader.exec_module(metadata_module)
+        metadata_module.apply(root, "M4")
+        first = {p.relative_to(root).as_posix(): p.read_bytes()
+                 for p in (root / "vendor/etc/aconfig").iterdir()}
+        apply(root, donor)
+        verify(root, donor)
+        if first != {p.relative_to(root).as_posix(): p.read_bytes()
+                     for p in (root / "vendor/etc/aconfig").iterdir()}:
+            raise ValueError("M4 aconfig staging is not idempotent")
+        bad = root / "system/system/bin/cameraserver"
+        bad.write_bytes(b"unreviewed camera server")
+        try:
+            apply(root, donor)
+        except ValueError:
+            pass
+        else:
+            raise ValueError("Unreviewed cameraserver overwrite accepted")
+        for kind in ("passwd", "group"):
+            path = root / "vendor/etc" / kind
+            path.write_text("collision::5959:5959::/:/bin/sh\n" if kind == "passwd"
+                            else "collision::5959:\n")
+            try:
+                merge_account(path, kind, manifest()["vendor_kg_accounts"][kind + "_line"])
+            except ValueError:
+                pass
+            else:
+                raise ValueError("vendor_kg UID/GID collision accepted for " + kind)
+        (root / "vendor/etc/aconfig/unreviewed.bin").write_bytes(b"x")
+        try:
+            stage_vendor_flags(root)
+        except ValueError:
+            pass
+        else:
+            raise ValueError("Unknown vendor aconfig input accepted")
+    print("PASS M4 apply/verify idempotence, camera replacement, account collision and unknown-table rejection")
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("mode", choices=("apply", "verify", "self-test"))
+    parser.add_argument("--work-dir", type=Path, required=True)
+    parser.add_argument("--donor-root", type=Path, required=True)
+    args = parser.parse_args()
+    if args.mode == "apply":
+        apply(args.work_dir, args.donor_root)
+    elif args.mode == "verify":
+        verify(args.work_dir, args.donor_root)
+    else:
+        scope()
+        self_test(args.donor_root)

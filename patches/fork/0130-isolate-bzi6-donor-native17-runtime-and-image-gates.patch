+++ b/scripts/internal/verify_m4_runtime_image.py
@@ -0,0 +1,115 @@
+#!/usr/bin/env python3
+"""Verify donor-native M4 runtime files and metadata inside real ext4 images.
+
+Reason: catch last-minute replacement or metadata loss after filesystem packing.
+Files: temporary debugfs extracts only; the image is read-only.
+Verify locked BZI6 camera/runtime files, vendor account/aconfig and mount bytes.
+"""
+from pathlib import Path
+import argparse
+import hashlib
+import importlib.util
+import json
+import os
+import re
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+HELPER = ROOT / "unica/patches/exynos9810_device_stack/exynos9810_boot_restore/a376b_android17_runtime_compat.py"
+
+
+def metadata(partition, rel):
+    if partition == "system":
+        exact = {
+            "system/bin/cameraserver": (0o755, (0, 2000), "cameraserver_exec"),
+            "system/priv-app/SamsungCamera/SamsungCamera.apk": (0o644, (0, 0), "system_file"),
+            "system/lib64/libaudiobase.so": (0o644, (0, 0), "system_lib_file"),
+            "system/lib64/libaudioclient.so": (0o644, (0, 0), "system_lib_file"),
+            "system/lib64/android.hardware.graphics.common-V7-ndk.so": (0o644, (0, 0), "system_lib_file"),
+            "system/apex/com.google.android.tethering_compressed.apex": (0o644, (0, 0), "system_file"),
+            "system/etc/init/aconfigd.rc": (0o644, (0, 0), "system_file"),
+            "system/etc/aconfig/package.map": (0o644, (0, 0), "system_aconfig_storage_file"),
+            "system/etc/aconfig/flag.map": (0o644, (0, 0), "system_aconfig_storage_file"),
+            "system/etc/aconfig/flag.val": (0o644, (0, 0), "system_aconfig_storage_file"),
+            "system/etc/aconfig/flag.info": (0o644, (0, 0), "system_aconfig_storage_file"),
+        }
+        return exact[rel]
+    if rel == "etc/aconfig":
+        return 0o755, (0, 0), "vendor_aconfig_storage_file", "directory"
+    if rel.startswith("etc/aconfig/"):
+        return 0o444, (0, 0), "vendor_aconfig_storage_file"
+    if rel in ("etc/passwd", "etc/group"):
+        return 0o644, (0, 0), "vendor_configs_file"
+    if rel in ("etc/init/hw/init.samsungexynos9810.rc", "etc/init/init.samsungexynos9810.rc"):
+        return 0o644, (0, 0), None
+    raise ValueError("Unreviewed M4 image path: " + partition + "/" + rel)
+
+
+def run(command):
+    result = subprocess.run(command, capture_output=True, text=True, check=True)
+    return result.stdout + result.stderr
+
+
+def verify(image, partition, work):
+    if os.environ.get("ROM_SOURCE_CONFIG") != "essi_a376b_android17" or \
+            os.environ.get("ROM_MILESTONE") != "M4" or \
+            os.environ.get("EXYNOS9810_M4_RUNTIME_COMPAT") != "true":
+        raise ValueError("M4 runtime image gate requires the exact BZI6 profile")
+    if os.environ.get("TARGET_OS_FILE_SYSTEM_TYPE") != "ext4":
+        raise ValueError("M4 runtime image gate is reviewed for ext4 only")
+    work = Path(work)
+    donor = ROOT / "out/fw/SM-A376B_XXV_A376BXXU5BZI6"
+    spec = importlib.util.spec_from_file_location("m4_runtime", HELPER)
+    runtime = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(runtime)
+    runtime.verify(work, donor)
+    if partition == "system":
+        paths = [rel.removeprefix("system/") for rel in runtime.manifest()["files"]
+                 if rel.startswith("system/system/")]
+    elif partition == "vendor":
+        paths = ["etc/passwd", "etc/group", "etc/init/hw/init.samsungexynos9810.rc",
+                 "etc/init/init.samsungexynos9810.rc", "etc/aconfig"]
+        paths += ["etc/aconfig/" + name for name in ("package.map", "flag.map", "flag.val", "flag.info")]
+    else:
+        return
+    checks = []
+    with tempfile.TemporaryDirectory(prefix="m4-runtime-image-") as td:
+        for index, rel in enumerate(paths):
+            local = work / partition / rel
+            is_directory = partition == "vendor" and rel == "etc/aconfig"
+            extracted = Path(td) / str(index)
+            if is_directory:
+                if not local.is_dir() or local.is_symlink():
+                    raise ValueError("M4 work directory missing: " + partition + "/" + rel)
+            else:
+                run(["debugfs", "-R", f"dump /{rel} {extracted}", str(image)])
+                if not extracted.is_file() or extracted.read_bytes() != local.read_bytes():
+                    raise ValueError("M4 image bytes differ: " + partition + "/" + rel)
+            expected = metadata(partition, rel)
+            mode, owner, label = expected[:3]
+            expected_type = expected[3] if len(expected) > 3 else "regular"
+            stat = run(["debugfs", "-R", f"stat /{rel}", str(image)])
+            found_mode = re.search(r"Type:\s+" + expected_type + r"\s+Mode:\s+(\d+)", stat)
+            found_owner = re.search(r"User:\s+(\d+)\s+Group:\s+(\d+)", stat)
+            if not found_mode or int(found_mode[1], 8) != mode:
+                raise ValueError("M4 image mode/type mismatch: " + rel + " " + stat)
+            if not found_owner or tuple(map(int, found_owner.groups())) != owner:
+                raise ValueError("M4 image owner mismatch: " + rel)
+            if label:
+                selinux = run(["debugfs", "-R", f"ea_get /{rel} security.selinux", str(image)])
+                if "u:object_r:" + label + ":s0" not in selinux:
+                    raise ValueError("M4 image SELinux label mismatch: " + rel + " " + selinux)
+            checks.append({"path": partition + "/" + rel,
+                           "sha256": hashlib.sha256(extracted.read_bytes()).hexdigest() if extracted.exists() else None,
+                           "mode": mode, "owner": owner, "label": label})
+    print(json.dumps({"result": "PASS", "partition": partition, "checks": checks}))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--image", type=Path, required=True)
+    parser.add_argument("--partition", choices=("system", "vendor"), required=True)
+    parser.add_argument("--work-dir", type=Path, required=True)
+    args = parser.parse_args()
+    verify(args.image, args.partition, args.work_dir)

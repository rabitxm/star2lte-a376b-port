         runtime=ROOT/"unica/patches/exynos9810_device_stack/exynos9810_boot_restore/a376b_android17_runtime_compat.py"
         donor=ROOT/"out/fw/SM-A376B_XXV_A376BXXU5BZI6"
-        subprocess.run([sys.executable,str(runtime),"verify","--compiled-camera","--work-dir",str(work),"--donor-root",str(donor)],check=True)
+        postboot_diagnostic = os.environ.get("EXYNOS9810_M4_POSTBOOT_DIAGNOSTIC", "false") == "true"
+        if postboot_diagnostic:
+            if (target, os.environ.get("ROM_MILESTONE"),
+                    os.environ.get("STAR2LTE_BUILD_MODEL"),
+                    os.environ.get("EXYNOS9810_M4_RUNTIME_COMPAT")) != (
+                    "star2lte", "M4", "SM-G965F", "true"):
+                raise RuntimeError("Post-boot runtime exception is restricted to reviewed M4/G965F diagnostic profile")
+        spec=importlib.util.spec_from_file_location("a376b_android17_runtime_compat",runtime)
+        runtime_module=importlib.util.module_from_spec(spec);spec.loader.exec_module(runtime_module)
+        runtime_module.verify(work, donor, compiled_camera=True,
+                              allow_postboot_network=postboot_diagnostic)
+        if postboot_diagnostic:
+            postboot=ROOT/"unica/patches/exynos9810_device_stack/exynos9810_boot_restore/a376b_android17_postboot_diagnostic.py"
+            pspec=importlib.util.spec_from_file_location("a376b_android17_postboot_diagnostic",postboot)
+            postboot_module=importlib.util.module_from_spec(pspec);pspec.loader.exec_module(postboot_module)
+            postboot_module.verify(work, donor)
         donor_apps=ROOT/"unica/patches/exynos9810_device_stack/exynos9810_finalization/verify_bzi6_final_apps.py"

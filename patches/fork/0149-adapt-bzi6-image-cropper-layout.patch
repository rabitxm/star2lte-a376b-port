+            [ "${SOURCE_FIRMWARE_CACHE_SUFFIX:-}" != "A376BXXU5BZI6" ] || \
+            [ "${SOURCE_FIRMWARE:-}" != "SM-A376B/XXV/LOCAL" ] || \
+            [[ "${TARGET_FIRMWARE:-}" != SM-G965F/PHN/* ]]; then
+        LOGE "Unreviewed BZI6 ImageCropper dispatch scope"
+        return 1
+    fi
+
+    python3 - "$DONOR_ROOT" "$WORK_SMART_DIR" "$WORK_SCE_DIR" "$WORK_IMAGE_DIR" "$WORK_DIR" <<'PY' || return 1
+import hashlib
+import sys
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+donor, work_smart, work_sce, work_image, work = map(Path, sys.argv[1:])
+expected = {
+    "system/system/etc/floating_feature.xml": "76f9e27c92500562fe4163366c07b71e2ac41e510a57b643500e3a7b68aa1989",
+    "vendor/etc/floating_feature.xml": "59324c8572e9668db0d29cb09e7ab0247a6abff9a736d71fb447317d44933521",
+    "system/system/saiv/imageCropper/sce_detector_cnn.tflite": "5ee6feae9f8307b7f0c363ec6f41e764ef97b5d2afeb83e72714659268b887f5",
+    "system/system/lib64/libImageCropper.camera.samsung.so": "e5ab1aa650369208dd8113292c05f18313881196530425a637923f1e1ca55914",
+}
+for rel, digest in expected.items():
+    path = donor / rel
+    if not path.is_file() or hashlib.sha256(path.read_bytes()).hexdigest() != digest:
+        raise SystemExit("Unreviewed BZI6 ImageCropper input: " + rel)
+for rel in (
+    "system/system/saiv/smartcropping_2.0",
+    "vendor/saiv/image_understanding/db/sce_detector",

+# Keep the donor's ImageCropper model layout and the target Exynos9810 vendor model.
+A376B17_ADAPT_IMAGE_CROPPER()
+{
+    local DONOR_ROOT="$FW_DIR/$SOURCE_FIRMWARE_PATH"
+    local WORK_SMART_DIR="$WORK_DIR/system/system/saiv/smartcropping_2.0"
+    local WORK_IMAGE_DIR="$WORK_DIR/system/system/saiv/imageCropper"
+    local WORK_SCE_DIR="$WORK_DIR/vendor/saiv/image_understanding/db/sce_detector"
+
+    if [ "${ROM_SOURCE_CONFIG:-}" != "essi_a376b_android17" ] || \
+            [ "${ROM_MILESTONE:-}" != "M4" ] || \
+            [ "${TARGET_CODENAME:-}" != "star2lte" ] || \
+            [ "${STAR2LTE_BUILD_MODEL:-}" != "SM-G965F" ] || \
+            [ "${SOURCE_PLATFORM_SDK_VERSION:-}" != "37" ] || \
+            [ "${TARGET_PLATFORM_SDK_VERSION:-}" != "31" ] || \

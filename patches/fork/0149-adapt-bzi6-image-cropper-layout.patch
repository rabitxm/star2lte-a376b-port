+    if (donor / rel).exists():
+        raise SystemExit("BZI6 legacy ImageCropper path unexpectedly exists: " + rel)
+
+for rel in ("system/system/etc/floating_feature.xml", "vendor/etc/floating_feature.xml"):
+    root = ET.parse(donor / rel).getroot()
+    features = {node.tag: (node.text or "").strip() for node in root}
+    if features.get("SEC_FLOATING_FEATURE_VISION_CONFIG_IMAGE_CROPPER_VERSION") != "V1":
+        raise SystemExit("BZI6 ImageCropper feature is not enabled in " + rel)
+    if "SEC_FLOATING_FEATURE_VISION_CONFIG_SMART_CROPPING_SOLUTION" in features:
+        raise SystemExit("BZI6 unexpectedly advertises legacy smart cropping in " + rel)
+
+def verify_tree(directory, expected_files, label):
+    if not directory.is_dir():
+        raise SystemExit("Missing required " + label + " directory: " + str(directory))
+    files = {p.relative_to(directory).as_posix(): hashlib.sha256(p.read_bytes()).hexdigest()
+             for p in directory.rglob("*") if p.is_file()}
+    if files != expected_files:
+        raise SystemExit("Unreviewed " + label + " file set or hash")
+
+if work_smart.exists():
+    verify_tree(work_smart, {
+        "db/smartcrop_saliency_deploy.prototxt": "6f0d4daf03b3330941afdee6305401f6db717bfd0c4209a93e9820211fec8e88",
+        "db/smartcrop_saliency_train": "3046afb0a51ead841297f42a38cd3c7733fd7304f39a2fabdeff6bac966fb678",
+    }, "G965F legacy smartcropping")
+verify_tree(work_sce, {

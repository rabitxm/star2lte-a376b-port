+    features = {node.tag: (node.text or "").strip() for node in root}
+    if "SEC_FLOATING_FEATURE_VISION_CONFIG_SMART_CROPPING_SOLUTION" in features:
+        raise SystemExit("Staged work tree retains legacy smart-cropping feature: " + rel)
+if ET.parse(work / "vendor/etc/floating_feature.xml").getroot().findtext(
+        "SEC_FLOATING_FEATURE_VISION_CONFIG_IMAGE_CROPPER_VERSION") != "V1":

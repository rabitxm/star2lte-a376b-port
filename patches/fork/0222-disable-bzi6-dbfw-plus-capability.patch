+#!/usr/bin/env python3
+"""Use BZI6's existing unsupported-DBFW+ path on the measured G965F controller.
+
+Reason: skipping individual FDF1 sends left the DBFW+ initializer active and
+attempt0223/HFP-only trial still hit its HCI timeout. This is the BZI6 equivalent
+of the fork's existing legacy DBFW+ capability quirk, not a transport change.
+Files: two instructions in the exact capability setter of Bluetooth JNI.
+Verify: Build ID/function hash, store/branch semantics, disabled-path context,
+composition with the old A2DP skip, negative fixtures and final image/runtime.
+"""
+from pathlib import Path
+import argparse
+import hashlib
+import importlib.util
+import json
+import os
+import struct
+
+HERE = Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location('m4_fdf1', HERE / 'a376b_android17_fdf1_skip.py')
+fdf1 = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(fdf1)
+LOCK = json.loads((HERE / 'a376b_android17_dbfw_capability.lock.json').read_text())
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def signed(value, bits):
+    return value - (1 << bits) if value & (1 << (bits - 1)) else value
+
+
+def layout(data):
+    if fdf1.build_id(data) != LOCK['gnu_build_id']:
+        raise ValueError('DBFW+ quirk Build ID mismatch')
+    offset = fdf1.file_offset_for_va(data, int(LOCK['patch_va'], 16))
+    start = fdf1.file_offset_for_va(data, int(LOCK['context_start_va'], 16))
+    end = fdf1.file_offset_for_va(data, int(LOCK['context_end_va_exclusive'], 16) - 1) + 1
+    before = bytes.fromhex(LOCK['preimage_hex'])
+    after = bytes.fromhex(LOCK['replacement_hex'])
+    if len(before) != 8 or len(after) != 8:
+        raise ValueError('DBFW+ quirk must alter exactly two instructions')
+    store, tbz = struct.unpack('<II', before)
+    zero_store, branch = struct.unpack('<II', after)
+    if store & 31 or zero_store != store | 31:
+        raise ValueError('DBFW+ quirk must change only STRB w0 to STRB wzr')
+    if store & 0xfffffc00 != 0x39012000 or (store >> 5) & 31 != 20:
+        raise ValueError('DBFW+ capability destination is not the locked [x20,#0x48]')
+    if tbz & 0xfff8001f != 0x36000000 or branch & 0xfc000000 != 0x14000000:
+        raise ValueError('DBFW+ branch is not TBZ w0,#0 -> unconditional B')
+    branch_va = int(LOCK['patch_va'], 16) + 4
+    target = int(LOCK['disabled_path_va'], 16)
+    if branch_va + signed((tbz >> 5) & 0x3fff, 14) * 4 != target or branch_va + signed(branch & 0x3ffffff, 26) * 4 != target:
+        raise ValueError('DBFW+ quirk must use the original unsupported target')
+    disabled = fdf1.file_offset_for_va(data, target)
+    if data[disabled:disabled + 16].hex() != LOCK['disabled_path_first16_hex']:
+        raise ValueError('DBFW+ unsupported path no longer clears the secondary state')
+    return offset, start, end, before, after
+
+
+def patch_bytes(data):
+    offset, start, end, before, after = layout(data)
+    context = sha(data[start:end])
+    if data[offset:offset + 8] == after and context == LOCK['context_output_sha256']:
+        return data, 'already-patched'
+    if data[offset:offset + 8] != before or context != LOCK['context_preimage_sha256']:
+        raise ValueError('DBFW+ setter changed or contains the rejected HFP-only trial')
+    result = data[:offset] + after + data[offset + 8:]
+    if sha(result[start:end]) != LOCK['context_output_sha256']:
+        raise ValueError('DBFW+ patched function differs from lock')
+    return result, 'patched'
+
+
+def fixture():
+    fdf1.check_scope()
+    donor = fdf1.extract_donor_jni()
+    result, state = patch_bytes(donor)
+    assert state == 'patched' and sha(result) == LOCK['donor_quirk_sha256']
+    offset, start, _, _, _ = layout(donor)
+    assert result[:offset] == donor[:offset] and result[offset + 8:] == donor[offset + 8:]
+    assert patch_bytes(result) == (result, 'already-patched')
+    sender, _ = fdf1.patch_bytes(donor)
+    combined, _ = patch_bytes(sender)
+    assert sha(combined) == LOCK['donor_combined_sha256']
+    for where in [start, fdf1.file_offset_for_va(donor, 0x70c190)]:
+        wrong = bytearray(donor)
+        wrong[where] ^= 1
+        try:
+            patch_bytes(bytes(wrong))
+        except ValueError:
+            pass
+        else:
+            raise ValueError('Changed setter/HFP-only context was accepted')
+    print('PASS exact zero-store/original unsupported branch, two-instruction boundary, A2DP composition, idempotence and negative contexts')
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('command', choices=['fixture', 'apply', 'verify'])
+    parser.add_argument('--jni', type=Path)
+    parser.add_argument('--final-hash', action='store_true')
+    args = parser.parse_args()
+    fdf1.check_scope()
+    if args.command == 'fixture':
+        fixture()
+        return
+    if args.jni.is_symlink() or not args.jni.is_file():
+        raise ValueError('DBFW+ JNI file missing or symlinked')
+    data = args.jni.read_bytes()
+    result, state = patch_bytes(data)
+    if args.command == 'apply' and state == 'patched':
+        temp = args.jni.with_name(args.jni.name + '.dbfw.tmp')
+        temp.write_bytes(result)
+        temp.chmod(args.jni.stat().st_mode & 0o777)
+        os.replace(temp, args.jni)
+    if args.command == 'verify':
+        if state != 'already-patched':
+            raise ValueError('DBFW+ unsupported capability quirk is absent')
+        if args.final_hash and sha(data) != LOCK['final_work_jni_sha256']:
+            raise ValueError('DBFW+ composed final JNI hash mismatch')
+    print('PASS locked BZI6 DBFW+ unsupported-capability path: ' + state)
+
+
+if __name__ == '__main__':
+    main()

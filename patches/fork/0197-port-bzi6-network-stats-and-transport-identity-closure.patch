+"""Diagnostic network-stats API closure from locked BZI6 donor JARs.
+Reason: real StatsPullAtomService querySummary(NetworkTemplate;JJI) fatal.
+Keep old Binder service interfaces; donate transport identity/template persistence
+as one shared bootclasspath unit and retain old entry points explicitly.
+"""
+from pathlib import Path
+import re,shutil,zipfile,hashlib,json,importlib.util
+spec=importlib.util.spec_from_file_location('l4s_adapter',Path(__file__).with_name('a376b_android17_network_l4s.py'));l4s=importlib.util.module_from_spec(spec);spec.loader.exec_module(l4s)
+methods=l4s.methods;digest=l4s.digest
+
+def canonical(text):
+ result=l4s.canonical(text)
+ for key,body in result['methods'].items():
+  labels={}
+  def rename(match):
+   token=match.group()
+   if token.startswith('"'):return token
+   if token not in labels:labels[token]=':label_'+str(len(labels))
+   return labels[token]
+  # Ignore quoted strings and field/type colons; retain exact branch-target identity.
+  result['methods'][key]=re.sub(r'"(?:\\.|[^"\\])*"|(?<![\w$>;]):[A-Za-z0-9_]+',rename,body)
+ return result
+FULL=['android/net/NetworkTemplate.smali','android/net/NetworkTemplate$Builder.smali','android/net/NetworkIdentity.smali','android/net/NetworkIdentity$Builder.smali','android/net/connectivity/android/net/NetworkIdentitySet.smali']
+MANAGER='android/app/usage/NetworkStatsManager.smali'
+UTIL='android/net/connectivity/com/android/net/module/util/NetworkCapabilitiesUtils.smali'
+COLLECTION='android/net/connectivity/com/android/net/module/util/CollectionUtils.smali'
+NEW_METHODS=['querySummary(Landroid/net/NetworkTemplate;JJI)Landroid/app/usage/NetworkStats;','querySummaryForDevice(Landroid/net/NetworkTemplate;JJI)Landroid/app/usage/NetworkStats$Bucket;','queryTaggedSummary(Landroid/net/NetworkTemplate;JJI)Landroid/app/usage/NetworkStats;','sanitizeQueryFlags(I)I']
+EXPECTED={
+ 'old_main':'91e443b8a6705ac3f20d986b70b449ceee604a821a43cbdb80ed07a2c4b4b4c7',
+ 'new_main':'391f21176a39a112285efe9b492fdb8d50b3c1dc36b5ea4f07da7dabe91c3b33',
+ 'old_t':'2953c4396e9a9548e00be6b5ed610b8b62e0ea01da78543d9ec8d76f09487830',
+ 'new_t':'fae20cc45231ef0fc887db4e5363c62a939798d6fbe8731b7064f2f035839393'}
+
+def add_field(text,donor,name,section):
+ line=re.findall(r'^\.field [^\n]* '+re.escape(name)+r':[^\n]*$',donor,re.M);assert len(line)==1
+ assert not re.search(r'^\.field [^\n]* '+re.escape(name)+r':',text,re.M)
+ assert text.count(section)==1
+ return text.replace(section,section+'\n'+line[0]+'\n',1)
+
+def apply(old_main,new_main,old_t,new_t,output,tools,run):
+ output=Path(output);output.mkdir(exist_ok=False);base=['java','-cp',tools/'apktool.jar']
+ jars={'old_main':old_main,'new_main':new_main,'old_t':old_t,'new_t':new_t}
+ for tag,p in jars.items():
+  assert digest(p)==EXPECTED[tag],tag
+  with zipfile.ZipFile(p) as z:
+   assert [n for n in z.namelist() if re.fullmatch(r'classes\d*\.dex',n)]==['classes.dex']
+   dex=z.read('classes.dex');assert dex[:8]==b'dex\n039\0';(output/(tag+'.dex')).write_bytes(dex)
+  run(base+['com.android.tools.smali.baksmali.Main','disassemble','-a','29','-l','-j','8','-o',output/tag,output/(tag+'.dex')])
+ main=output/'main';t=output/'t';shutil.copytree(output/'old_main',main);shutil.copytree(output/'old_t',t)
+ # Shared donor unit: live transport capture, generic matching, Parcel and v7/v8 disk IO.
+ for rel in FULL:shutil.copyfile(output/'new_t'/rel,t/rel)
+ # Preserve the legacy NetworkTemplate constructor, initializing its new bitset to zero.
+ rel=FULL[0];orig=methods((output/'old_t'/rel).read_text());ctor='<init>(I[Ljava/lang/String;[Ljava/lang/String;IIIII)V'
+ body=orig[ctor];assert '.locals 3' in body and body.count('return-void')==1
+ body=body.replace('    return-void','    const-wide/16 v0, 0x0\n\n    iput-wide v0, p0, Landroid/net/NetworkTemplate;->mTransportTypesBits:J\n\n    return-void')
+ p=t/rel;p.write_text(p.read_text()+'\n'+body+'\n')
+ # Legacy identity constructors deduce transports with the donor's actual conversion.
+ rel=FULL[2];orig_text=(output/'old_t'/rel).read_text();ctor='<init>(IILjava/lang/String;Ljava/lang/String;ZZZII)V';body=methods(orig_text)[ctor]
+ assert '.locals 0' in body and body.count('return-void')==1
+ body=body.replace('.locals 0','.locals 3').replace('    return-void','''    invoke-static {p1}, Landroid/net/connectivity/com/android/net/module/util/NetworkCapabilitiesUtils;->deduceTransportTypeForLegacyNetworkType(I)I
+    move-result v0
+    const/4 v1, -0x1
+    if-eq v0, v1, :compat_unknown_transport
+    filled-new-array {v0}, [I
+    move-result-object v0
+    invoke-static {v0}, Landroid/net/connectivity/com/android/net/module/util/BitUtils;->packBits([I)J
+    move-result-wide v1
+    goto :compat_store_transport
+    :compat_unknown_transport
+    const-wide/16 v1, 0x0
+    :compat_store_transport
+    iput-wide v1, p0, Landroid/net/NetworkIdentity;->mTransportTypesBits:J
+    return-void''')
+ p=t/rel;s=add_field(p.read_text(),orig_text,'TYPE_TEST','# static fields');p.write_text(s+'\n'+body+'\n')
+ # All old service callers still use writeToStream(DataOutput). Store real bits (v8).
+ p=t/FULL[4];p.write_text(p.read_text()+'''
+.method public blacklist writeToStream(Ljava/io/DataOutput;)V
+    .locals 1
+    .annotation system Ldalvik/annotation/Throws;
+        value = {
+            Ljava/io/IOException;
+        }
+    .end annotation
+    const/4 v0, 0x1
+    invoke-virtual {p0, p1, v0}, Landroid/net/connectivity/android/net/NetworkIdentitySet;->writeToStream(Ljava/io/DataOutput;Z)V
+    return-void
+.end method
+''')
+ # Retain S22 manager and ctor; its existing ctor calls setAugment(true).
+ # Donor setter preserves mFlags and also initializes/synchronizes the new boolean.
+ p=t/MANAGER;s=p.read_text();donor=(output/'new_t'/MANAGER).read_text();om=methods(s);dm=methods(donor)
+ assert not set(NEW_METHODS)&om.keys()
+ s=add_field(s,donor,'mAugmentWithSubscriptionPlan','# instance fields');s=add_field(s,donor,'MASK_REQUESTABLE_FLAGS','# static fields')
+ setter='setAugmentWithSubscriptionPlan(Z)V';s=s.replace(om[setter],dm[setter]);assert methods(s)[setter]==dm[setter]
+ for name in NEW_METHODS:s+='\n'+dm[name]+'\n'
+ p.write_text(s)
+ for rel,name in [(UTIL,'deduceTransportTypeForLegacyNetworkType(I)I'),(COLLECTION,'intArrayToSet([I)Ljava/util/Set;')]:
+  p=main/rel;s=p.read_text();assert name not in methods(s);p.write_text(s+'\n'+methods((output/'new_main'/rel).read_text())[name]+'\n')
+ targets={};roundtrip={};changed={}
+ for tag,work,oldjar in [('main',main,old_main),('t',t,old_t)]:
+  dex=output/(tag+'-classes.dex');assembly=run(base+['com.android.tools.smali.smali.Main','assemble','-a','29','-j','1','-o',dex]+sorted(work.rglob('*.smali'),key=str));(output/(tag+'-assemble.txt')).write_text(assembly);assert dex.is_file() and dex.read_bytes()[:8]==b'dex\n039\0',assembly
+  verify=output/(tag+'-verified');run(base+['com.android.tools.smali.baksmali.Main','disassemble','-a','29','-l','-j','8','-o',verify,dex])
+  rels={str(p.relative_to(work)) for p in work.rglob('*.smali')};assert rels=={str(p.relative_to(verify)) for p in verify.rglob('*.smali')}
+  oldroot=output/('old_main' if tag=='main' else 'old_t');changed[tag]=[]
+  for rel in sorted(rels):
+   want=canonical((work/rel).read_text());got=canonical((verify/rel).read_text());assert want==got,(tag,rel)
+   previous=canonical((oldroot/rel).read_text());assert previous['methods'].keys()<=got['methods'].keys(),(tag,rel,'old method lost')
+   oldfields={x.split(' = ')[0].split()[-1] for x in previous['fields']};newfields={x.split(' = ')[0].split()[-1] for x in got['fields']};assert oldfields<=newfields,(tag,rel,'old field/type lost')
+   for signature,body in previous['methods'].items():
+    assert (' static ' in body.splitlines()[0])==(' static ' in got['methods'][signature].splitlines()[0]),(tag,rel,signature,'static ABI changed')
+   if previous!=got:changed[tag].append(rel)
+  assert changed[tag]==sorted([UTIL,COLLECTION] if tag=='main' else FULL+[MANAGER]),changed
+  target=output/('framework-connectivity.jar' if tag=='main' else 'framework-connectivity-t.jar')
+  with zipfile.ZipFile(oldjar) as src,zipfile.ZipFile(target,'w') as dst:
+   for entry in src.infolist():dst.writestr(entry,dex.read_bytes() if entry.filename=='classes.dex' else src.read(entry))
+  with zipfile.ZipFile(oldjar) as src,zipfile.ZipFile(target) as dst:
+   assert src.namelist()==dst.namelist()
+   for n in src.namelist():
+    if n!='classes.dex':assert src.read(n)==dst.read(n)
+  targets[tag]=target;roundtrip[tag]=len(rels)
+ report={'result':'PASS','classes_verified':roundtrip,'changed_classes':changed,'all_old_method_and_field_names_retained':True,'stats_bodies':'exact donor query overloads, sanitizer and augment setter','donated_transport_unit':FULL,'compatibility_entry_points':['legacy template ctor zero bitset','legacy identity ctor donor transport deduction','legacy IdentitySet writer real v8 bitsets'],'output_sha256':{k:digest(v) for k,v in targets.items()},'runtime_acceptance':False}
+ (output/'report.json').write_text(json.dumps(report,indent=2)+'\n');return targets,report

-    r'Ljava/lang/String;\)Ljava/lang/String;\s*\n'
-    r'\s*\n'
-    r'\s*move-result-object \1\s*\n'
+    r'(?m)^[ \t]*const-string(?:/jumbo)? ([vp]\d+), "ril\.product_code"\r?\n'

+#!/usr/bin/env python3
+"""Guard BZI6 optional camera claims without removing its GPPM package."""
+
+from hashlib import sha256
+from pathlib import Path
+import os
+import sys
+import xml.etree.ElementTree as ET
+
+
+FEATURES = (
+    "SEC_FLOATING_FEATURE_CAMERA_CONFIG_ACTION_CLASSIFIER",
+    "SEC_FLOATING_FEATURE_SAIV_CONFIG_ARDOODLE_LIB",
+)
+ABSENT = (
+    "lib64/libVideoClassifier.camera.samsung.so",
+    "lib64/libtensorflowLite2_11_0_dynamic_camera.so",
+    "etc/ardoodle",
+    "lib64/lib_pet_detection.arcsoft.so",
+)
+GPPM = "priv-app/GlobalPostProcMgr/GlobalPostProcMgr.apk"
+FLOATING_SHA = "76f9e27c92500562fe4163366c07b71e2ac41e510a57b643500e3a7b68aa1989"
+GPPM_SHA = "409b23d911d63addc7ead0abae8771df5782474428c31eff746bb684388d488b"
+
+
+def scope():
+    expected = {
+        "ROM_SOURCE_CONFIG": "essi_a376b_android17",
+        "ROM_MILESTONE": "M4",
+        "TARGET_CODENAME": "star2lte",
+        "TARGET_PLATFORM": "exynos9810",
+        "STAR2LTE_BUILD_MODEL": "SM-G965F",
+        "SOURCE_PLATFORM_SDK_VERSION": "37",
+        "SOURCE_FIRMWARE_CACHE_SUFFIX": "A376BXXU5BZI6",
+        "SOURCE_FIRMWARE": "SM-A376B/XXV/LOCAL",
+    }
+    for key, value in expected.items():
+        if os.environ.get(key) != value:
+            raise ValueError("Unreviewed BZI6 camera scope: " + key)
+
+
+def no_claims(path):
+    root = ET.parse(path).getroot()
+    for key in FEATURES:
+        for item in root.iter(key):
+            if (item.text or "").strip():
+                raise ValueError(f"Unsupported camera claim {key} in {path}")
+
+
+def no_implementation(system):
+    for relative in ABSENT:
+        path = system / relative
+        if path.exists() or path.is_symlink():
+            raise ValueError("BZI6 optional camera layout changed: " + relative)
+
+
+def verify_source(source):
+    marker = (source / ".extracted").read_text().strip()
+    if marker != "A376BXXU5BZI6/A376BOLM5BZI6/A376BXXU5BZI6":
+        raise ValueError("BZI6 camera source marker mismatch")
+    system = source / "system/system"
+    floating = system / "etc/floating_feature.xml"
+    if sha256(floating.read_bytes()).hexdigest() != FLOATING_SHA:
+        raise ValueError("BZI6 camera floating-feature hash mismatch")
+    no_claims(floating)
+    no_implementation(system)
+    if sha256((system / GPPM).read_bytes()).hexdigest() != GPPM_SHA:
+        raise ValueError("BZI6 GPPM positive input changed")
+    print("PASS BZI6 classifier/ARDoodle absent; donor GPPM present and pinned")
+
+
+def verify_work(work):
+    system = work / "system/system"
+    no_claims(system / "etc/floating_feature.xml")
+    no_claims(work / "vendor/etc/floating_feature.xml")
+    no_implementation(system)
+    if not (system / GPPM).is_file() or (system / GPPM).stat().st_size == 0:
+        raise ValueError("BZI6 GPPM was lost from the release work tree")
+    print("PASS M4 optional camera claims absent from final XML; GPPM retained")
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 3 or sys.argv[1] not in ("verify-source", "verify-work"):
+        raise SystemExit("usage: a376b_android17_features.py verify-source SOURCE | verify-work WORK")
+    scope()
+    {"verify-source": verify_source, "verify-work": verify_work}[sys.argv[1]](Path(sys.argv[2]))

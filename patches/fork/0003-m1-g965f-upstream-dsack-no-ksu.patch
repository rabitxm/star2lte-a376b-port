+# Source this file from the existing fork before sourcing buildenv.sh.
+# M1 keeps the S22 donor and Hybrid Vendor. The user selected the original
+# duhansysl OneUI7 enforcing prebuilt without KernelSU; no kernel is rebuilt.
+_STAR2LTE_M1_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"
+export STAR2LTE_BUILD_MODEL="SM-G965F"
+export EXYNOS9810_TARGET_OS_FILE_SYSTEM_TYPE="ext4"
+export EXYNOS9810_BUILD_KERNELSU_RUNTIME="false"
+export EXYNOS9810_KERNEL_ZIP="$_STAR2LTE_M1_ROOT/../inputs/kernels/DS-ACK-V1.12-08.05.2026-Enforcing-OneUI7.zip"
+export EXYNOS9810_EXPECTED_KERNEL_SHA256="9a6bad44f3a1a14d43f108fcebeeedfc1b924685f7f13931d902077bceb5c072"
+if [ ! -f "$EXYNOS9810_KERNEL_ZIP" ]; then
+    printf 'Missing the pinned duhansysl non-KernelSU prebuilt.\n' >&2
+    return 1
+fi
+_STAR2LTE_M1_HASH="$(sha256sum "$EXYNOS9810_KERNEL_ZIP")"
+if [ "${_STAR2LTE_M1_HASH%% *}" != "$EXYNOS9810_EXPECTED_KERNEL_SHA256" ]; then
+    printf 'The selected duhansysl prebuilt does not match the pinned SHA-256.\n' >&2
+    return 1
+fi
+unset _STAR2LTE_M1_ROOT _STAR2LTE_M1_HASH

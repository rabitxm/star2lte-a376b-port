+        if [ "$TARGET_PLATFORM" != "exynos9810" ]; then
+            cat "$TMP_DIR/bootimg-unpack.log" >&2
+            return 1
+        fi
+        # Inspect the original legacy payload for feature checks only. The
+        # source boot image and selected DS-ACK package are never modified.
+        LOGW "$(tail -n 1 "$TMP_DIR/bootimg-unpack.log"); reading legacy Exynos9810 kernel payload"
+        python3 - "$TMP_DIR/boot.img" "$TMP_DIR/out/kernel" <<'PYBOOT' || return 1
+import pathlib
+import struct
+import sys
+
+source, output = map(pathlib.Path, sys.argv[1:])
+with source.open('rb') as image:
+    header = image.read(48)
+    if len(header) != 48 or header[:8] != b'ANDROID!':
+        raise SystemExit('Invalid legacy Android boot header')
+    size = struct.unpack_from('<I', header, 8)[0]
+    page = struct.unpack_from('<I', header, 36)[0]
+    if page not in (2048, 4096, 8192, 16384, 32768, 65536) or size == 0:
+        raise SystemExit('Invalid legacy kernel size/page size')
+    if page + size > source.stat().st_size:
+        raise SystemExit('Truncated legacy kernel payload')
+    image.seek(page)
+    payload = image.read(size)
+output.parent.mkdir(parents=True, exist_ok=True)
+output.write_bytes(payload)
+PYBOOT
+    fi
 
     EVAL "rm \"$TMP_DIR/boot.img\""
 

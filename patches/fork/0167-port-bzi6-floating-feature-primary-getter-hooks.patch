From: Codex <codex@openai.com>
Subject: [PATCH] Port BZI6 FloatingFeature primary getter hooks

# Reason: settings-static-after-0166.txt:21 fails the legacy default-value getter body. Actual BZI6 getBoolean(String,Z), getInt(String,I), getString(String,String) delegate to their primary getters. Hook only the three hash-pinned primary getters and preserve overload delegation; retain the upstream FloatingFeatureHooks class unchanged.
# Affected: scripts/internal/apply_modules.sh and unica/mods/settings/a376b_android17/0001-Introduce-BZI6-FloatingFeatureHooks.patch.
# Verify: actual BZI6 class preimage, primary hook calls, unchanged overloads, changed-preimage/wrong-scope negatives, helper class and DEX assembly; source-lock/replay and clean compiled output.
# Rollback: remove0167 from series/source lock and restore previous dispatcher; no kernel/vendor/radio changes.

--- a/scripts/internal/apply_modules.sh
+++ b/scripts/internal/apply_modules.sh
@@ -451,6 +451,23 @@
             return 1
         fi
             LOGW "BZI6 MultiSound selection methods differ; retaining donor app-selection limit"
+            continue
+        fi
+        # BZI6 default-value overloads delegate to the three primary getters.
+        if [ "${ROM_SOURCE_CONFIG:-}" = essi_a376b_android17 ] && \
+                [[ "$p" == */settings/smali/system/framework/framework.jar/0003-Introduce-FloatingFeatureHooks.patch ]]; then
+            IS_A376B_M4_BOOT_TEST && [ "${TARGET_PLATFORM_SDK_VERSION:-}" = 31 ] && \
+                [ "${TARGET_BOARD_API_LEVEL:-}" = 33 ] || { LOGE "Unreviewed BZI6 FloatingFeature hook scope"; return 1; }
+            python3 - "$APKTOOL_DIR/system/framework/framework.jar" <<'PYBZI6FF' || return 1
+from pathlib import Path
+import hashlib,sys
+paths=list(Path(sys.argv[1]).glob("smali*/com/samsung/android/feature/SemFloatingFeature.smali"))
+if len(paths)!=1 or hashlib.sha256(paths[0].read_bytes()).hexdigest()!="0ca22777aef109dc711bd030c7afc5127d78f79b3adcbb9b05f93c62092e99ae":
+    raise SystemExit("Unreviewed BZI6 SemFloatingFeature preimage")
+print("PASS reviewed BZI6 FloatingFeature primary/delegating getter layout")
+PYBZI6FF
+            APPLY_PATCH "$PARTITION" "$FILE" \
+                "$SRC_DIR/unica/mods/settings/a376b_android17/0001-Introduce-BZI6-FloatingFeatureHooks.patch" || return 1
             continue
         fi
         APPLY_PATCH "$PARTITION" "$FILE" "$p"

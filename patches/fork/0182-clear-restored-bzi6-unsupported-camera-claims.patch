+def apply_work(work):
+    # Earlier camera selection clears the claims, but the final vendor
+    # restore reinstates the embedded S22 values. Reconcile only the two
+    # reviewed baseline values after all feature/overlay restoration.
+    no_implementation(work / "system/system")
+    expected = dict(zip(FEATURES, ("1,0", "PET_DETECTION,IMG_PICKING")))
+    pending = []
+    for rel in ("system/system/etc/floating_feature.xml", "vendor/etc/floating_feature.xml"):
+        path = work / rel
+        text = path.read_text()
+        root = ET.fromstring(text)
+        for key in FEATURES:
+            nodes = list(root.iter(key))
+            if len(nodes) > 1:
+                raise ValueError("Duplicate M4 camera feature: " + key)
+            if not nodes or not (nodes[0].text or "").strip():
+                continue
+            if rel.startswith("system/") or nodes[0].text.strip() != expected[key]:
+                raise ValueError("Unreviewed restored M4 camera claim: " + key)
+            text, count = re.subn(r"<" + key + r">[^<]*</" + key + r">", "", text)
+            if count != 1:
+                raise ValueError("Unexpected restored M4 feature XML shape: " + key)
+        ET.fromstring(text)
+        pending.append((path, text))
+    for path, text in pending:
+        path.write_text(text)
+    verify_work(work)
+    print("PASS final M4 camera claims reconciled after vendor restore; optional implementations remain absent")
+

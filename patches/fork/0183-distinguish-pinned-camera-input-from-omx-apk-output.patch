+def verify_camera_apk(work, donor, tools):
+    """Keep raw donor inputs pinned; prove the one-method camera OMX rebuild."""
+    scope()
+    import importlib.util
+    root = Path(__file__).resolve().parents[3]
+    spec = importlib.util.spec_from_file_location("bzi6_product", root / "unica/patches/product_feature/a376b_android17_product.py")
+    product = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(product)
+    rel = "system/system/priv-app/SamsungCamera/SamsungCamera.apk"
+    original = donor / rel
+    output = work / rel
+    if sha256(original.read_bytes()).hexdigest() != "21a830e6d2f4d73456f6837a73edf8170ddc84222ff710b71fb1318ae7fc61c1":
+        raise RuntimeError("BZI6 camera rebuild donor input changed")
+    donor_body = method(product.compiled_class(original, DESCRIPTOR, tools)).group()
+    if sha256(donor_body.encode()).hexdigest() != APKS["system/priv-app/SamsungCamera/SamsungCamera.apk"][0]:
+        raise RuntimeError("BZI6 camera rebuild encoder source changed")
+    expected = donor_body.replace(format_default(donor_body, "v4", "0x7f420888"), "    const v4, 0x7f000789", 1)
+    actual = method(product.compiled_class(output, DESCRIPTOR, tools)).group()
+    if sha256(actual.encode()).hexdigest() != sha256(expected.encode()).hexdigest():
+        raise RuntimeError("BZI6 camera compiled method differs from exact reviewed OMX edit")
+    with zipfile.ZipFile(original) as source_zip, zipfile.ZipFile(output) as compiled_zip:
+        if compiled_zip.testzip() is not None:
+            raise RuntimeError("Corrupt rebuilt BZI6 camera APK")
+        libs = {name for name in source_zip.namelist() if name.startswith("lib/") and not name.endswith("/")}
+        output_libs = {name for name in compiled_zip.namelist() if name.startswith("lib/") and not name.endswith("/")}
+        if libs != output_libs or any(source_zip.read(name) != compiled_zip.read(name) for name in libs):
+            raise RuntimeError("BZI6 camera embedded native libraries differ from donor")
+        signature = compiled_zip.read("META-INF/CERT.RSA")
+    # Validate both archive signatures and the actual build certificate.
+    subprocess.run(["jarsigner", "-verify", str(output)], check=True, capture_output=True)
+    with tempfile.TemporaryDirectory(prefix="bzi6-camera-cert-") as directory:
+        cert = Path(directory) / "CERT.RSA"
+        cert.write_bytes(signature)
+        pem = subprocess.run(["openssl", "pkcs7", "-inform", "DER", "-in", str(cert), "-print_certs"], check=True, capture_output=True).stdout
+        actual_cert = subprocess.run(["openssl", "x509", "-outform", "DER"], input=pem, check=True, capture_output=True).stdout
+        prefix = "unica" if os.environ.get("ROM_IS_OFFICIAL", "false") == "true" else "aosp"
+        expected_cert = subprocess.run(["openssl", "x509", "-in", str(root / "security" / (prefix + "_platform.x509.pem")), "-outform", "DER"], check=True, capture_output=True).stdout
+        if actual_cert != expected_cert:
+            raise RuntimeError("BZI6 camera signed by an unexpected certificate")
+    print("PASS rebuilt BZI6 camera: pinned donor, exact OMX method, unchanged native libraries and verified build signature")
+

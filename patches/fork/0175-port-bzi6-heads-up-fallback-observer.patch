+def patch_bzi6(root: Path) -> None:
+    spec = importlib.util.spec_from_file_location("bzi6_product", Path(__file__).resolve().parents[3] / "product_feature/a376b_android17_product.py")
+    product = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(product)
+    product.scope()
+    path = root / "smali_classes3/com/android/systemui/statusbar/notification/interruption/PeekDisabledSuppressor$start$observer$1.smali"
+    text = path.read_text()
+    match = product.method(text, "onChange(Z)V")
+    body = match.group()
+    before = '    invoke-interface {v1, v2, v3}, Lcom/android/systemui/util/settings/SettingsProxy;->getInt(Ljava/lang/String;I)I'
+    after = '    const/4 v4, 0x1\n\n    invoke-interface {v1, v2, v4}, Lcom/android/systemui/util/settings/SettingsProxy;->getInt(Ljava/lang/String;I)I'
+    pristine = body.replace(after, before, 1) if after in body else body
+    if sha256(pristine.encode()).hexdigest() != "16c5136bf9c6274ab13816fcdc3d016353be277d0349f2c8318690800eb00c98":
+        raise ValueError("unreviewed BZI6 heads-up observer method")
+    if after in body:
+        return
+    # v4 is not live until the later logger allocation. Keep v3=0 and the
+    # original stored-zero branch, changing only SettingsProxy's fallback.
+    body = body.replace(before, after, 1)
+    path.write_text(text[:match.start()] + body + text[match.end():])
+
+
 def main() -> None:
     if len(sys.argv) != 2:
         raise SystemExit("usage: patch_brief_heads_up.py DECODED_SYSTEMUI_APK_DIR")
     try:
-        patch(Path(sys.argv[1]) / CLASS)
+        if os.environ.get("ROM_SOURCE_CONFIG") == "essi_a376b_android17":
+            patch_bzi6(Path(sys.argv[1]))
+        else:
+            patch(Path(sys.argv[1]) / CLASS)
     except ValueError as exc:
         raise SystemExit(str(exc)) from exc
     print("PASS SystemUI heads-up default enabled; user choice preserved")

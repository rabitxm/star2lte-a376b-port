 # [
+# Versioned LLVM distributions may install llvm-readelf beside clang without
+# adding its unversioned name to /usr/bin. Ask the existing compiler first.
+if ! type llvm-readelf &> /dev/null && type clang &> /dev/null; then
+    _UN1CA_LLVM_READELF="$(clang --print-prog-name=llvm-readelf 2> /dev/null)" || \
+        _UN1CA_LLVM_READELF=""
+    if [ -n "$_UN1CA_LLVM_READELF" ] && [ -x "$_UN1CA_LLVM_READELF" ]; then
+        export PATH="$(dirname "$_UN1CA_LLVM_READELF"):$PATH"
+    fi
+    unset _UN1CA_LLVM_READELF
+fi
+

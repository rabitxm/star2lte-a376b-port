From: Codex <codex@openai.com>
Subject: [PATCH] preserve bzi6 proc compaction policy input

# Reason: final-tail-preflight-0177b.txt fails A17 system_ext proc-compaction genfscon preimage changed. m4-build-attempt36.txt:1114 proves the earlier generic SELinux module deleted this donor label/mapping, conflicting with the reviewed M4 final adapter. Preserve exactly this type on scoped BZI6; final adapter removes the obsolete vendor genfscon and supplies VNDK33 aliases.
# Affected: unica/patches/selinux/customize.sh one entry exception
# Verify: Exact M4 scope; preserve actual donor type/mapping/genfscon, remove old vendor label using existing helper; full split-policy compilation and clean build mandatory. M1/M2 cleanup unchanged.
# Rollback: Remove0178 and restore previous generic policy loop.

--- a/unica/patches/selinux/customize.sh
+++ b/unica/patches/selinux/customize.sh
@@ -62,6 +62,23 @@
 # ]
 
 for e in $ENTRIES; do
+    if [ "${ROM_SOURCE_CONFIG:-}" = "essi_a376b_android17" ] && \
+            [ "$e" = "proc_compaction_proactiveness" ]; then
+        # BZI6 owns this type/genfscon. Final M4 policy adaptation removes
+        # the stale vendor proc_compaction label and supplies VNDK33 aliases.
+        python3 - "$SRC_DIR" <<'PY_SCOPE' || return 1
+from pathlib import Path
+import importlib.util
+import sys
+path = Path(sys.argv[1]) / "unica/patches/product_feature/a376b_android17_product.py"
+spec = importlib.util.spec_from_file_location("bzi6_product", path)
+product = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(product)
+product.scope()
+PY_SCOPE
+        LOG "- Keeping BZI6 proc_compaction_proactiveness mapping/genfscon for final M4 policy adaptation"
+        continue
+    fi
     if grep -q -F "($e)" "$WORK_DIR/$(GET_SYSTEM_EXT)/etc/selinux/mapping/$CIL_NAME.cil" || \
          grep -q -F "${e}_${CIL_NAME//./_}" "$WORK_DIR/$(GET_SYSTEM_EXT)/etc/selinux/mapping/$CIL_NAME.cil"; then
         # the problematic entry is currently present in system_ext, check if we need to remove it

+#!/usr/bin/env python3
+"""Skip the locked BZI6 DBFW+ 0xFDF1 send on M4/G965F only."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import tempfile
+import zipfile
+
+ROOT = Path(__file__).resolve().parents[3]
+LOCK_PATH = Path(__file__).with_name("a376b_android17_fdf1_skip.lock.json")
+
+
+class Fdf1Error(RuntimeError):
+    pass
+
+
+def lock_data() -> dict:
+    return json.loads(LOCK_PATH.read_text())
+
+
+def check_scope(env: dict[str, str] | None = None) -> None:
+    env = os.environ if env is None else env
+    required = {
+        "ROM_MILESTONE": "M4",
+        "UN1CA_DONOR_CONFIG": "essi_a376b_android17",
+        "SOURCE_FIRMWARE_CACHE_SUFFIX": "A376BXXU5BZI6",
+        "SOURCE_PLATFORM_SDK_VERSION": "37",
+        "TARGET_CODENAME": "star2lte",
+        "STAR2LTE_BUILD_MODEL": "SM-G965F",
+        "EXYNOS9810_M4_SKIP_UNSUPPORTED_FDF1": "true",
+    }
+    mismatches = [f"{key}={env.get(key)!r} (expected {value!r})"
+                  for key, value in required.items() if env.get(key) != value]
+    if mismatches:
+        raise Fdf1Error("M4 BZI6 FDF1 patch scope mismatch: " + "; ".join(mismatches))
+
+
+def elf_tables(data: bytes) -> tuple[int, int, int, int, int, int]:
+    if len(data) < 64 or data[:6] != b"\x7fELF\x02\x01":
+        raise Fdf1Error("JNI must be a little-endian ELF64 image")
+    if struct.unpack_from("<H", data, 18)[0] != 183:
+        raise Fdf1Error("JNI machine is not AArch64")
+    return (struct.unpack_from("<Q", data, 32)[0], struct.unpack_from("<H", data, 54)[0],
+            struct.unpack_from("<H", data, 56)[0], struct.unpack_from("<Q", data, 40)[0],
+            struct.unpack_from("<H", data, 58)[0], struct.unpack_from("<H", data, 60)[0])
+
+
+def file_offset_for_va(data: bytes, va: int) -> int:
+    phoff, phentsize, phnum, *_ = elf_tables(data)
+    for index in range(phnum):
+        fields = struct.unpack_from("<IIQQQQQQ", data, phoff + index * phentsize)
+        p_type, p_flags, p_offset, p_vaddr, _paddr, p_filesz, _memsz, _align = fields
+        if p_type == 1 and (p_flags & 1) and p_vaddr <= va < p_vaddr + p_filesz:
+            return p_offset + va - p_vaddr
+    raise Fdf1Error(f"Locked code address 0x{va:x} is outside executable PT_LOAD")
+
+
+def build_id(data: bytes) -> str:
+    _, _, _, shoff, shentsize, shnum = elf_tables(data)
+    shstrndx = struct.unpack_from("<H", data, 62)[0]
+
+    def section(index: int) -> tuple[int, ...]:
+        return struct.unpack_from("<IIQQQQIIQQ", data, shoff + index * shentsize)
+
+    names_header = section(shstrndx)
+    names = data[names_header[4]:names_header[4] + names_header[5]]
+    for index in range(shnum):
+        header = section(index)
+        name = names[header[0]:].split(b"\0", 1)[0]
+        if name != b".note.gnu.build-id":
+            continue
+        note = data[header[4]:header[4] + header[5]]
+        if len(note) < 16:
+            break
+        namesz, descsz, note_type = struct.unpack_from("<III", note, 0)
+        name_start = 12
+        desc_start = (name_start + namesz + 3) & ~3
+        note_name = note[name_start:name_start + namesz].rstrip(b"\0")
+        desc = note[desc_start:desc_start + descsz]
+        if note_name == b"GNU" and note_type == 3 and desc:
+            return desc.hex()
+    raise Fdf1Error("JNI GNU Build ID is missing")
+
+
+def context_offsets(data: bytes) -> tuple[int, int]:
+    lock = lock_data()
+    start = int(lock["context_start_va"], 16)
+    end = int(lock["context_end_va_exclusive"], 16)
+    return file_offset_for_va(data, start), file_offset_for_va(data, end - 1) + 1
+
+
+def patch_bytes(data: bytes) -> tuple[bytes, str]:
+    lock = lock_data()
+    if build_id(data) != lock["gnu_build_id"]:
+        raise Fdf1Error("JNI Build ID differs from the pinned BZI6 donor")
+    call_offset = file_offset_for_va(data, int(lock["send_call_va"], 16))
+    preimage = bytes.fromhex(lock["send_call_preimage_hex"])
+    replacement = bytes.fromhex(lock["send_call_replacement_hex"])
+    context_start, context_end = context_offsets(data)
+    context_hash = hashlib.sha256(data[context_start:context_end]).hexdigest()
+    if (data[call_offset:call_offset + 4] == replacement and
+            context_hash == lock["context_output_sha256"]):
+        return data, "already-patched"
+    if (data[call_offset:call_offset + 4] != preimage or
+            context_hash != lock["context_preimage_sha256"]):
+        raise Fdf1Error("BZI6 FDF1 sender context/preimage changed")
+    updated = data[:call_offset] + replacement + data[call_offset + 4:]
+    if hashlib.sha256(updated[context_start:context_end]).hexdigest() != lock["context_output_sha256"]:
+        raise Fdf1Error("Patched sender context differs from the locked result")
+    if updated[:call_offset] != data[:call_offset] or updated[call_offset + 4:] != data[call_offset + 4:]:
+        raise Fdf1Error("Patch changed bytes outside the single HCI enqueue call")
+    return updated, "patched"
+
+
+def extract_donor_jni() -> bytes:
+    donor_apex = ROOT / "out/fw/SM-A376B_XXV_A376BXXU5BZI6/system/system/apex/com.android.bt.apex"
+    lock = lock_data()
+    if not donor_apex.is_file() or hashlib.sha256(donor_apex.read_bytes()).hexdigest() != lock["donor_apex_sha256"]:
+        raise Fdf1Error("Pinned BZI6 Bluetooth APEX is missing or changed")
+    with zipfile.ZipFile(donor_apex) as outer:
+        payload = outer.read("apex_payload.img")
+    with tempfile.TemporaryDirectory(prefix="m4-fdf1-fixture-") as temp_dir:
+        payload_path = Path(temp_dir) / "apex_payload.img"
+        jni_path = Path(temp_dir) / "libbluetooth_jni.so"
+        payload_path.write_bytes(payload)
+        subprocess.run(["debugfs", "-R", f"dump /lib64/libbluetooth_jni.so {jni_path}", str(payload_path)],
+                       check=True, capture_output=True, text=True)
+        data = jni_path.read_bytes()
+    if hashlib.sha256(data).hexdigest() != lock["donor_jni_sha256"]:
+        raise Fdf1Error("Embedded BZI6 Bluetooth JNI hash mismatch")
+    return data
+
+
+def apply(path: Path) -> None:
+    check_scope()
+    if path.is_symlink() or not path.is_file():
+        raise Fdf1Error("JNI target is missing or symlinked")
+    original = path.read_bytes()
+    updated, state = patch_bytes(original)
+    if state == "already-patched":
+        print("PASS locked BZI6 0xFDF1 enqueue already skipped")
+        return
+    temporary = path.with_name(path.name + ".fdf1-skip.tmp")
+    temporary.write_bytes(updated)
+    os.chmod(temporary, path.stat().st_mode & 0o777)
+    os.replace(temporary, path)
+    if path.read_bytes() != updated:
+        raise Fdf1Error("JNI readback differs after atomic replace")
+    print("PASS skipped only the locked BZI6 optional 0xFDF1 HCI send")
+
+
+def verify(path: Path, *, expected_final_hash: bool = False) -> None:
+    check_scope()
+    if path.is_symlink() or not path.is_file():
+        raise Fdf1Error("JNI image is missing or symlinked")
+    data = path.read_bytes()
+    _, state = patch_bytes(data)
+    if state != "already-patched":
+        raise Fdf1Error("Final M4 JNI does not contain the locked FDF1 skip")
+    if expected_final_hash:
+        expected = lock_data()["final_work_jni_sha256"]
+        actual = hashlib.sha256(data).hexdigest()
+        if actual != expected:
+            raise Fdf1Error(f"Final M4 JNI hash mismatch: {actual}")
+    print("PASS locked BZI6 FDF1 sender, profile, Build ID and output verified")
+
+
+def fixture() -> None:
+    check_scope()
+    lock = lock_data()
+    donor = extract_donor_jni()
+    if build_id(donor) != lock["gnu_build_id"]:
+        raise Fdf1Error("Donor Build ID differs from the lock")
+    output, state = patch_bytes(donor)
+    if state != "patched" or hashlib.sha256(output).hexdigest() != lock["donor_output_sha256"]:
+        raise Fdf1Error("Donor patch output differs from the locked single-call result")
+    repeated, repeat_state = patch_bytes(output)
+    if repeat_state != "already-patched" or repeated != output:
+        raise Fdf1Error("Patch is not idempotent")
+    call_offset = file_offset_for_va(donor, int(lock["send_call_va"], 16))
+    if output[:call_offset] != donor[:call_offset] or output[call_offset + 4:] != donor[call_offset + 4:]:
+        raise Fdf1Error("Fixture found bytes changed outside the HCI enqueue call")
+    bad_context = bytearray(donor)
+    context_start, _ = context_offsets(donor)
+    bad_context[context_start] ^= 1
+    try:
+        patch_bytes(bytes(bad_context))
+    except Fdf1Error:
+        pass
+    else:
+        raise Fdf1Error("Changed sender context was accepted")
+    wrong_milestone = dict(os.environ)
+    wrong_milestone["ROM_MILESTONE"] = "M2"
+    try:
+        check_scope(wrong_milestone)
+    except Fdf1Error:
+        pass
+    else:
+        raise Fdf1Error("Wrong-milestone fixture was accepted")
+    wrong_target = dict(os.environ)
+    wrong_target["TARGET_CODENAME"] = "starlte"
+    try:
+        check_scope(wrong_target)
+    except Fdf1Error:
+        pass
+    else:
+        raise Fdf1Error("Wrong-target fixture was accepted")
+    print("PASS BZI6 donor hash, unique locked context, one-call patch, idempotence and negative scope/preimage checks")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    subcommands = parser.add_subparsers(dest="command", required=True)
+    apply_parser = subcommands.add_parser("apply")
+    apply_parser.add_argument("--jni", type=Path, required=True)
+    verify_parser = subcommands.add_parser("verify")
+    verify_parser.add_argument("--jni", type=Path, required=True)
+    verify_parser.add_argument("--final-hash", action="store_true")
+    subcommands.add_parser("fixture")
+    args = parser.parse_args()
+    if args.command == "apply":
+        apply(args.jni)
+    elif args.command == "verify":
+        verify(args.jni, expected_final_hash=args.final_hash)
+    else:
+        fixture()
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        raise SystemExit(main())
+    except (Fdf1Error, OSError, ValueError, KeyError, zipfile.BadZipFile, subprocess.CalledProcessError) as exc:
+        print(f"FAIL {exc}", file=sys.stderr)
+        raise SystemExit(1)

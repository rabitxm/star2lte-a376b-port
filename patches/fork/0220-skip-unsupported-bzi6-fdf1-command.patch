+#!/usr/bin/env python3
+"""Select the native Bluetooth config backend for the scoped M4/G965F build.
+
+The BZI6 JNI requests the AIDL VaultKeeper service, while the Exynos9810
+Hybrid Vendor deliberately omits that incompatible provider. This patch skips
+only the BZI6 VaultKeeper initialization branch so its existing reader and
+writer use the same native config backend. It refuses unknown JNI builds and
+requires a metadata-only store preflight before a device trial.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import struct
+import sys
+import zipfile
+import tempfile
+import subprocess
+import xml.etree.ElementTree as ET
+
+
+ROOT = Path(__file__).resolve().parents[3]
+LOCK_PATH = Path(__file__).with_name("a376b_android17_native_backend.lock.json")
+PREIMAGE = bytes.fromhex("8816523948050037")
+PATCHED = bytes.fromhex("881652392a000014")
+BRANCH_VA = 0x7AAC04
+
+
+class BackendError(RuntimeError):
+    pass
+
+
+def lock_data() -> dict:
+    return json.loads(LOCK_PATH.read_text())
+
+
+def check_scope(env: dict[str, str] | None = None) -> None:
+    env = os.environ if env is None else env
+    required = {
+        "ROM_MILESTONE": "M4",
+        "UN1CA_DONOR_CONFIG": "essi_a376b_android17",
+        "SOURCE_FIRMWARE_CACHE_SUFFIX": "A376BXXU5BZI6",
+        "SOURCE_PLATFORM_SDK_VERSION": "37",
+        "STAR2LTE_BUILD_MODEL": "SM-G965F",
+        "EXYNOS9810_M4_VAULTKEEPER_NATIVE_BACKEND": "true",
+    }
+    mismatches = [f"{key}={env.get(key)!r} (expected {expected!r})"
+                  for key, expected in required.items() if env.get(key) != expected]
+    if mismatches:
+        raise BackendError("M4 native Bluetooth backend scope mismatch: " + "; ".join(mismatches))
+
+
+def build_id(data: bytes) -> str:
+    ident = bytes.fromhex(lock_data()["gnu_build_id"])
+    if data.count(ident) != 1:
+        raise BackendError("JNI GNU Build ID is missing, duplicated, or not the pinned BZI6 build")
+    return ident.hex()
+
+
+def file_offset_for_va(data: bytes, va: int) -> int:
+    if data[:4] != b"\x7fELF" or data[4:6] != b"\x02\x01":
+        raise BackendError("JNI must be a little-endian ELF64 image")
+    if struct.unpack_from("<H", data, 18)[0] != 183:
+        raise BackendError("JNI machine is not AArch64")
+    phoff = struct.unpack_from("<Q", data, 32)[0]
+    phentsize = struct.unpack_from("<H", data, 54)[0]
+    phnum = struct.unpack_from("<H", data, 56)[0]
+    for index in range(phnum):
+        offset = phoff + index * phentsize
+        p_type, p_flags, p_offset, p_vaddr, _paddr, p_filesz, _memsz, _align = \
+            struct.unpack_from("<IIQQQQQQ", data, offset)
+        if p_type == 1 and (p_flags & 1) and p_vaddr <= va < p_vaddr + p_filesz:
+            return p_offset + va - p_vaddr
+    raise BackendError(f"Pinned code address 0x{va:x} is not in an executable PT_LOAD")
+
+
+def patch_bytes(data: bytes, *, require_source_hash: bool) -> tuple[bytes, str]:
+    lock = lock_data()
+    found_build_id = build_id(data)
+    if found_build_id != lock["gnu_build_id"]:
+        raise BackendError("JNI Build ID differs from the locked BZI6 donor")
+    offset = file_offset_for_va(data, BRANCH_VA)
+    at_address = data[offset:offset + len(PREIMAGE)]
+    old_count = data.count(PREIMAGE)
+    new_count = data.count(PATCHED)
+    if at_address == PATCHED and new_count == 1 and old_count == 0:
+        return data, "already-patched"
+    if at_address != PREIMAGE or old_count != 1 or new_count != 0:
+        raise BackendError("BZI6 VaultKeeper selector preimage is not unique at the locked address")
+    if require_source_hash and hashlib.sha256(data).hexdigest() != lock["donor_jni_sha256"]:
+        raise BackendError("Unpatched JNI is not the exact embedded BZI6 donor image")
+    result = data[:offset] + PATCHED + data[offset + len(PREIMAGE):]
+    if result.count(PREIMAGE) != 0 or result.count(PATCHED) != 1:
+        raise BackendError("Patched JNI did not produce one unique native-backend selector")
+    if require_source_hash and hashlib.sha256(result).hexdigest() != lock["donor_native_output_sha256"]:
+        raise BackendError("Patched donor JNI hash differs from the reviewed output lock")
+    if result[:offset] != data[:offset] or result[offset + len(PATCHED):] != data[offset + len(PREIMAGE):]:
+        raise BackendError("Patch changed bytes outside the single locked branch instruction")
+    return result, "patched"
+
+
+def apply(path: Path) -> None:
+    check_scope()
+    if path.is_symlink() or not path.is_file():
+        raise BackendError("JNI target is missing or symlinked")
+    original = path.read_bytes()
+    updated, result = patch_bytes(original, require_source_hash=True)
+    if result == "already-patched":
+        print("PASS BZI6 native backend selector already patched")
+        return
+    tmp = path.with_name(path.name + ".native-backend.tmp")
+    tmp.write_bytes(updated)
+    os.chmod(tmp, path.stat().st_mode & 0o777)
+    os.replace(tmp, path)
+    if path.read_bytes() != updated:
+        raise BackendError("JNI output readback differs after atomic replace")
+    print("PASS patched only the locked VaultKeeper selector branch")
+
+
+def verify(path: Path, *, expected_final_hash: bool = False) -> None:
+    check_scope()
+    if path.is_symlink() or not path.is_file():
+        raise BackendError("JNI image file is missing or symlinked")
+    data = path.read_bytes()
+    build_id(data)
+    offset = file_offset_for_va(data, BRANCH_VA)
+    if data[offset:offset + len(PATCHED)] != PATCHED:
+        raise BackendError("JNI image does not contain the native backend branch at the locked VA")
+    if data.count(PATCHED) != 1 or PREIMAGE in data:
+        raise BackendError("JNI image branch is duplicated or still contains the VaultKeeper preimage")
+    if expected_final_hash:
+        expected = lock_data()["final_work_jni_sha256"]
+        actual = hashlib.sha256(data).hexdigest()
+        if actual != expected:
+            raise BackendError(f"Final M4 JNI hash mismatch: {actual}")
+    print("PASS locked M4/G965F/BZI6 native backend selector verified")
+
+
+def verify_vendor_provider_absent(work: Path) -> None:
+    """Ensure the image has not silently gained an A37-specific VaultKeeper HAL."""
+    vendor = work / "vendor"
+    if not vendor.is_dir():
+        raise BackendError("Vendor work tree is missing during Bluetooth backend image verification")
+    donor_service = vendor / "bin/vendor.samsung.hardware.security.vaultkeeper-service"
+    if donor_service.exists() or donor_service.is_symlink():
+        raise BackendError("A37 VaultKeeper hardware service must not be copied into the G965F vendor image")
+    manifest_files = []
+    combined = vendor / "etc/vintf/manifest.xml"
+    if combined.is_file():
+        manifest_files.append(combined)
+    manifest_dir = vendor / "etc/vintf/manifest"
+    if manifest_dir.is_dir():
+        manifest_files.extend(sorted(manifest_dir.rglob("*.xml")))
+    for manifest in manifest_files:
+        try:
+            root = ET.parse(manifest).getroot()
+        except ET.ParseError as exc:
+            raise BackendError(f"Cannot parse vendor VINTF manifest {manifest}: {exc}") from exc
+        for hal in root.findall(".//hal"):
+            name = (hal.findtext("name") or "").strip()
+            if hal.get("format") != "aidl" or name != "vendor.samsung.hardware.security.vaultkeeper":
+                continue
+            fqnames = {(node.text or "").strip() for node in hal.findall("fqname")}
+            if "ISehVaultKeeper/default" in fqnames:
+                raise BackendError("Vendor image unexpectedly declares the incompatible AIDL VaultKeeper service")
+
+
+def classify_store(metadata: dict) -> str:
+    """Fail closed from metadata only; values/key bytes are never accepted."""
+    if metadata.get("provider_present") is not False:
+        raise BackendError("Native-only patch requires the AIDL provider to be absent")
+    entries = metadata.get("entries")
+    if not isinstance(entries, list):
+        raise BackendError("Store metadata must contain an entries list")
+    if not entries:
+        return "native-initialize"
+    lengths = [entry.get("length") for entry in entries if isinstance(entry, dict)]
+    if len(lengths) != len(entries):
+        raise BackendError("Malformed metadata entry")
+    if any(length != 16 for length in lengths):
+        raise BackendError("Non-native key length found; preserve store and refuse backend switch")
+    return "native-existing-16"
+
+
+def fixture() -> None:
+    # Synthetic sizes and opaque labels only; no handset key material is read.
+    cases = [
+        ({"provider_present": False, "entries": []}, "native-initialize"),
+        ({"provider_present": False, "entries": [
+            {"field": "local", "length": 16}, {"field": "bonded", "length": 16}]},
+         "native-existing-16"),
+    ]
+    for metadata, expected in cases:

+#!/usr/bin/env python3
+"""Apply/audit the explicitly selected M2 Face Unlock omission on staged files."""
+from pathlib import Path
+from xml.etree import ElementTree as ET
+import argparse
+import re
+
+NAMES = {"android.hardware.biometrics.face", "vendor.samsung.hardware.biometrics.face"}
+HAL = re.compile(r"(?s)<hal\b[^>]*>.*?</hal>")
+
+
+def manifests(work):
+    for partition in ("vendor", "odm", "system/system", "system/system/system_ext", "system/product"):
+        directory = work / partition / "etc/vintf"
+        if directory.exists():
+            yield from directory.rglob("*.xml")
+
+
+def face_init(work):
+    for partition in ("vendor", "odm", "system/system", "system/system/system_ext", "system/product"):
+        directory = work / partition / "etc/init"
+        if directory.exists():
+            for path in directory.rglob("*.rc"):
+                if re.search(r"(?m)^\s*service\s+[^\n]*(?:biometrics\.face|faceunlockfix)", path.read_text()):
+                    yield path
+
+
+def verify(work):
+    for path in manifests(work):
+        for hal in ET.parse(path).getroot().iter("hal"):
+            if hal.findtext("name") in NAMES:
+                raise RuntimeError("Omitted Face HAL restored in " + str(path.relative_to(work)))
+    active = list(face_init(work))
+    if active:
+        raise RuntimeError("Omitted Face init restored: " + str(active[0].relative_to(work)))
+    props = (work / "system/system/build.prop").read_text().splitlines()
+    if "ro.un1ca.faceunlockfix.builtin=1" in props:
+        raise RuntimeError("Omitted Face bridge is still claimed built-in")
+    if not (work / "system/system/etc/permissions/android.hardware.biometrics.face.xml").is_file():
+        raise RuntimeError("Keep framework FaceManager feature XML for SystemUI initialization")
+    print("PASS selected Face omission: no face HAL/init/built-in claim; framework FaceManager feature retained")
+
+
+def apply(work):
+    for path in manifests(work):
+        original = path.read_text()
+        def keep(match):
+            return "" if ET.fromstring(match.group()).findtext("name") in NAMES else match.group()
+        changed = HAL.sub(keep, original)
+        ET.fromstring(changed)
+        if changed != original:
+            path.write_text(changed)
+    for path in face_init(work):
+        # Known Face init fragments contain no unrelated service. Reject a
+        # future combined fragment rather than removing unrelated services.
+        services = re.findall(r"(?m)^\s*service\s+([^\n]+)", path.read_text())
+        if any(not re.search(r"biometrics\.face|faceunlockfix", line) for line in services):
+            raise RuntimeError("Mixed Face init requires review: " + str(path))
+        path.unlink()
+    props = work / "system/system/build.prop"
+    props.write_text(re.sub(r"(?m)^ro\.un1ca\.faceunlockfix\.builtin=.*\n?", "", props.read_text()))
+    verify(work)
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("operation", choices=("apply", "verify"))
+    parser.add_argument("work", type=Path)
+    args = parser.parse_args()
+    (apply if args.operation == "apply" else verify)(args.work)

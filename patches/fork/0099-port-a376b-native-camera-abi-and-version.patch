+#!/usr/bin/env python3
+"""Retain AZH4 camera ABI and port the fork's zero-max-buffer fallback.
+Reason: the S22 server imports AudioSystem and OutputConfiguration ABIs absent
+from A37. Files: explicit output only, original donor is never edited.
+Verify: pinned input, original instruction guards, exact eight-byte patch;
+runtime linker, camera service/provider enumeration and capture tests.
+"""
+from pathlib import Path
+import argparse, hashlib, json, struct
+SOURCE_SHA = "a85c42524f3a33c9cdc327bd7435a5495ed4d60e08222d1e30b84bb20d887ee2"
+OFFSET = 0x27a314
+BEFORE = bytes.fromhex("21eeff90212c3691")
+AFTER = bytes.fromhex("28008052e5ffff17")
+def patch(data):
+    if hashlib.sha256(data).hexdigest() != SOURCE_SHA:
+        raise ValueError("Unexpected A376B AZH4 cameraserver hash")
+    assert data[:4] == b"\x7fELF" and data[4:6] == b"\x02\x01"
+    assert struct.unpack_from("<H", data, 18)[0] == 183
+    assert data[OFFSET:OFFSET+8] == BEFORE
+    assert data[0x27a2a4:0x27a2ac] == bytes.fromhex("681e40b968030034")
+    assert data[0x27a2ac:0x27a2b0] == bytes.fromhex("610240f9")
+    # The original cbz jumps to this error block only when max_buffers is zero.
+    # Mirror the existing S22 fix: w8=1 and jump to the original continuation.
+    result = data[:OFFSET] + AFTER + data[OFFSET+8:]
+    assert len(result) == len(data)
+    assert result[:OFFSET] == data[:OFFSET] and result[OFFSET+8:] == data[OFFSET+8:]
+    return result
+if __name__ == "__main__":
+    ap=argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("source", type=Path);ap.add_argument("output",type=Path)
+    args=ap.parse_args()
+    if args.source.resolve() == args.output.resolve():ap.error("Source overwrite refused")
+    data=patch(args.source.read_bytes())
+    args.output.parent.mkdir(parents=True,exist_ok=True)
+    args.output.write_bytes(data);args.output.chmod(0o755)
+    print(json.dumps({"result":"PASS","source_sha256":SOURCE_SHA,
+        "output_sha256":hashlib.sha256(data).hexdigest(),"patch_offset":OFFSET,
+        "changed_bytes":8,"size_unchanged":True}))

+#!/usr/bin/env python3
+"""Recognize the A37 OneUI8.5 version in the retained OneUI8 Camera APK.
+Reason: logged Camera.onCreate exception for version80500. Only this exact
+version uses the APK's existing V8_0 feature set; unknown versions still throw.
+Files: the reviewed Camera enum only. No system property/version spoof.
+Verify compiled enum/Camera launch and actual preview/capture separately.
+"""
+from pathlib import Path
+import hashlib,sys
+ORIGINAL_SHA='e2beaff01e9ef41e9c7839ed2c8545f8f46ea65f188a54f7d20f9d01197fbb5f'
+ANCHOR='.method public static a(I)Lx1/k;\n    .locals 5\n'
+ADDITION='''
+    # A376B AZH4 OneUI8.5: retain this legacy APK's existing OneUI8 feature set.
+    const v0, 0x13a74
+
+    if-ne p0, v0, :exynos9810_oneui_known_versions
+
+    sget-object v0, Lx1/k;->V8_0:Lx1/k;
+
+    return-object v0
+
+    :exynos9810_oneui_known_versions
+'''
+def apply(root):
+    files=list(Path(root).glob('smali*/x1/k.smali'))
+    if len(files)!=1:raise ValueError('Unreviewed Camera enum layout')
+    p=files[0];text=p.read_text()
+    original=text.replace(ADDITION,'',1) if ADDITION in text else text
+    if hashlib.sha256(original.encode()).hexdigest()!=ORIGINAL_SHA:
+        raise ValueError('Unreviewed Camera version enum; inspect donor changes')
+    if ADDITION not in text:
+        assert text.count(ANCHOR)==1
+        p.write_text(text.replace(ANCHOR,ANCHOR+ADDITION,1))
+    return p
+if __name__=='__main__':print('PASS Camera 80500 compatibility:',apply(sys.argv[1]))

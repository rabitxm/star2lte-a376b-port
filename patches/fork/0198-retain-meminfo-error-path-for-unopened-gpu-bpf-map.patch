+#!/usr/bin/env python3
+"""Bounded BZI6 GPU-map diagnostic; no ROM profile is changed here.
+
+Reason: actual SystemServer tombstone reaches the invalid-fd abort before
+the GPU readers' existing false/error paths. Permit only that early return;
+retain all checks for an opened map and all callers' real results/errno.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+LOCK = Path(__file__).with_suffix('.lock.json')
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def segments(data):
+    if data[:6] != b'\x7fELF\x02\x01' or struct.unpack_from('<H', data, 18)[0] != 183:
+        raise ValueError('Expected ELF64 little-endian AArch64')
+    ph = struct.unpack_from('<Q', data, 32)[0]
+    size, count = struct.unpack_from('<HH', data, 54)
+    return [struct.unpack_from('<IIQQQQQQ', data, ph + i * size) for i in range(count)]
+
+
+def offset(data, va, length=4):
+    hits = [p[2] + va - p[3] for p in segments(data)
+            if p[0] == 1 and p[1] & 1 and p[3] <= va and va + length <= p[3] + p[5]]
+    if len(hits) != 1:
+        raise ValueError('Instruction must map to one executable file segment')
+    return hits[0]
+
+
+def target(word, va, bits, shift):
+    imm = (word >> shift) & ((1 << bits) - 1)
+    if imm & (1 << (bits - 1)):
+        imm -= 1 << bits
+    return va + 4 * imm
+
+
+def transform(data, lock):
+    if sha(data) != lock['source_sha256']:
+        raise ValueError('Unreviewed BZI6 libmeminfo input hash')
+    va = lock['branch_va']
+    at = offset(data, va)
+    before, after = (bytes.fromhex(lock[k]) for k in ('before', 'after'))
+    if data[at:at + 4] != before or len(before) != 4 or len(after) != 4:
+        raise ValueError('Invalid-fd branch bytes mismatch')
+    for code, dest in ((before, lock['abort_va']), (after, lock['epilogue_va'])):
+        word = int.from_bytes(code, 'little')
+        if word & 0xfff8001f != 0x37f80008 or target(word, va, 14, 5) != dest:
+            raise ValueError('Expected TBNZ w8 bit31 to reviewed target')
+    # Both actual GPU callers reload/test fd immediately after this void call.
+    # No instruction at either call site, error path or valid-fd verifier changes.
+    calls = []
+    for p in segments(data):
+        if p[0] != 1 or not p[1] & 1:
+            continue
+        for pos in range(p[2], p[2] + p[5] - 3, 4):
+            word = struct.unpack_from('<I', data, pos)[0]
+            addr = p[3] + pos - p[2]
+            if word & 0xfc000000 == 0x94000000 and target(word, addr, 26, 0) == lock['verifier_va']:
+                calls.append(addr)
+    if calls != [c['va'] for c in lock['callers']]:
+        raise ValueError('GPU verifier caller set changed')
+    for c in lock['callers']:
+        start = offset(data, c['va'], len(bytes.fromhex(c['bytes'])))
+        if data[start:start + len(bytes.fromhex(c['bytes']))].hex() != c['bytes']:
+            raise ValueError('GPU caller fd/error branch context changed')
+    for c in lock['contexts']:
+        raw = bytes.fromhex(c['bytes'])
+        pos = offset(data, c['va'], len(raw))
+        if data[pos:pos + len(raw)] != raw:
+            raise ValueError('GPU verifier prologue/epilogue/check context changed')
+    result = data[:at] + after + data[at + 4:]
+    if sha(result) != lock['output_sha256']:
+        raise ValueError('GPU optional-map output hash mismatch')
+    return result
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--source', required=True, type=Path)
+    p.add_argument('--output', required=True, type=Path)
+    p.add_argument('--verify', action='store_true')
+    args = p.parse_args()
+    lock = json.loads(LOCK.read_text())
+    if args.source.is_symlink() or not args.source.is_file():
+        raise ValueError('Source must be a regular non-symlink file')
+    output = transform(args.source.read_bytes(), lock)
+    if args.verify:
+        if args.output.is_symlink() or not args.output.is_file() or args.output.read_bytes() != output:
+            raise ValueError('Diagnostic destination mismatch')
+    else:
+        with args.output.open('xb') as f:
+            f.write(output)
+        args.output.chmod(0o644)
+    print(json.dumps({'result': 'PASS', 'diagnostic_only': True,
+                      'output_sha256': sha(output), 'bytes': len(output),
+                      'changed_instruction_va': lock['branch_va'],
+                      'valid_fd_verifier_unchanged': True}))
+
+
+if __name__ == '__main__':
+    main()

+  "framework_connectivity_jar_sha256": "cb000f867b4a969954b157f50a1c07920fc047a3232ee51086dc0fb0ace541f3",
+  "source_block_sha256": "1a74fea5764a9a9fac5913b02334388f478e32b3ebf76e955b57e17bc4369a68",

+++ b/unica/mods/settings/a376b_android17_boot_limits.py
@@ -0,0 +1,112 @@
+#!/usr/bin/env python3
+"""Wire the reviewed initial M4 Settings/search selection without false controls."""
+from hashlib import sha256
+from pathlib import Path
+import importlib.util
+import os
+import re
+import sys
+import xml.etree.ElementTree as ET
+import zipfile
+
+HERE = Path(__file__).resolve().parent
+SPEC = importlib.util.spec_from_file_location("bzi6_product", HERE.parent.parent / "patches/product_feature/a376b_android17_product.py")
+PRODUCT = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(PRODUCT)
+FACTORY = "com/android/settings/search/SearchFeatureProviderImpl$$ExternalSyntheticLambda0"
+PROVIDERS = "io/mesalabs/unica/search/UnicaSearchIndexableResources"
+COLLECTOR = "com/samsung/android/settings/intelligence/search/categorizing/TopLevelKeysCollector"
+CONSTRUCTOR = "<init>(Landroid/content/Context;)V"
+OMITTED = ("unica_allow_downgrade", "unica_allow_sdkbypass", "unica_secure_ss",
+           "unica_ss_detection", "unica_gphotos", "unica_bixby_action")
+
+
+def scope():
+    PRODUCT.scope()
+    for key, value in {
+        "STAR2LTE_M4_BOOT_LIMITS": "true", "EXYNOS9810_FACE_UNLOCK_DISABLED": "true",
+        "STAR2LTE_M2_FIXED_RESOLUTION": "false", "STAR2LTE_M2_KEEP_DONOR_WIFI_UI": "false",
+    }.items():
+        if os.environ.get(key) != value:
+            raise RuntimeError("Unreviewed BZI6 initial feature selection: " + key)
+
+
+def settings(root):
+    scope()
+    path = root / "res/xml/unica_extra_settings.xml"
+    text = path.read_text()
+    ET.fromstring(text)
+    for key in OMITTED:
+        text, count = re.subn(r'^.*android:key="' + re.escape(key) + r'"[^\n]*\n', "", text, flags=re.M)
+        if count != 1:
+            raise RuntimeError("Unexpected BZI6 optional Settings control: " + key)
+    ET.fromstring(text)
+    if "unica_bixby_app" in text or 'android:key="unica_games_spoof"' not in text:
+        raise RuntimeError("BZI6 optional Settings positive/negative control mismatch")
+    spec = importlib.util.spec_from_file_location("a376b_search", HERE / "a376b_search.py")
+    search = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(search)
+    # XML is validated first; the search helper validates every preimage before
+    # writing either Smali class. No unrelated preference is removed.
+    search.stage(root)
+    path.write_text(text)
+    print("PASS BZI6 Settings: hide five unsupported options and Bixby remap; retain other controls")
+
+
+def intelligence(root):
+    scope()
+    paths = list(root.glob("smali*/" + COLLECTOR + ".smali"))
+    if len(paths) != 1:
+        raise RuntimeError("Expected one BZI6 top-level Settings key collector")
+    path = paths[0]
+    text = path.read_text()
+    current = PRODUCT.method(text, CONSTRUCTOR)
+    body = current.group()
+    if sha256(body.encode()).hexdigest() != "c0750fd5bfea79bffaf4b8aea42ecc1cefdf0be430d98fb8726b8b6a50d619e2":
+        raise RuntimeError("Unreviewed BZI6 top-level collector constructor")
+    if body.count("    .locals 37") != 1 or re.search(r"\bv37\b", body):
+        raise RuntimeError("BZI6 collector local-register layout changed")
+    before = "    filled-new-array/range {v1 .. v36}, [Ljava/lang/String;"
+    if body.count(before) != 1 or '"top_level_buds_unite"' not in body:
+        raise RuntimeError("BZI6 donor key array changed")
+    body = body.replace("    .locals 37", "    .locals 38", 1).replace(before,
+        '    const-string v37, "top_level_unica"\n\n'
+        '    filled-new-array/range {v1 .. v37}, [Ljava/lang/String;', 1)
+    path.write_text(text[:current.start()] + body + text[current.end():])
+    print("PASS BZI6 Settings Intelligence: retain36 donor keys including Buds; append UN1CA with a fresh local")
+
+
+def verify_compiled(work, tools):
+    scope()
+    settings_apk = work / "system/system/priv-app/SecSettings/SecSettings.apk"
+    factory = PRODUCT.method(PRODUCT.compiled_class(settings_apk, FACTORY, tools), "invoke()Ljava/lang/Object;").group()
+    hook = "L" + PROVIDERS + ";->register(Lcom/android/settingslib/search/SearchIndexableResourcesBase;)V"
+    if factory.count("->addIndex(") != 211 or factory.count(hook) != 1:
+        raise RuntimeError("Compiled BZI6 donor/UN1CA search registrations mismatch")
+    helper = PRODUCT.compiled_class(settings_apk, PROVIDERS, tools)
+    if helper.count("Lcom/android/settingslib/search/SearchIndexableResourcesBase;->addIndex(") != 4 or \
+            ".super Ljava/lang/Object;" not in helper:
+        raise RuntimeError("Compiled BZI6 static UN1CA search provider mismatch")
+    intel = work / "system/system/priv-app/SecSettingsIntelligence/SecSettingsIntelligence.apk"
+    body = PRODUCT.method(PRODUCT.compiled_class(intel, COLLECTOR, tools), CONSTRUCTOR).group()
+    if not PRODUCT.has_instruction(body, 'const-string v37, "top_level_unica"') or \
+            "filled-new-array/range {v1 .. v37}, [Ljava/lang/String;" not in body or \
+            '"top_level_buds_unite"' not in body or body.count("const-string") != 37:
+        raise RuntimeError("Compiled BZI6 top-level donor/UN1CA key array mismatch")
+    with zipfile.ZipFile(work / "system/system/framework/services.jar") as archive:
+        for name in archive.namelist():
+            if re.fullmatch(r"classes\d*\.dex", name) and \
+                    b"Lcom/android/server/policy/PhoneWindowManager$UnicaBixbyRunnable;" in archive.read(name):
+                raise RuntimeError("Omitted M4 Bixby remapper restored in compiled services")
+    print("PASS compiled BZI6 search: 211 donor +4 UN1CA providers;36 donor +1 top-level keys")
+
+
+if __name__ == "__main__":
+    if len(sys.argv) == 2 and sys.argv[1] == "scope":
+        scope()
+    elif len(sys.argv) == 3 and sys.argv[1] in ("settings", "intelligence"):
+        (settings if sys.argv[1] == "settings" else intelligence)(Path(sys.argv[2]))
+    elif len(sys.argv) == 4 and sys.argv[1] == "verify-compiled":
+        verify_compiled(Path(sys.argv[2]), Path(sys.argv[3]))
+    else:
+        raise SystemExit("usage: a376b_android17_boot_limits.py scope | settings|intelligence DECODED | verify-compiled WORK TOOLS")

 """Stage and verify the donor-native M4 runtime boundary.
 
 Reason: keep BZI6 camera/audio/graphics/Tethering ABI paired at Android 17 while
-adding only the reviewed vendor_kg account and an empty vendor aconfig v2 set.
+adding the reviewed vendor_kg, empty vendor aconfig v2 and additive graphics V6.
 Files: exact files in the M4 lock, vendor passwd/group and vendor/etc/aconfig.
 Verify source marker/hashes, aconfig v2 provenance, final work tree and scope.
 """
@@ -83,6 +83,27 @@
     return root
 
 
+
+def graphics_compat(work, donor, stage=False):
+    # Final graphics restoration retains the Hybrid Vendor gralloctypes ABI,
+    # which imports V6 even when the A37 platform itself uses V7. Add the exact
+    # S22 V6 interface alongside V7; never replace either gralloctypes or V7.
+    for rel, entry in manifest()["compatibility_files"].items():
+        source = Path(donor).parent / entry["source_cache"] / entry["source_path"]
+        if not source.is_file() or source.is_symlink() or digest(source) != entry["sha256"]:
+            raise ValueError("Unreviewed M4 graphics compatibility source: " + rel)
+        target = Path(work) / rel
+        if target.exists() or target.is_symlink():
+            if not target.is_file() or target.is_symlink() or digest(target) != entry["sha256"]:
+                raise ValueError("Unreviewed M4 graphics compatibility destination: " + rel)
+        elif stage:
+            target.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copyfile(source, target)
+            target.chmod(0o644)
+        else:
+            raise ValueError("Missing M4 graphics compatibility interface: " + rel)
+
+

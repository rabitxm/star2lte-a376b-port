+#!/usr/bin/env python3
+"""Guard a missing legacy MultiMic manager without replacing the donor ABI."""
+from pathlib import Path
+import re
+import sys
+
+GUARD = '''
+    # UN1CA: legacy devices can have no SemMultiMicManager.
+    iget-object v0, p0, Lcom/sec/android/app/camera/audio/MultiMicController;->mManager:Lcom/samsung/android/camera/mic/SemMultiMicManager;
+
+    if-nez v0, :unica_multimic_prepare_ready
+
+    return-void
+
+    :unica_multimic_prepare_ready
+'''
+
+def patch(text):
+    candidates = list(re.finditer(r'^\.method[^\n]* prepare\(IIII(?:Z)?\)V\n.*?^\.end method$', text, re.M | re.S))
+    if len(candidates) != 1:
+        raise RuntimeError('Unknown MultiMicController.prepare ABI; review donor')
+    found = candidates[0]
+    body = found.group()
+    if body.count('->initialize(IIII)V') != 1 or 'mManager:Lcom/samsung/android/camera/mic/SemMultiMicManager;' not in text:
+        raise RuntimeError('Unknown MultiMicController initialization; review donor')
+    if GUARD in body:
+        return text
+    if 'unica_multimic_prepare_ready' in body:
+        raise RuntimeError('Partial MultiMicController guard; review source')
+    local = re.search(r'^    \.locals ([1-9][0-9]*)\n', body, re.M)
+    if local is None:
+        raise RuntimeError('Unknown MultiMicController scratch-register layout')
+    body = body[:local.end()] + GUARD + body[local.end():]
+    return text[:found.start()] + body + text[found.end():]
+
+if __name__ == '__main__':
+    path = Path(sys.argv[1])
+    path.write_text(patch(path.read_text()))

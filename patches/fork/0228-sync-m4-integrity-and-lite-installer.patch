+    move v5, v9
+
+    move/from16 v20, v12
+
+    move/from16 v21, v13
+
+    if-ne v11, v5, :cond_f
+'''
+    new = '''    :cond_a
+    move v5, v9
+
+    move/from16 v20, v12
+
+    move/from16 v21, v13
+
+    # EC-only: duplicate the EC chain only in this validation local, so the
+    # existing root-pin check still examines it. Stored XML remains unchanged.
+    if-eqz v20, :ec_only_validation_done
+
+    if-eqz v21, :ec_only_validation_done
+
+    if-nez v14, :ec_only_validation_done
+
+    if-nez v15, :ec_only_validation_done
+
+    invoke-virtual {v0}, Ljava/util/ArrayList;->isEmpty()Z
+
+    move-result v6
+
+    if-nez v6, :ec_only_validation_done
+
+    invoke-virtual {v4}, Ljava/util/ArrayList;->isEmpty()Z
+
+    move-result v6
+
+    if-eqz v6, :ec_only_validation_done
+
+    invoke-virtual {v4, v0}, Ljava/util/ArrayList;->addAll(Ljava/util/Collection;)Z
+
+    const/4 v14, 0x1
+
+    const/4 v15, 0x1
+
+    :ec_only_validation_done
+    if-ne v11, v5, :cond_f
+'''
+    path.write_text(replace_once(text, old, new))
+
+

+#!/usr/bin/env python3
+"""Port existing UN1CA Keybox hooks to the locked BZI6 M4 framework.
+
+Reason: BZI6 moved two Keystore2 proxies and KeymasterUtils into different
+DEX files; its service proxy also needs method-locked insertion to avoid donor
+label collisions. Impact: staged framework.jar Smali plus this build adapter,
+only for the reviewed M4/G965F profile. Verify: exact donor method hashes,
+zero-fuzz patch replay, hook descriptors and compiled framework call sites.
+Rollback: remove this adapter dispatch and restore the pre-port framework and
+Settings source. This file contains no key material.
+"""
+from hashlib import sha256
+from pathlib import Path
+import importlib.util
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+HERE = Path(__file__).resolve().parent
+SPEC = importlib.util.spec_from_file_location(
+    "bzi6_product", HERE.parent.parent / "patches/product_feature/a376b_android17_product.py")
+PRODUCT = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(PRODUCT)
+
+HOOK_PATCH = HERE / "smali/system/framework/framework.jar/0001-Introduce-KeyboxImitationHooks.patch"
+MGF_PATCH = HERE / "smali/system/framework/framework.jar/0002-Disable-MGF-digest-param-omit.patch"
+FRAMEWORK_REL = Path("system/framework/framework.jar")
+SERVICE_PROXY = "android/system/keystore2/IKeystoreService$Stub$Proxy"
+SECURITY_PROXY = "android/system/keystore2/IKeystoreSecurityLevel$Stub$Proxy"
+KEYSTORE2 = "android/security/KeyStore2"

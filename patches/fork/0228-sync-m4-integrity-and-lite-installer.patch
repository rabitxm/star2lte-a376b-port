+#!/usr/bin/env bash
+# Applied after APK rebuild and full wallpaper verification, only for M4 Lite.
+# Remove only the user-reviewed optional payloads, with fs_config cleanup.
+python3 "$SRC_DIR/unica/mods/s9_infinity_Wallpaper/source/build_m4_lite_wallpaper.py" \
+    --work-dir "$WORK_DIR" --rom-root "$SRC_DIR" || return 1
+for rel in \
+    product/app/Duo \
+    product/priv-app/Velvet \
+    system/priv-app/PhotoRemasterService \
+    system/app/VideoEditorLite_Dream_N \
+    system/priv-app/LiveEffectService \
+    system/priv-app/GalleryWidget \
+    system/priv-app/DynamicLockscreen \
+    system/priv-app/DigitalWellbeing \
+    system/hidden/INTERNAL_SDCARD/Music; do
+    [ -e "$WORK_DIR/system/$rel" ] || { LOGE "M4 Lite expected payload missing: $rel"; return 1; }
+    DELETE_FROM_WORK_DIR system "$rel" || return 1
+done
+python3 "$SRC_DIR/unica/mods/s9_infinity_Wallpaper/source/build_m4_lite_wallpaper.py" \
+    --verify-work "$WORK_DIR" || return 1
+unset rel

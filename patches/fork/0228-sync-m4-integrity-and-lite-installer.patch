+#!/usr/bin/env python3
+"""Build the M4 Lite single-default Infinity catalog from the verified Full APK."""
+import argparse
+import copy
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+import zipfile
+
+APK = Path('system/system/priv-app/wallpaper-res/wallpaper-res.apk')
+REMOVED = ('system/product/app/Duo', 'system/product/priv-app/Velvet',
+           'system/system/priv-app/PhotoRemasterService',
+           'system/system/app/VideoEditorLite_Dream_N',
+           'system/system/priv-app/LiveEffectService',
+           'system/system/priv-app/GalleryWidget',
+           'system/system/priv-app/DynamicLockscreen',
+           'system/system/priv-app/DigitalWellbeing',
+           'system/system/hidden/INTERNAL_SDCARD/Music')
+
+def digest(path):
+    with path.open('rb') as f:
+        return hashlib.file_digest(f, 'sha256').hexdigest()
+
+def catalog(archive):
+    data = json.loads(archive.read('res/raw/resources_info.json'))
+    return data
+
+def build(work, root):
+    target = work / APK
+    tools = root / 'out/tools/bin'
+    keys = root / 'external/android-tools/vendor/build/target/product/security'
+    with tempfile.TemporaryDirectory(prefix='m4-lite-wallpaper-', dir=target.parent) as td:
+        temp = Path(td)
+        unsigned, aligned, signed = (temp / n for n in ('unsigned.apk', 'aligned.apk', 'signed.apk'))
+        with zipfile.ZipFile(target) as src, zipfile.ZipFile(unsigned, 'w') as dst:
+            info = catalog(src)
+            entries = info['phone']
+            if len(entries) != 10 or entries[0].get('filename') != 'video_001.mp4' or entries[0].get('isDefault') is not True:
+                raise ValueError('Unexpected full Infinity catalog; refusing Lite conversion')
+            info['phone'] = [entries[0]]
+            for item in src.infolist():
+                name = item.filename
+                if name.startswith('META-INF/'):
+                    continue
+                match = re.fullmatch(r'res/(?:raw/video_|drawable-nodpi/wallpaper_)(\d{3})\.(?:mp4|webp)', name)
+                if match and int(match.group(1)) != 1:
+                    continue
+                entry = copy.copy(item)
+                if name == 'res/raw/resources_info.json':
+                    dst.writestr(entry, json.dumps(info, ensure_ascii=False, separators=(',', ':')).encode())
+                else:
+                    with src.open(item) as source, dst.open(entry, 'w') as dest:
+                        shutil.copyfileobj(source, dest, 1024 * 1024)
+        subprocess.run([str(tools/'zipalign'), '-f', '-p', '4', str(unsigned), str(aligned)], check=True)
+        subprocess.run(['java', '-jar', str(tools/'signapk.jar'), str(keys/'platform.x509.pem'),
+                        str(keys/'platform.pk8'), str(aligned), str(signed)], check=True)
+        verify_apk(signed, target)
+        os.chmod(signed, target.stat().st_mode & 0o777)
+        os.replace(signed, target)
+    print('PASS M4 Lite Infinity Blue catalog:', target.stat().st_size, 'bytes', digest(target))
+
+def verify_apk(apk, original=None):
+    with zipfile.ZipFile(apk) as z:
+        if z.testzip() is not None:
+            raise ValueError('Corrupt Lite wallpaper APK')
+        c = catalog(z)
+        e = c['phone']
+        if len(e) != 1 or e[0].get('filename') != 'video_001.mp4' or not e[0].get('isDefault'):
+            raise ValueError('Lite Infinity default catalog mismatch')
+        if e[0]['type_params']['service_class_name'] != 'com.samsung.android.wallpaper.live.infinity.InfinityWallpaper':
+            raise ValueError('Lite Infinity native engine mismatch')
+        names = set(z.namelist())
+        if not {'META-INF/CERT.SF', 'META-INF/CERT.RSA', 'res/raw/video_001.mp4',
+                'res/drawable-nodpi/wallpaper_001.webp'}.issubset(names):
+            raise ValueError('Lite wallpaper signature or required asset missing')
+        if any(re.fullmatch(r'res/raw/video_(?!001)\d{3}\.mp4', n) for n in names):
+            raise ValueError('Unexpected non-default Infinity video in Lite')
+        if original is not None:
+            with zipfile.ZipFile(original) as source:
+                if z.read('res/raw/video_001.mp4') != source.read('res/raw/video_001.mp4'):
+                    raise ValueError('Default Infinity video changed')
+
+def verify_work(work):
+    verify_apk(work / APK)
+    for rel in REMOVED:
+        if (work / rel).exists():
+            raise ValueError('Lite app still present: ' + rel)
+    for rel in ('system/system/priv-app/SpriteWallpaper/SpriteWallpaper.apk',
+                'system/system/priv-app/AODService_v80/AODService_v80.apk',
+                'system/system/priv-app/SecNfc/SecNfc.apk',
+                'system/system/priv-app/Bixby/Bixby.apk',
+                'system/product/priv-app/Messages/Messages.apk'):
+        if not (work / rel).is_file():
+            raise ValueError('Required Lite dependency missing: ' + rel)
+    print('PASS M4 Lite removal and retained wallpaper/NFC/Bixby/Messages checks')
+
+if __name__ == '__main__':
+    p = argparse.ArgumentParser()
+    p.add_argument('--work-dir', type=Path)
+    p.add_argument('--rom-root', type=Path)
+    p.add_argument('--verify-work', type=Path)
+    args = p.parse_args()
+    if args.verify_work:
+        verify_work(args.verify_work)
+    elif args.work_dir and args.rom_root:
+        build(args.work_dir, args.rom_root)
+    else:
+        p.error('Specify --work-dir and --rom-root, or --verify-work')

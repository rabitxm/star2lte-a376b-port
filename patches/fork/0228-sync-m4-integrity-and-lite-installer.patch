@@ -0,0 +1,126 @@
+#!/usr/bin/env python3
+"""Repackage the pinned M4 Lite OTA for preformatted internal USERDATA.
+
+The existing fork packager calls this; it neither builds images nor repartitions.
+"""
+import hashlib
+import os
+from pathlib import Path, PurePosixPath
+import subprocess
+import sys
+import tempfile
+import zipfile
+
+source, output = (Path(x).resolve() for x in sys.argv[1:3])
+root = Path(os.environ['SRC_DIR'])
+expected = '5e84d7e4f9a1fa4990a4b981465655eccb7b3ab71dfbb901d8078791a98815d5'
+updater = 'META-INF/com/google/android/updater-script'
+formatter = 'exynos9810/format_partitions.sh'
+preflight = 'exynos9810/preflight.sh'
+
+def digest(stream):
+    h = hashlib.sha256()
+    for data in iter(lambda: stream.read(8 * 1024 * 1024), b''):
+        h.update(data)
+    return h.hexdigest()
+
+with source.open('rb') as f:
+    if digest(f) != expected:
+        raise SystemExit('Refusing unpinned M4 Lite source')
+if output.exists() or output.is_symlink():
+    raise SystemExit('Refusing to overwrite output')
+
+with tempfile.TemporaryDirectory(prefix='m4-preformatted-', dir=output.parent) as temp:
+    tmp = Path(temp)
+    payload = tmp / 'payload'
+    payload.mkdir()
+    with zipfile.ZipFile(source) as original:
+        names = original.namelist()
+        if len(names) != len(set(names)):
+            raise SystemExit('Duplicate source ZIP entries')
+        for name in names:
+            p = PurePosixPath(name)
+            if p.is_absolute() or '..' in p.parts:
+                raise SystemExit('Unsafe source ZIP path')
+        original_updater = original.read(updater).decode()
+        original_formatter = original.read(formatter).decode()
+        original_preflight = original.read(preflight).decode()
+    subprocess.run(['7z', 'x', '-y', str(source), '-o' + str(payload)], check=True, stdout=subprocess.DEVNULL)
+
+    original_start = '''ifelse(is_mounted("/data"), unmount("/data"));
+run_program("/sbin/sh", "/tmp/exynos9810/prepare_layout.sh", "star2lte") == 0 ||
+    abort("E9810: Auto repartition failed. Reboot recovery, format data, then flash this ROM again.");
+if file_getprop("/tmp/exynos9810/layout.prop", "repartitioned") == "1" then
+    ui_print("Cleaning resized Exynos9810 partitions...");
+    run_program("/sbin/sh", "/tmp/exynos9810/format_partitions.sh", "layout_clean") == 0 ||
+        abort("E9810: Failed to format resized Exynos9810 partitions.");
+endif;
+'''
+    new_start = '''ui_print("Preformatted USERDATA required; automatic repartition is disabled.");
+run_program("/sbin/sh", "/tmp/exynos9810/preflight.sh", "star2lte") == 0 ||
+    abort("E9810: Partition layout too small. Prepare layout before copying this ZIP.");
+'''
+    original_end = '''ui_print("Formatting cache, omr, preload and data...");
+ifelse(is_mounted("/cache"), unmount("/cache"));
+ifelse(is_mounted("/omr"), unmount("/omr"));
+ifelse(is_mounted("/preload"), unmount("/preload"));
+ifelse(is_mounted("/data"), unmount("/data"));
+run_program("/sbin/sh", "/tmp/exynos9810/format_partitions.sh", "post_install") == 0 ||
+    abort("E9810: Failed to format cache/omr/preload/data.");
+'''
+    new_end = '''ui_print("Formatting cache, omr and preload; USERDATA is preserved.");
+ifelse(is_mounted("/cache"), unmount("/cache"));
+ifelse(is_mounted("/omr"), unmount("/omr"));
+ifelse(is_mounted("/preload"), unmount("/preload"));
+run_program("/sbin/sh", "/tmp/exynos9810/format_partitions.sh", "post_install_preserve_data") == 0 ||
+    abort("E9810: Failed to format cache/omr/preload.");
+'''
+    if original_updater.count(original_start) != 1 or original_updater.count(original_end) != 1:
+        raise SystemExit('Unexpected updater preimage; refusing to change installer')
+    updated = original_updater.replace(original_start, new_start).replace(original_end, new_end)
+    if updated.index('preflight.sh') > updated.index('block_image_update('):
+        raise SystemExit('Layout check must precede every image write')
+    marker = '    post_install)\n'
+    preserve = '''    post_install_preserve_data)
+        format_ext4 cache "$BY_NAME/CACHE" /cache optional
+        format_ext4 omr "$BY_NAME/OMR" /omr optional
+        format_ext4 preload "$BY_NAME/HIDDEN" /preload optional
+        ui_print "E9810: USERDATA preserved; preformat before install"
+        ;;
+'''
+    if original_formatter.count(marker) != 1:
+        raise SystemExit('Unexpected format script preimage')
+    (payload / updater).write_text(updated)
+    (payload / formatter).write_text(original_formatter.replace(marker, preserve + marker))
+    if original_preflight.count('TOLERANCE_MIB=16') != 1:
+        raise SystemExit('Unexpected layout preflight preimage')
+    (payload / preflight).write_text(original_preflight.replace('TOLERANCE_MIB=16', 'TOLERANCE_MIB=0'))
+    subprocess.run(['bash', '-n', str(payload / formatter)], check=True)
+    subprocess.run(['bash', '-n', str(payload / preflight)], check=True)
+
+    unsigned = tmp / 'unsigned.zip'
+    large = sorted(p.name for p in payload.iterdir() if p.name.endswith(('.new.dat.br', '.patch.dat')))
+    if not large:
+        raise SystemExit('No image payload found')
+    subprocess.run(['7z', 'a', '-tzip', '-mx=0', str(unsigned), *large], cwd=payload, check=True, stdout=subprocess.DEVNULL)
+    subprocess.run(['7z', 'a', '-tzip', '-mx=3', str(unsigned), '-r', '*', '-x!*.new.dat.br', '-x!*.patch.dat'], cwd=payload, check=True, stdout=subprocess.DEVNULL)
+    signed = tmp / 'signed.zip'
+    key = 'unica_ota' if os.environ.get('ROM_IS_OFFICIAL') == 'true' else 'aosp_testkey'
+    subprocess.run(['signapk', '-w', str(root / 'security' / (key + '.x509.pem')),
+                    str(root / 'security' / (key + '.pk8')), str(unsigned), str(signed)], check=True)
+    with zipfile.ZipFile(source) as original, zipfile.ZipFile(signed) as result:
+        old = {i.filename for i in original.infolist() if not i.is_dir()}
+        new = {i.filename for i in result.infolist() if not i.is_dir()}
+        if old != new:
+            raise SystemExit(f'ZIP entry mismatch: removed={old-new}, added={new-old}')
+        for name in sorted(old - {updater, formatter, preflight}):
+            with original.open(name) as a, result.open(name) as b:
+                if digest(a) != digest(b):
+                    raise SystemExit('Unchanged payload differs: ' + name)
+        if result.read(updater).decode() != updated or result.read(formatter).decode() != original_formatter.replace(marker, preserve + marker):
+            raise SystemExit('Installer contents differ from reviewed changes')
+        if result.read(preflight).decode() != original_preflight.replace('TOLERANCE_MIB=16', 'TOLERANCE_MIB=0'):
+            raise SystemExit('Layout preflight differs from reviewed change')
+    os.link(signed, output)
+    output.chmod(0o444)
+    print('PASS: source payload entries unchanged; only updater, formatter and layout preflight modified')

+
+def replace_once(text, old, new):
+    if text.count(old) != 1:
+        raise RuntimeError('Expected exactly one reviewed smali anchor')
+    return text.replace(old, new, 1)
+
+
+def settings(root):
+    path = root / 'smali_classes4/io/mesalabs/unica/settings/keybox/KeyboxUtils.smali'

+#!/usr/bin/env python3
+"""Reject large, ZIP64, corrupt or incorrectly signed M4 Lite flashables."""
+import importlib.util
+import os
+from pathlib import Path
+import struct
+import sys
+import tempfile
+import zipfile
+
+path = Path(sys.argv[1])
+maximum = int(3.8 * 1024 ** 3)
+if path.stat().st_size > maximum:
+    raise SystemExit(f'M4 Lite ZIP exceeds 3.8 GiB: {path.stat().st_size} > {maximum}')
+with zipfile.ZipFile(path) as archive:
+    for info in archive.infolist():
+        if max(info.file_size, info.compress_size, info.header_offset) >= 2 ** 32 - 1:
+            raise SystemExit(f'ZIP32 size/offset overflow: {info.filename}')

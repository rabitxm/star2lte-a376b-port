From: Local M2 diagnostics
Subject: [PATCH] Correct recorder wait-stop signal decoding and private proc snapshots

Reason: the old decoder injects signal 127, causing PTRACE_CONT errno 5 and
leaving the tracee stopped. Runtime secilc compilation itself passes on both
TWRP and pinned DS-ACK; probe10 silence is not proof of a policy compile hang.
Files: diagnostics/bootlogger_pid1_probe11.c (candidate derived from probe10).
Verification: static AArch64 build; actual SIGCHLD forwarding/exit and ptrace
attach selftests PASS on TWRP4.9.118 and DS-ACK4.9.337. No PID1 boot tested.
The private proc mount correction is compiled but not yet boot-validated.
No standard ROM build or kernel/vendor/radio change, no image/device writes.

--- a/diagnostics/bootlogger_pid1_probe10.c
+++ b/diagnostics/bootlogger_pid1_probe11.c
@@ -16,6 +16,12 @@
         if (j == z) return 1;
     }
     return 0;
+}
+
+/* WSTOPSIG semantics: the low byte is the stop marker 0x7f, not the signal. */
+static long trace_stop_signal(long status)
+{
+    return ((unsigned long)status >> 8) & 0xff;
 }
 
 static void finish(long code)
@@ -75,8 +81,8 @@
     if (r < 0) return r;
     if (statbuf[0] != 0xef53) return -22; /* EXT4_SUPER_MAGIC */
     const char *path = (mounted[1] == 'c')
-        ? "/cache/m2-early-boot-probe10.log"
-        : "/dev/m2-cache/m2-early-boot-probe10.log";
+        ? "/cache/m2-early-boot-probe11.log"
+        : "/dev/m2-cache/m2-early-boot-probe11.log";
     return open_file(path,
                      O_WRONLY | O_CREAT | O_APPEND, 0600);
 }
@@ -174,6 +180,11 @@
     namespace_step = 2;
     r = syscall6(40, 0, (long)"/", 0, (1UL << 18) | 16384, 0, 0);
     if (r < 0) return r; /* MS_PRIVATE | MS_REC */
+    /* The monitor namespace is private before PID1 mounts procfs. */
+    r = syscall6(34, AT_FDCWD, (long)"/proc", 0555, 0, 0, 0);
+    if (r < 0 && r != -17) return r;
+    r = syscall6(40, (long)"proc", (long)"/proc", (long)"proc", 1 | 2 | 4 | 8, 0, 0);
+    if (r < 0 && r != -16) return r;
     namespace_step = 3;
